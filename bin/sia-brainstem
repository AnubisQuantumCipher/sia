#!/usr/bin/env python3
"""sia-brainstem — the resident daemon of SIA, the Omarchy Brain.

“Brain” is a product metaphor for auditable local machine memory; it is not a
biological brain and does not establish cognition or neuroscience.

The lifetime resident lease refuses a second brainstem. Each whole pulse or
dream also takes SIA's corpus transaction lease, while every PGLite operation
shares the separate cross-process gbrain lease with the CLI, MCP surface, and
benchmark. A pulse tails the box's evidence streams into the corpus, syncs the
local index, verifies the signed chains, creates deterministic entries, and
exports widget snapshots. The weekly-maintenance command runs nightly at
03:33 local under its compatibility name, ``dream``.
"""

import contextlib, datetime, fcntl, json, os, signal, socket, stat, sys, time, uuid


@contextlib.contextmanager
def _runtime_generation_lease(home=None):
    """Pin one installed runtime generation before importing its modules."""
    home = home if home is not None else os.path.expanduser("~")
    parent = os.path.join(home, ".local", "state")
    lock = os.path.join(parent, "sia.lifecycle.lock")
    tombstone = os.path.join(parent, "sia.lifecycle-removed")
    os.makedirs(parent, exist_ok=True)
    flags = (os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0)
             | getattr(os, "O_NOFOLLOW", 0))
    fd = os.open(lock, flags, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
            raise RuntimeError("SIA lifecycle lease is not an owned regular file")
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_SH)
        try:
            if os.path.lexists(tombstone):
                marker = os.lstat(tombstone)
                if not stat.S_ISREG(marker.st_mode) \
                        or marker.st_uid != os.geteuid():
                    raise RuntimeError("SIA lifecycle removal marker is unsafe")
                raise RuntimeError(
                    "SIA runtime was removed; reinstall before using it")
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


sialib = None
if __name__ != "__main__":
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import sialib as _sialib
    sialib = _sialib

PULSE_SEC = int(os.environ.get("SIA_PULSE_SEC", "60"))
DREAM_HOUR, DREAM_MIN = 3, 33
DREAM_RETRY_SEC = max(
    1, int(os.environ.get("SIA_DREAM_RETRY_SEC", "3600")))
# EX_CONFIG is reserved here for durable operator-action barriers. The unit
# pins the same status in RestartPreventExitStatus so Type=notify cannot turn
# a deliberate pre-READY stop into a restart loop.
INTENTIONAL_STOP_EXIT = getattr(os, "EX_CONFIG", 78)

_stop = False


def _plugin_registration_present(home=None):
    """Observe the exact canonical plugin manifest without following links."""
    home = sialib.HOME if home is None else home
    if not isinstance(home, str) or not os.path.isabs(home) \
            or os.path.normpath(home) != home:
        raise RuntimeError("plugin registration home is invalid")
    directory_flags = (os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY
                       | os.O_NOFOLLOW)
    file_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    descriptors = []
    hierarchy = []

    def generation(value):
        return (value.st_dev, value.st_ino, value.st_mode, value.st_uid,
                value.st_size, value.st_mtime_ns, value.st_ctime_ns)

    try:
        descriptor = os.open(home, directory_flags)
        descriptors.append(descriptor)
        for component in (".config", "omarchy", "plugins", "khephri.sia"):
            try:
                child = os.open(component, directory_flags,
                                dir_fd=descriptor)
            except FileNotFoundError:
                return False
            info = os.fstat(child)
            current = os.stat(
                component, dir_fd=descriptor, follow_symlinks=False)
            if not stat.S_ISDIR(info.st_mode) \
                    or info.st_uid != os.geteuid() \
                    or stat.S_IMODE(info.st_mode) & 0o022 \
                    or generation(info) != generation(current):
                os.close(child)
                raise RuntimeError("plugin registration directory is unsafe")
            hierarchy.append((descriptor, component, child, generation(info)))
            descriptors.append(child)
            descriptor = child
        try:
            manifest_fd = os.open("manifest.json", file_flags,
                                  dir_fd=descriptor)
        except FileNotFoundError:
            return False
        descriptors.append(manifest_fd)
        before = os.fstat(manifest_fd)
        if not stat.S_ISREG(before.st_mode) \
                or before.st_uid != os.geteuid() or before.st_nlink != 1 \
                or stat.S_IMODE(before.st_mode) & 0o022 \
                or not 0 < before.st_size <= sialib.MAX_CONFIG_BYTES:
            raise RuntimeError("plugin registration manifest is unsafe")
        raw = os.read(manifest_fd, sialib.MAX_CONFIG_BYTES + 1)
        after = os.fstat(manifest_fd)
        current = os.stat(
            "manifest.json", dir_fd=descriptor, follow_symlinks=False)
        if len(raw) != before.st_size \
                or generation(before) != generation(after) \
                or generation(after) != generation(current):
            raise RuntimeError("plugin registration manifest changed")

        def unique(items):
            result = {}
            for key, value in items:
                if key in result:
                    raise ValueError("duplicate plugin manifest field")
                result[key] = value
            return result

        try:
            manifest = json.loads(
                raw.decode("utf-8", "strict"), object_pairs_hook=unique,
                parse_constant=lambda _value: (_ for _ in ()).throw(
                    ValueError("invalid plugin manifest constant")))
        except (UnicodeError, ValueError, RecursionError) as exc:
            raise RuntimeError("plugin registration manifest is invalid") \
                from exc
        for parent_fd, component, child_fd, admitted in hierarchy:
            if generation(os.fstat(child_fd)) != admitted \
                    or generation(os.stat(
                        component, dir_fd=parent_fd,
                        follow_symlinks=False)) != admitted:
                raise RuntimeError(
                    "plugin registration hierarchy changed")
        return (isinstance(manifest, dict)
                and manifest.get("id") == "khephri.sia"
                and manifest.get("version") == sialib.VERSION)
    except OSError as exc:
        raise RuntimeError("plugin registration cannot be observed safely") \
            from exc
    finally:
        for descriptor in reversed(descriptors):
            with contextlib.suppress(OSError):
                os.close(descriptor)


def _resident_plugin_available(observer):
    try:
        available = observer()
    except (OSError, RuntimeError, TypeError, ValueError) as exc:
        sialib.log(
            "sia-brainstem REFUSED: plugin registration is unsafe or "
            f"unreadable ({_safe_failure_detail(exc)}); run `sia uninstall`")
        return False
    if available is not True:
        sialib.log(
            "sia-brainstem stopped: Omarchy plugin registration is absent; "
            "run `sia uninstall` (or `sia uninstall --purge`)")
        return False
    return True


def _safe_failure_detail(exc):
    return sialib.clip(sialib.inert_summary(
        sialib.redact(str(exc), "status-error")), 160)


def _retained_failure_detail(exc):
    """The refusal and the gates it wraps, for the retained failure record."""
    chain = sialib.refusal_chain(exc)
    text = sialib.redact(str(exc), "status-error")
    if len(chain) > 1:
        text += " because: " + " <- ".join(chain[1:])
    return text


def _checkpoint_failure_detail():
    if not sialib.REDACTIONS:
        return True
    try:
        with sialib.corpus_owner():
            memo = sialib.load_memo()
            sialib._checkpoint_status_error_redactions(memo)
        return True
    except Exception:
        return False


def _durable_failure_detail(exc):
    detail = _safe_failure_detail(exc)
    if sialib.REDACTIONS and not _checkpoint_failure_detail():
        return "diagnostic detail suppressed; redaction accounting refused"
    return detail


def _restore_barrier_present():
    barrier = os.path.join(
        sialib.HOME, ".local", "state", "sia-continuity",
        "restore-in-progress.json")
    if not os.path.lexists(barrier):
        return False
    info = os.lstat(barrier)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() \
            or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077:
        raise RuntimeError("restore barrier is unsafe")
    return True

def _on_term(signum, frame):
    global _stop
    _stop = True


def _publish_failure(seq, exc):
    """Keep SOURCE HEALTH truthful when a pulse cannot safely start."""
    try:
        with sialib.corpus_owner():
            _publish_failure_owned(seq, exc)
    except Exception as status_exc:
        detail = _durable_failure_detail(status_exc)
        sialib.log(f"SOURCE HEALTH export FAILED: {detail}")


def _publish_failure_owned(seq, exc):
    memo = sialib.load_memo()
    if (sialib._controller_source_present(memo)
            or sialib._controller_source_enabled()):
        sialib.log(
            "SOURCE HEALTH export REFUSED: controller-source transaction "
            "retains publication authority")
        return False
    pending = _pending_failure_publication(memo)
    if pending is not None:
        _finish_failure_publication(memo, pending)
        return
    status = sialib.read_json(sialib.STATUS_PATH, {})
    if sialib._recoverable_status_integrity(status) is None:
        sialib.log(
            "SOURCE HEALTH export REFUSED: no complete current status")
        return
    try:
        graph_generation = sialib._recoverable_graph_snapshot(
            sialib.read_json(sialib.GRAPH_PATH, {}))
    except Exception:
        graph_generation = None
    graph_error = None
    if graph_generation is None:
        graph_error = "resident graph snapshot is invalid"
    elif status["graph_publication_id"] \
            != graph_generation["publication_id"] \
            or status["graph_nodes"] != graph_generation["nodes"] \
            or status["graph_edges"] != graph_generation["edges"] \
            or status["pages"] != graph_generation["pages"]:
        graph_error = "resident status/graph generation mismatch"
    if graph_error is not None:
        graph_generation = {
            "publication_id": "", "nodes": 0, "edges": 0, "pages": 0}
    errors = status.get("errors", {})
    errors = dict(errors)
    if graph_error is not None:
        errors["graph_snapshot"] = graph_error
    errors["brainstem"] = str(exc)
    errors = sialib._redacted_status_errors(errors)
    retained_seq = status["pulse_seq"]
    # A caller's next-loop counter is only a proposal until the memo write
    # reserves it. Publish at the durable allocator when that field can be
    # read safely, but never roll a previously admitted status back if the
    # two resident files are already inconsistent.
    seq = retained_seq
    try:
        durable_seq = memo.get("pulse_seq") \
            if isinstance(memo, dict) else None
        if not isinstance(durable_seq, bool) \
                and isinstance(durable_seq, int) \
                and 0 <= durable_seq <= sialib.MAX_JSON_SAFE_INTEGER:
            seq = max(retained_seq, durable_seq)
    except Exception:
        pass
    status.update({"v": 1, "version": sialib.VERSION,
                   "ts": sialib.iso(), "state": "failed",
                   "pulse_seq": seq,
                   "publication_id": uuid.uuid4().hex,
                   "graph_publication_id":
                       graph_generation["publication_id"],
                   "graph_nodes": graph_generation["nodes"],
                   "graph_edges": graph_generation["edges"],
                   "pages": graph_generation["pages"],
                   "errors": errors})
    target_redactions = sialib._projected_pulse_redactions(memo)
    try:
        pulse_marker = sialib._pending_pulse_marker(memo)
    except RuntimeError:
        # This publication is also the visible failure boundary for a
        # malformed pulse marker; do not let that same corrupt journal
        # suppress SOURCE HEALTH. It remains in the memo for repair.
        pulse_marker = None
    if pulse_marker is not None:
        sialib._mark_pulse_publication(
            memo, pulse_marker["seq"], pulse_marker.get("effects"),
            target_redactions)
    status["redactions"] = target_redactions
    if sialib._recoverable_status_integrity(status) is None:
        raise RuntimeError("failure status projection is invalid")
    updated = dict(memo, redactions=target_redactions,
                   brainstem_failure_pending={"v": 2,
                                              "producer_version":
                                              sialib.VERSION,
                                              "status": status})
    updated.pop("ready", None)
    sialib._write_memo(updated)
    memo.clear()
    memo.update(updated)
    sialib.REDACTIONS.clear()
    _finish_failure_publication(
        memo, _pending_failure_publication(memo))


def _pending_failure_publication(memo):
    return sialib._pending_brainstem_failure_publication(memo)


def _finish_failure_publication(memo, marker):
    return sialib._finish_brainstem_failure_publication(memo, marker)


def _dream_due(now, last_dream_day, next_attempt, monotonic_now=None):
    monotonic_now = time.monotonic() if monotonic_now is None else monotonic_now
    return ((now.hour, now.minute) >= (DREAM_HOUR, DREAM_MIN)
            and last_dream_day != now.strftime("%Y-%m-%d")
            and monotonic_now >= next_attempt)


def _attempt_dream(now, last_dream_day):
    sialib.log("scheduled maintenance starting…")
    try:
        memo = sialib.load_memo()
        if (sialib._controller_source_present(memo)
                or sialib._controller_source_enabled()):
            # Empty source successors capture and publish their own bounded
            # replay/gist inputs. Do not start a competing legacy workflow,
            # invent a completed day, or mistake that ownership for failure.
            sialib.log(
                "scheduled maintenance deferred to controller idle pulses; "
                "no legacy run or completion claimed")
            return (_durable_dream_day(last_dream_day),
                    time.monotonic() + DREAM_RETRY_SEC)
        sialib.dream()
        return _durable_dream_day(last_dream_day), 0.0
    except Exception as exc:
        next_attempt = time.monotonic() + DREAM_RETRY_SEC
        detail = _durable_failure_detail(exc)
        sialib.log(f"scheduled maintenance FAILED: {detail}; retry is rate-limited")
        return _durable_dream_day(last_dream_day), next_attempt


def _reserved_pulse():
    """Allocate a sequence and pulse under one corpus/memo transaction."""
    with sialib.corpus_owner():
        memo = sialib.load_memo()
        if (sialib._controller_source_present(memo)
                or sialib._controller_source_enabled()):
            return sialib._run_controller_source_cycle()
        pending_failure = _pending_failure_publication(memo)
        if pending_failure is not None:
            _finish_failure_publication(memo, pending_failure)
        sialib._require_status_memo_fields(memo)
        cursors = sialib.load_cursors()
        sialib._recover_notify_baseline_attempt(memo, cursors)
        source_marker = sialib._pending_source_replay_marker(memo)
        if source_marker is not None:
            sialib._authorize_pending_source_replay(
                source_marker, cursors)
        sialib._pending_pulse_marker(memo)
        sialib._pending_pulse_status_effects(memo)
        current, _last_dream_day = _startup_state(memo)
        admitted_status = sialib._require_status_sequence_not_ahead(current)
        seq = current + 1
        memo["pulse_seq"] = seq
        sialib._write_memo(memo)
        return sialib._pulse_transaction(
            seq, admitted_status=admitted_status)


def _refresh_live_view_cache():
    """Publish the just-acknowledged source view for lease-free observers."""
    import sialiveview
    return sialiveview.publish_cache(sialib.__dict__)


def _startup_state(memo):
    if not isinstance(memo, dict):
        raise ValueError("brainstem memo must be an object")
    seq = memo.get("pulse_seq", 0)
    if isinstance(seq, bool) or not isinstance(seq, int) or seq < 0:
        raise ValueError("brainstem pulse sequence is invalid")
    if seq >= sialib.MAX_JSON_SAFE_INTEGER:
        raise ValueError("brainstem pulse sequence is exhausted")
    if not isinstance(memo.get("sync_needed", False), bool):
        raise ValueError("brainstem sync-needed state is invalid")
    dream = memo.get("dream", {})
    if not isinstance(dream, dict):
        raise ValueError("brainstem dream state is invalid")
    stamp = dream.get("last", "")
    if not isinstance(stamp, str):
        raise ValueError("brainstem dream timestamp is invalid")
    last_dream_day = ""
    if stamp:
        parsed = datetime.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ") \
            .replace(tzinfo=datetime.timezone.utc)
        if parsed.strftime("%Y-%m-%dT%H:%M:%SZ") != stamp:
            raise ValueError("brainstem dream timestamp is not canonical UTC")
        last_dream_day = parsed.astimezone().strftime("%Y-%m-%d")
    return seq, last_dream_day


def _durable_dream_day(fallback):
    """Refresh scheduler state after pulse recovery or a partial DREAM."""
    try:
        _seq, persisted = _startup_state(sialib.load_memo())
        return persisted
    except Exception as exc:
        detail = _durable_failure_detail(exc)
        sialib.log(f"dream schedule refresh refused: {detail}")
        return fallback


def _systemd_ready():
    """Complete Type=notify admission after all durable startup work."""
    endpoint = os.environ.pop("NOTIFY_SOCKET", "")
    if not endpoint:
        # Direct foreground/test invocations are not systemd services.
        return
    if "\x00" in endpoint or not (endpoint.startswith("/")
                                    or endpoint.startswith("@")):
        raise RuntimeError("systemd notification socket is invalid")
    address = "\x00" + endpoint[1:] if endpoint.startswith("@") else endpoint
    payload = b"READY=1\nSTATUS=SIA brainstem ready"
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notifier:
        sent = notifier.sendto(payload, address)
    if sent != len(payload):
        raise RuntimeError("systemd readiness notification was incomplete")


def _installation_completion_pending():
    """Hold resident work behind an exact in-progress install generation."""
    path = os.path.join(
        sialib.STATE, "managed-install", "first-light.json")
    record = sialib.read_state_json(
        path, None, "first-light completion", expected_type=object)
    if record is None:
        # Pre-lifecycle installations had no completion record. Their normal
        # startup admission remains authoritative until an upgrade publishes
        # the current release-bound record.
        return False
    if type(record) is not dict or set(record) != {"v", "version", "state"} \
            or type(record.get("v")) is not int or record["v"] != 1 \
            or type(record.get("version")) is not str \
            or record["version"] != sialib.VERSION \
            or record.get("state") not in {"installing", "ready"}:
        raise RuntimeError("first-light completion state is invalid")
    return record["state"] == "installing"


def _cycle_retry_wait_seconds(cycle_seconds, interval):
    """Seconds to sleep before the next resident cycle starts.

    A cycle that finished inside the configured interval keeps the existing
    start-to-start schedule: the remaining interval. A cycle that overran
    the interval waits the full configured interval before its retry,
    instead of retrying almost immediately, so a slow cycle cannot make the
    daemon run back-to-back. Both branches keep the existing 5s safety
    floor — including when the configured interval itself is below 5s.
    """
    chosen = interval if cycle_seconds > interval else interval - cycle_seconds
    return max(5.0, chosen)


def main():
    try:
        if _restore_barrier_present():
            sialib.log(
                "sia-brainstem REFUSED: interrupted restore barrier requires "
                "recovery")
            return INTENTIONAL_STOP_EXIT
        if not _resident_plugin_available(_plugin_registration_present):
            return INTENTIONAL_STOP_EXIT
        with sialib.brainstem_owner():
            return _run_owned(plugin_guard=_plugin_registration_present)
    except sialib.OwnerBusy as exc:
        sialib.log(f"sia-brainstem REFUSED: {_durable_failure_detail(exc)}")
        return 1


def _run_owned(*, plugin_guard=None):
    signal.signal(signal.SIGTERM, _on_term)
    signal.signal(signal.SIGINT, _on_term)
    seq = 0
    last_dream_day = ""
    try:
        memo = sialib.load_memo()
        if sialib._controller_source_ack_pending(memo):
            _run_status = sialib._run_controller_source_cycle()
            memo = sialib.load_memo()
            seq, last_dream_day = _startup_state(memo)
        else:
            pending_failure = _pending_failure_publication(memo)
            if pending_failure is not None:
                _finish_failure_publication(memo, pending_failure)
            sialib._require_status_memo_fields(memo)
            cursors = sialib.load_cursors()
            sialib._recover_notify_baseline_attempt(memo, cursors)
            source_marker = sialib._pending_source_replay_marker(memo)
            if source_marker is not None:
                sialib._authorize_pending_source_replay(
                    source_marker, cursors)
            sialib._pending_pulse_marker(memo)
            sialib._pending_pulse_status_effects(memo)
            seq, last_dream_day = _startup_state(memo)
            sialib._require_status_sequence_not_ahead(seq)
        installation_pending = _installation_completion_pending()
    except sialib.SourceReplayQuarantine as exc:
        detail = _durable_failure_detail(exc)
        sialib.log(f"brainstem startup source_replay_quarantine: {detail}")
        return INTENTIONAL_STOP_EXIT
    except Exception as exc:
        detail = _safe_failure_detail(exc)
        sialib.log(f"brainstem startup REFUSED: {detail}")
        _publish_failure(0, detail)
        return 1
    sialib.ensure_dirs()
    sialib.log(f"sia-brainstem {sialib.VERSION} starting "
               f"(pulse {PULSE_SEC}s, store {sialib.SHARE})")
    next_dream_attempt = 0.0
    try:
        _recovered, recovery_errors = sialib.recover_ledger_transitions()
        if recovery_errors:
            raise RuntimeError(f"ledger recovery refused: {recovery_errors}")
        sialib.durable_ledger_append(
            "BOOT:brainstem", sialib.VERSION, f"pulse={PULSE_SEC}s")
        _systemd_ready()
    except Exception as exc:
        detail = _safe_failure_detail(exc)
        sialib.log(f"brainstem startup REFUSED: {detail}")
        _publish_failure(seq, detail)
        return 1
    waited_for_installation = installation_pending
    if waited_for_installation:
        sialib.log(
            "sia-brainstem waiting for first-light installation completion")
    while not _stop and installation_pending:
        time.sleep(1)
        installation_pending = _installation_completion_pending()
    if not _stop and waited_for_installation:
        sialib.log("sia-brainstem resident work admitted")
    plugin_removed = False
    while not _stop:
        if plugin_guard is not None \
                and not _resident_plugin_available(plugin_guard):
            plugin_removed = True
            break
        t0 = time.monotonic()
        try:
            # Reserve the sequence before any effects. A crash may leave a
            # gap, but it can never cause a signed/publication sequence reuse.
            st = _reserved_pulse()
            try:
                if sialib._controller_source_enabled():
                    _refresh_live_view_cache()
            except Exception as exc:
                sialib.log(
                    "live view cache REFUSED: "
                    + _safe_failure_detail(exc))
            durable_memo = sialib.load_memo()
            seq, _durable_last_dream_day = _startup_state(durable_memo)
            sialib.clear_pulse_failure()
            if st["events_pulse"] or st["errors"]:
                sialib.log(f"pulse {seq}: {st['events_pulse']} events, "
                           f"state {st['state']}"
                           + (f", errors {list(st['errors'])}" if st["errors"] else ""))
        except sialib.SourceReplayQuarantine as e:
            detail = _durable_failure_detail(e)
            sialib.log(
                f"pulse {seq} source_replay_quarantine: {detail}")
            return INTENTIONAL_STOP_EXIT
        except Exception as e:
            try:
                durable_memo = sialib.load_memo()
                seq, _durable_last_dream_day = _startup_state(durable_memo)
            except Exception:
                pass
            detail = _safe_failure_detail(e)
            sialib.log(f"pulse {seq} FAILED: {detail}")
            try:
                sialib.record_pulse_failure(seq, _retained_failure_detail(e))
            except Exception as retain_exc:
                sialib.log("pulse failure record REFUSED: "
                           + _safe_failure_detail(retain_exc))
            _publish_failure(seq, detail)
        last_dream_day = _durable_dream_day(last_dream_day)
        now = datetime.datetime.now()
        if _dream_due(now, last_dream_day, next_dream_attempt):
            last_dream_day, next_dream_attempt = _attempt_dream(
                now, last_dream_day)
        # cycle_seconds spans this whole iteration (collection, dream/cache
        # work, logging) — it is not a pure per-pulse model/collector
        # latency measurement.
        cycle_seconds = time.monotonic() - t0
        overrun = cycle_seconds > PULSE_SEC
        wait_seconds = _cycle_retry_wait_seconds(cycle_seconds, PULSE_SEC)
        sialib.log(
            f"cycle {seq}: {cycle_seconds:.3f}s"
            + (f" OVERRUN, waiting {wait_seconds:.3f}s" if overrun else ""))
        for _ in range(int(wait_seconds)):
            if _stop:
                break
            time.sleep(1)
    sialib.log("sia-brainstem stopped")
    try:
        sialib.durable_ledger_append(
            "HALT:brainstem", sialib.VERSION, "clean")
    except Exception as exc:
        detail = _safe_failure_detail(exc)
        sialib.log(f"brainstem halt ledger REFUSED: {detail}")
        _publish_failure(seq, detail)
        return 1
    return INTENTIONAL_STOP_EXIT if plugin_removed else 0

if __name__ == "__main__":
    try:
        with _runtime_generation_lease():
            sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
            import sialib as _sialib
            sialib = _sialib
            sys.exit(main())
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"sia-brainstem: refused: {exc}", file=sys.stderr)
        sys.exit(1)
