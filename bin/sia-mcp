#!/usr/bin/env python3
"""sia-mcp — MCP stdio server exposing SIA, the Omarchy Brain, to any
agent harness (Claude Code, Codex, Grok, OMP, anything MCP-capable).

Architecture contract: this server NEVER opens the brain's database.
Reads shell out to the `sia` CLI (which retries around the daemon's
brief pulse locks); writes go to the append-only queues the daemon
drains (notes, take proposals, recall touches). The brainstem remains
the single writer; agents are queue clients. Model-origin content is
labeled and weighted below evidence by construction.
"""

import json, os, subprocess, sys, time

HOME = os.path.expanduser("~")
SIA = os.path.join(HOME, ".local/bin/sia")
STATE = os.path.join(HOME, ".local/state/sia")
SERVER_VERSION = "1.0.0"


def run_sia(args, timeout=240):
    try:
        r = subprocess.run([SIA] + args, capture_output=True, text=True,
                           timeout=timeout)
        out = (r.stdout or "") + (("\n" + r.stderr) if r.stderr.strip()
                                  else "")
        return out.strip() or "(no output)", r.returncode != 0
    except Exception as e:
        return f"sia unavailable: {e}", True


TOOLS = [
    {"name": "sia_ask",
     "description": "Semantic recall over the machine's memory (evidence "
        "ledgers, events, thoughts). Results are labeled by origin class "
        "(evidence/derived/model) and every answer ends with a truth-"
        "boundary line (sense freshness, chain state, recall mode). "
        "Absence of recall is not evidence of absence. Recalling "
        "strengthens the returned memories.",
     "inputSchema": {"type": "object", "properties": {
         "question": {"type": "string"}}, "required": ["question"]}},
    {"name": "sia_recall",
     "description": "Read one memory page verbatim by slug (e.g. "
        "'organs/sekhmet', 'events/jackal/2026-08-29', 'sia/cortex').",
     "inputSchema": {"type": "object", "properties": {
         "slug": {"type": "string"}}, "required": ["slug"]}},
    {"name": "sia_status",
     "description": "One-screen state of the brain: pulse, memories, "
        "per-organ activity today, signed-chain verdicts, latest thought.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "sia_think",
     "description": "The brain's recent thoughts (deterministic, "
        "evidence-cited; ✦/⚖ entries are labeled model-assisted).",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "sia_note",
     "description": "Leave a labeled note for future agent sessions. "
        "Notes are model-origin memories: recallable and graphed, but "
        "permanently marked as agent prose and weighted below evidence. "
        "Use for hard-won context worth passing on, not scratch.",
     "inputSchema": {"type": "object", "properties": {
         "text": {"type": "string"},
         "author": {"type": "string",
                    "description": "who is writing (e.g. codex, grok, "
                                   "claude-fable-5)"}},
         "required": ["text", "author"]}},
    {"name": "sia_propose_take",
     "description": "PROPOSE a falsifiable prediction (claim + confidence "
        "+ deadline). Proposals wait in a queue; only the human operator "
        "commits them with `sia take --accept` — agents never mint the "
        "predictions they may later help grade.",
     "inputSchema": {"type": "object", "properties": {
         "claim": {"type": "string"},
         "confidence": {"type": "number", "minimum": 0.01, "maximum": 0.99},
         "deadline": {"type": "string", "description": "YYYY-MM-DD"},
         "domain": {"type": "string"},
         "author": {"type": "string"}},
         "required": ["claim", "confidence", "deadline"]}},
    {"name": "sia_calibration",
     "description": "Brier scorecard per domain — the measured track "
        "record of predictions (0.0 = prophet, 0.25 = coin-flip).",
     "inputSchema": {"type": "object", "properties": {}}},
]


def call_tool(name, args):
    if name == "sia_ask":
        return run_sia(["ask", str(args.get("question", ""))[:500]])
    if name == "sia_recall":
        return run_sia(["recall", str(args.get("slug", ""))[:200]])
    if name == "sia_status":
        return run_sia(["status"])
    if name == "sia_think":
        return run_sia(["think"])
    if name == "sia_calibration":
        return run_sia(["calibration"])
    if name == "sia_note":
        author = str(args.get("author", "agent"))[:40]
        return run_sia(["note", str(args.get("text", ""))[:2000],
                        "--from", author])
    if name == "sia_propose_take":
        prop = {"claim": " ".join(str(args.get("claim", "")).split())[:300],
                "confidence": min(0.99, max(0.01,
                    float(args.get("confidence", 0.7)))),
                "deadline": str(args.get("deadline", ""))[:10],
                "domain": str(args.get("domain", "general")).lower()[:30],
                "source": "sia/cortex",
                "proposed": str(args.get("author", "agent"))[:40]}
        if not prop["claim"] or not prop["deadline"]:
            return "claim and deadline are required", True
        sys.path.insert(0, os.path.join(
            os.path.expanduser("~"), ".local/share/sia/bin"))
        import siatakes
        # same flock as the daemon and CLI — never a bare read/append
        pending = siatakes.locked_proposals(STATE,
                                            lambda cur: cur + [prop])
        return (f"proposed (position {len(pending)}). The operator commits "
                f"with: sia take --accept {len(pending)}  — proposals are "
                f"not memories until then."), False
    return f"unknown tool {name}", True


def reply(msg_id, result=None, error=None):
    out = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        out["error"] = error
    else:
        out["result"] = result
    sys.stdout.write(json.dumps(out) + "\n")
    sys.stdout.flush()


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except Exception:
            continue
        method = msg.get("method", "")
        msg_id = msg.get("id")
        if method == "initialize":
            proto = (msg.get("params") or {}).get("protocolVersion",
                                                  "2024-11-05")
            reply(msg_id, {
                "protocolVersion": proto,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "sia",
                               "title": "SIA — the Omarchy Brain",
                               "version": SERVER_VERSION}})
        elif method == "notifications/initialized":
            pass
        elif method == "ping":
            reply(msg_id, {})
        elif method == "tools/list":
            reply(msg_id, {"tools": TOOLS})
        elif method == "tools/call":
            params = msg.get("params") or {}
            text, is_err = call_tool(params.get("name", ""),
                                     params.get("arguments") or {})
            reply(msg_id, {"content": [{"type": "text", "text": text}],
                           "isError": bool(is_err)})
        elif msg_id is not None:
            reply(msg_id, error={"code": -32601,
                                 "message": f"method not found: {method}"})


if __name__ == "__main__":
    main()
