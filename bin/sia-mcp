#!/usr/bin/env python3
"""sia-mcp — MCP stdio server exposing SIA, the Omarchy Brain, to any
agent harness (Claude Code, Codex, Grok, OMP, anything MCP-capable).

Architecture contract: this server NEVER opens the brain's database.
Reads shell out to the `sia` CLI (which retries around the daemon's
brief ownership lease); writes go to serialized filesystem queues
(notes, take proposals, recall touches). The brainstem materializes agent
notes and remains the PGLite writer; agents are queue clients. Model-origin content is
labeled and weighted below evidence by construction.
"""

import datetime, json, math, os, re, selectors, signal, subprocess, sys, time
import urllib.parse

HOME = os.path.expanduser("~")
SIA = os.path.join(HOME, ".local/bin/sia")
STATE = os.path.join(HOME, ".local/state/sia")
SERVER_VERSION = "1.3.5"
MODERN_PROTOCOL = "2026-07-28"
LEGACY_PROTOCOLS = ("2025-11-25", "2025-06-18", "2025-03-26",
                    "2024-11-05")
SUPPORTED_PROTOCOLS = (MODERN_PROTOCOL,) + LEGACY_PROTOCOLS
BATCH_PROTOCOLS = ("2025-03-26",)
SERVER_INFO = {"name": "sia", "title": "SIA — the Omarchy Brain",
               "version": SERVER_VERSION}
SERVER_INSTRUCTIONS = (
    "Recall before re-deriving machine history. Carry origin labels and the "
    "truth-boundary line; absence of recall is not evidence of absence. "
    "Agent notes are model-origin prose, never evidence.")
# JACKAL exact: parsed=256*1024 exact=262144 (not formal-bounded).
MAX_SIA_OUTPUT_BYTES = 262_144
READ_CHUNK_BYTES = 65_536
MAX_REQUEST_BYTES = 262_144
MAX_BATCH_ITEMS = 8
# JACKAL exact: parsed=1024*1024 exact=1048576 (not formal-bounded).
MAX_RESPONSE_BYTES = 1_048_576

TEXT_OUTPUT_SCHEMA = {
    "type": "object",
    "properties": {"text": {"type": "string"}},
    "required": ["text"],
    "additionalProperties": False,
}


def _await_exit_unreaped(process, deadline, command, timeout):
    """Wait through pidfd so the leader remains the stable PGID owner."""
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise subprocess.TimeoutExpired(command, timeout)
    try:
        pidfd = os.pidfd_open(process.pid, 0)
    except (AttributeError, OSError) as exc:
        raise RuntimeError(
            "cannot establish stable sia child process identity") from exc
    watcher = selectors.DefaultSelector()
    try:
        watcher.register(pidfd, selectors.EVENT_READ)
        if not watcher.select(remaining):
            raise subprocess.TimeoutExpired(command, timeout)
    finally:
        watcher.close()
        os.close(pidfd)


def _signal_and_reap_group(process):
    """Terminate the identity-bound group before reaping its leader."""
    if process is None:
        return None
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except OSError:
        try:
            process.kill()
        except OSError:
            pass
    try:
        return process.wait(timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return None


def _tool(name, title, description, properties=None, required=None,
          *, read_only, idempotent):
    """Build one consistently annotated, dependency-free tool descriptor."""
    return {
        "name": name,
        "title": title,
        "description": description,
        "inputSchema": {
            "type": "object",
            "properties": properties or {},
            "required": required or [],
            "additionalProperties": False,
        },
        "outputSchema": TEXT_OUTPUT_SCHEMA,
        "annotations": {
            "title": title,
            "readOnlyHint": read_only,
            "destructiveHint": False,
            "idempotentHint": idempotent,
            "openWorldHint": False,
        },
    }


def run_sia(args, timeout=240):
    """Run one CLI request while bounding captured output and lifetime."""
    process = None
    selector = None
    group_reaped = False
    try:
        process = subprocess.Popen(
            [SIA] + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            start_new_session=True)
        selector = selectors.DefaultSelector()
        streams = {process.stdout: bytearray(), process.stderr: bytearray()}
        for stream in streams:
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ)
        deadline = time.monotonic() + timeout
        captured = 0
        exceeded = False
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired([SIA] + args, timeout)
            ready = selector.select(remaining)
            if not ready:
                raise subprocess.TimeoutExpired([SIA] + args, timeout)
            for key, _mask in ready:
                budget = MAX_SIA_OUTPUT_BYTES - captured
                try:
                    chunk = os.read(key.fileobj.fileno(),
                                    min(READ_CHUNK_BYTES, budget + 1))
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                if len(chunk) > budget:
                    streams[key.fileobj].extend(chunk[:budget])
                    exceeded = True
                    break
                streams[key.fileobj].extend(chunk)
                captured += len(chunk)
            if exceeded:
                break
        if exceeded:
            raise OverflowError(
                f"sia output exceeded {MAX_SIA_OUTPUT_BYTES}-byte limit")
        command = [SIA] + args
        _await_exit_unreaped(process, deadline, command, timeout)
        returncode = _signal_and_reap_group(process)
        group_reaped = True
        if returncode is None:
            raise subprocess.TimeoutExpired(command, timeout)
        stdout = bytes(streams[process.stdout]).decode(
            "utf-8", errors="strict")
        stderr = bytes(streams[process.stderr]).decode(
            "utf-8", errors="strict")
        out = stdout + (("\n" + stderr) if stderr.strip() else "")
        out = out[:MAX_SIA_OUTPUT_BYTES]
        # Preserve the CLI status code: callers that only need tool-result
        # semantics use its truthiness, while resources distinguish a
        # canonical missing page from infrastructure failure.
        return out.strip() or "(no output)", returncode
    except OverflowError as exc:
        return str(exc), -1
    except subprocess.TimeoutExpired:
        return f"sia unavailable: command timed out after {timeout}s", -1
    except UnicodeError:
        return "sia unavailable: command output is not valid UTF-8", -1
    except Exception as e:
        return f"sia unavailable: {e}", -1
    finally:
        if selector is not None:
            selector.close()
        if process is not None:
            if not group_reaped:
                # Signal while the unreaped leader still pins its PID/PGID.
                _signal_and_reap_group(process)
            for stream in (process.stdout, process.stderr):
                if stream is not None:
                    try:
                        stream.close()
                    except OSError:
                        pass


