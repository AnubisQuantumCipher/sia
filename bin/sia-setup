#!/usr/bin/env bash
# Marketplace first-light bridge.  This helper never installs from QML load:
# the cockpit invokes `launch` only after an explicit operator click, and the
# existing fail-closed installer remains the sole installation authority.
#
# Visibility is owned here, not delegated.  xdg-terminal-exec silently drops
# --hold when the resolved terminal entry declares no TerminalArgHold=, which
# is true of Alacritty, the Omarchy default, so the window would close the
# moment the installer exits — including on a named refusal.  The run stage
# therefore holds its own terminal on every exit path, and the launch stage
# proves the run stage started in a terminal instead of assuming it did.
# Nothing here queries the compositor: a window mapped late or onto another
# workspace is outside what this can witness.

set -euo pipefail

# Cold terminal start plus bash startup is seconds on the reference desktop;
# this bound only has to separate "slow" from "never".
SETUP_PRESENT_SECONDS=20
setup_hold_armed=0
setup_installer_pid=
setup_installer_done=0
setup_refused=0

refuse() {
  setup_refused=1
  printf 'SIA setup refused: %s\n' "$*" >&2
  exit 2
}

# Every exit of the run stage reaches this trap, so the operator can read the
# outcome whether the installer succeeded, failed, or a refusal fired first.
# The trap runs no `exit`, so the status that triggered it stays the helper's
# exit status.
hold_setup_terminal() {
  local status=$?
  if [ "$setup_hold_armed" != 1 ]; then
    return "$status"
  fi
  setup_hold_armed=0
  if [ "$status" -eq 0 ] && [ "$setup_installer_done" = 1 ]; then
    printf '\nSIA first light finished with exit status 0.\n' || true
    printf 'The cockpit clears only once the matching runtime is ready.\n' \
      || true
  elif [ "$status" -eq 0 ]; then
    # A fatal signal this helper does not trap still runs the EXIT trap, and
    # $? is then the last completed command's status, not the installer's.
    # Nothing was observed, so nothing is claimed.
    printf '\nSIA first light stopped before the installer returned.\n' \
      || true
    printf 'No installer status was seen; the install did not complete.\n' \
      || true
  elif [ "$setup_refused" = 1 ]; then
    printf '\nSIA first light did not complete: exit status %s.\n' \
      "$status" || true
    printf 'The named refusal printed above is the reason.\n' || true
  else
    printf '\nSIA first light did not complete: exit status %s.\n' \
      "$status" || true
    printf 'The last message printed above is the reason.\n' || true
  fi
  # The hold is a blocking read, so it is offered only to a real terminal:
  # a piped or scripted run must never be able to wedge on it.  A terminal is
  # not enough on its own: a helper sitting in a background process group
  # takes SIGTTIN on the read and would stop, holding the install lock with
  # no window to type into.  Ignoring SIGTTIN turns exactly that case into an
  # immediate error the `|| true` absorbs, so the hold can wait for a
  # keystroke but can never wedge waiting for one nobody can send.
  if [ -t 0 ] && [ -t 1 ]; then
    trap '' TTIN TTOU
    printf '\nPress Enter when you have read this. ' || true
    read -r || true
    trap - TTIN TTOU
  fi
  return "$status"
}

# An interrupted install must not leave a window waiting on a keystroke, so
# disarm the hold before exiting with the conventional signal status.  A
# directed signal reaches only this helper, so the installer is stopped here
# explicitly: without that, "interrupted" would be printed over an install
# that in fact ran to completion.
setup_interrupted() {
  trap '' INT TERM HUP
  setup_hold_armed=0
  if [ -n "$setup_installer_pid" ]; then
    kill -TERM "$setup_installer_pid" 2>/dev/null || true
    wait "$setup_installer_pid" 2>/dev/null || true
  fi
  printf '\nSIA first light interrupted by SIG%s; not holding.\n' "$1" >&2 \
    || true
  exit "$2"
}

# The launch stage binds its wait to a fresh nonce, so a marker left by an
# earlier attempt can never be read as this click presenting a terminal.
valid_attempt_id() {
  case "$1" in
    ""|*[!0-9a-f]*) return 1 ;;
  esac
  [ "${#1}" -eq 32 ]
}

# The marker path gets exactly the install.lock treatment: only an
# owner-private, singular, non-symlink regular file may be trusted or
# replaced in place.
assert_setup_marker_safe() {
  if [ -e "$setup_marker_path" ] || [ -L "$setup_marker_path" ]; then
    if [ ! -f "$setup_marker_path" ] || [ -L "$setup_marker_path" ] \
        || [ ! -O "$setup_marker_path" ]; then
      refuse "the first-light presentation marker is unsafe"
    fi
    [ "$(stat -c '%a:%h' -- "$setup_marker_path")" = "600:1" ] \
      || refuse "the presentation marker is not private and singular"
  fi
}

# Published before the installer runs, so the launch stage can tell "the run
# stage started and then refused" from "it never started at all".
publish_setup_presentation() {
  local attempt="$1" staged="$setup_marker_path.new" interactive=false
  if [ -t 0 ] && [ -t 1 ]; then
    interactive=true
  fi
  assert_setup_marker_safe
  rm -f -- "$staged"
  # noclobber makes the create O_EXCL|O_CREAT, so a symlink racing into the
  # staged path cannot redirect this write out of the owner-only directory.
  set -C
  printf '{"attempt":"%s","pid":%s,"ts":%(%s)T,"tty":%s,"v":1}\n' \
    "$attempt" "$$" -1 "$interactive" >"$staged"
  set +C
  mv -f -- "$staged" "$setup_marker_path"
  if [ ! -f "$setup_marker_path" ] || [ -L "$setup_marker_path" ] \
      || [ ! -O "$setup_marker_path" ]; then
    refuse "the presentation marker could not be published safely"
  fi
  [ "$(stat -c '%a:%h' -- "$setup_marker_path")" = "600:1" ] \
    || refuse "the published presentation marker is not private and singular"
  # The shared path is what the cockpit reads, so the last attempt to start
  # owns it.  Proof that THIS attempt presented therefore also lands in a
  # per-attempt file, which a later attempt can never overwrite.
  if [ -n "$attempt" ]; then
    rm -f -- "$setup_marker_path.$attempt" "$setup_marker_path.$attempt.new"
    set -C
    cat -- "$setup_marker_path" >"$setup_marker_path.$attempt.new"
    set +C
    mv -f -- "$setup_marker_path.$attempt.new" \
      "$setup_marker_path.$attempt"
  fi
}

# Absence of a readable, owner-private marker naming this exact attempt is
# never a started run stage.  Every read re-checks type, owner, and mode.
setup_presented() {
  local attempt="$1" path marker
  path="$setup_marker_path.$attempt"
  if [ -L "$path" ] || [ ! -f "$path" ] || [ ! -O "$path" ]; then
    return 1
  fi
  [ "$(stat -c '%a:%h' -- "$path")" = "600:1" ] || return 1
  marker="$(head -c 4096 -- "$path")" || return 1
  # The marker names the attempt and records whether the run stage actually
  # got a terminal.  Only both together are presentation: a run without a tty
  # holds no window, so announcing one would claim what did not happen.
  case "$marker" in
    *"\"attempt\":\"$attempt\""*)
      case "$marker" in
        *'"tty":true'*) return 0 ;;
      esac
      ;;
  esac
  return 1
}

trap hold_setup_terminal EXIT
trap 'setup_interrupted INT 130' INT
trap 'setup_interrupted TERM 143' TERM
# Closing the first-light window delivers SIGHUP.  Untrapped, the EXIT hold
# would run with a status the installer never produced.
trap 'setup_interrupted HUP 129' HUP

# uwsm-app serializes argv through a desktop daemon, so neither this process's
# descriptors nor its environment reach the terminal.  A launch therefore
# names the still-live launcher's admitted descriptors in argv.  The terminal
# side duplicates them immediately and reconstructs the private, local-only
# handoff consumed by sialifetime.py.  No ordinary caller can select this path:
# the script itself must be executing through the named launcher descriptor.
setup_handoff_worker=0
if [ "${1:-}" = --sia-setup-handoff=1 ]; then
  setup_hold_armed=1
  [ "$#" -eq 9 ] || refuse "the serialized setup handoff is malformed"
  setup_handoff_launcher_pid="$2"
  setup_handoff_remote_root_fd="$3"
  setup_handoff_remote_helper_fd="$4"
  setup_handoff_remote_installer_fd="$5"
  setup_handoff_remote_owner_fd="$6"
  setup_handoff_root_path="$7"
  [ "$8" = run ] || refuse "the serialized setup handoff is not a run"
  case "$setup_handoff_launcher_pid" in
    ""|0|0*|*[!0-9]*) refuse "the setup launcher pid is malformed" ;;
  esac
  for setup_source_fd in \
      "$setup_handoff_remote_root_fd" \
      "$setup_handoff_remote_helper_fd" \
      "$setup_handoff_remote_installer_fd" \
      "$setup_handoff_remote_owner_fd"; do
    case "$setup_source_fd" in
      ""|*[!0-9]*|0*) refuse "the serialized setup descriptor is malformed" ;;
    esac
  done
  setup_handoff_remote_prefix="/proc/$setup_handoff_launcher_pid/fd"
  [ "${BASH_SOURCE[0]}" = \
      "$setup_handoff_remote_prefix/$setup_handoff_remote_helper_fd" ] \
    || refuse "the serialized setup handoff names another helper"
  case "$setup_handoff_root_path" in
    /*) ;;
    *) refuse "the setup source root display is invalid" ;;
  esac
  unset SIA_SETUP_HANDOFF_ABI SIA_SETUP_HANDOFF_ROOT_PATH \
    SIA_SETUP_HANDOFF_ROOT_FD SIA_SETUP_HANDOFF_HELPER_FD \
    SIA_SETUP_HANDOFF_INSTALLER_FD SIA_SETUP_HANDOFF_OWNER_FD
  exec {SIA_SETUP_HANDOFF_ROOT_FD}<\
    "$setup_handoff_remote_prefix/$setup_handoff_remote_root_fd" \
    || refuse "cannot duplicate the serialized plugin root"
  exec {SIA_SETUP_HANDOFF_HELPER_FD}<\
    "$setup_handoff_remote_prefix/$setup_handoff_remote_helper_fd" \
    || refuse "cannot duplicate the serialized setup helper"
  exec {SIA_SETUP_HANDOFF_INSTALLER_FD}<\
    "$setup_handoff_remote_prefix/$setup_handoff_remote_installer_fd" \
    || refuse "cannot duplicate the serialized plugin installer"
  exec {SIA_SETUP_HANDOFF_OWNER_FD}<\
    "$setup_handoff_remote_prefix/$setup_handoff_remote_owner_fd" \
    || refuse "cannot duplicate the serialized lifetime owner"
  SIA_SETUP_HANDOFF_ROOT_PATH="$setup_handoff_root_path"
  SIA_SETUP_HANDOFF_ABI=1
  setup_handoff_worker=1
  shift 7
elif [ "${1:-}" = run ]; then
  # Only the run stage owns a terminal.  Arm its hold before the first refusal
  # can fire, so a named refusal is readable too and not just the installer's
  # own exit.
  setup_hold_armed=1
fi

case "${HOME:-}" in
  /*) ;;
  *) refuse "HOME must be an absolute path" ;;
esac
case "$HOME" in
  /|*$'\n'*|*$'\r'*) refuse "HOME is unsafe" ;;
esac
case "${XDG_RUNTIME_DIR:-}" in
  /*) ;;
  *) refuse "XDG_RUNTIME_DIR must be an absolute path" ;;
esac

assert_setup_source_descriptor() {
  local descriptor="$1" label="$2" executable="$3"
  local target="/proc/self/fd/$descriptor" mode
  if [ ! -f "$target" ] || [ ! -O "$target" ] \
      || [ "$(stat -Lc '%h' -- "$target")" != 1 ]; then
    refuse "$label descriptor is not an owned single-link regular file"
  fi
  mode="$(stat -Lc '%a' -- "$target")" \
    || refuse "$label descriptor mode is unavailable"
  if [ $((8#$mode & 0022)) -ne 0 ]; then
    refuse "$label descriptor is writable outside its owner"
  fi
  if [ "$executable" = 1 ] && [ ! -x "$target" ]; then
    refuse "$label descriptor is not executable"
  fi
}

assert_setup_root_descriptor() {
  local descriptor="$1" target="/proc/self/fd/$1" mode
  if [ ! -d "$target" ] || [ ! -O "$target" ]; then
    refuse "the plugin root descriptor is not an owned directory"
  fi
  mode="$(stat -Lc '%a' -- "$target")" \
    || refuse "the plugin root descriptor mode is unavailable"
  if [ $((8#$mode & 0022)) -ne 0 ]; then
    refuse "the plugin root descriptor is writable outside its owner"
  fi
}

assert_setup_directory_path() {
  local path="$1" label="$2" mode
  if [ -L "$path" ] || [ ! -d "$path" ] || [ ! -O "$path" ]; then
    refuse "$label is not an owned non-link directory"
  fi
  mode="$(stat -c '%a' -- "$path")" \
    || refuse "$label mode is unavailable"
  if [ $((8#$mode & 0022)) -ne 0 ]; then
    refuse "$label is writable outside its owner"
  fi
}

assert_setup_binding() {
  local descriptor="$1" path="$2" label="$3"
  if [ -L "$path" ] || [ ! -e "$path" ]; then
    refuse "$label binding is not a present non-link source"
  fi
  [ "$(stat -Lc '%d:%i' -- "/proc/self/fd/$descriptor")" = \
      "$(stat -c '%d:%i' -- "$path")" ] \
    || refuse "$label changed while binding"
}

assert_setup_remote_copy() {
  local descriptor="$1" remote="$2" label="$3"
  [ "$(stat -Lc '%d:%i' -- "/proc/self/fd/$descriptor")" = \
      "$(stat -Lc '%d:%i' -- "$remote")" ] \
    || refuse "$label changed during serialized handoff"
}

if [ "$setup_handoff_worker" = 1 ]; then
  for setup_source_fd in \
      "${SIA_SETUP_HANDOFF_ROOT_FD:-}" \
      "${SIA_SETUP_HANDOFF_HELPER_FD:-}" \
      "${SIA_SETUP_HANDOFF_INSTALLER_FD:-}" \
      "${SIA_SETUP_HANDOFF_OWNER_FD:-}"; do
    case "$setup_source_fd" in
      ""|*[!0-9]*) refuse "the setup descriptor handoff is malformed" ;;
    esac
  done
  case "${SIA_SETUP_HANDOFF_ROOT_PATH:-}" in
    /*) ;;
    *) refuse "the setup source root display is invalid" ;;
  esac
else
  unset SIA_SETUP_HANDOFF_ABI SIA_SETUP_HANDOFF_ROOT_PATH \
    SIA_SETUP_HANDOFF_ROOT_FD SIA_SETUP_HANDOFF_HELPER_FD \
    SIA_SETUP_HANDOFF_INSTALLER_FD SIA_SETUP_HANDOFF_OWNER_FD
  SELF_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" \
    || refuse "cannot resolve the plugin helper"
  PLUGIN_ROOT="$(cd -P -- "$SELF_DIR/.." && pwd)" \
    || refuse "cannot resolve the plugin checkout"
  HELPER="$SELF_DIR/sia-setup"
  INSTALLER="$PLUGIN_ROOT/install.sh"
  LIFETIME_OWNER="$SELF_DIR/sialifetime.py"
  if [ ! -f "$HELPER" ] || [ -L "$HELPER" ] || [ ! -x "$HELPER" ]; then
    refuse "the plugin setup helper is unsafe"
  fi
  if [ ! -f "$INSTALLER" ] || [ -L "$INSTALLER" ] \
      || [ ! -x "$INSTALLER" ]; then
    refuse "the plugin installer is missing or unsafe"
  fi
  if [ ! -f "$LIFETIME_OWNER" ] || [ -L "$LIFETIME_OWNER" ] \
      || [ ! -O "$LIFETIME_OWNER" ]; then
    refuse "the release lifetime owner is missing or unsafe"
  fi
  exec {SIA_SETUP_HANDOFF_ROOT_FD}<"$PLUGIN_ROOT" \
    || refuse "cannot bind the plugin root descriptor"
  exec {SIA_SETUP_HANDOFF_HELPER_FD}<"$HELPER" \
    || refuse "cannot bind the setup helper descriptor"
  exec {SIA_SETUP_HANDOFF_INSTALLER_FD}<"$INSTALLER" \
    || refuse "cannot bind the plugin installer descriptor"
  exec {SIA_SETUP_HANDOFF_OWNER_FD}<"$LIFETIME_OWNER" \
    || refuse "cannot bind the lifetime owner descriptor"
  SIA_SETUP_HANDOFF_ROOT_PATH="$PLUGIN_ROOT"
  SIA_SETUP_HANDOFF_ABI=1
  [ "$(stat -Lc '%d:%i' -- \
      "/proc/self/fd/$SIA_SETUP_HANDOFF_ROOT_FD")" = \
      "$(stat -c '%d:%i' -- "$PLUGIN_ROOT")" ] \
    || refuse "the plugin root changed while binding"
  [ "$(stat -Lc '%d:%i' -- \
      "/proc/self/fd/$SIA_SETUP_HANDOFF_HELPER_FD")" = \
      "$(stat -c '%d:%i' -- "$HELPER")" ] \
    || refuse "the setup helper changed while binding"
  [ "$(stat -Lc '%d:%i' -- \
      "/proc/self/fd/$SIA_SETUP_HANDOFF_INSTALLER_FD")" = \
      "$(stat -c '%d:%i' -- "$INSTALLER")" ] \
    || refuse "the plugin installer changed while binding"
  [ "$(stat -Lc '%d:%i' -- \
      "/proc/self/fd/$SIA_SETUP_HANDOFF_OWNER_FD")" = \
      "$(stat -c '%d:%i' -- "$LIFETIME_OWNER")" ] \
    || refuse "the lifetime owner changed while binding"
fi

assert_setup_root_descriptor "$SIA_SETUP_HANDOFF_ROOT_FD"
assert_setup_source_descriptor \
  "$SIA_SETUP_HANDOFF_HELPER_FD" "the setup helper" 1
assert_setup_source_descriptor \
  "$SIA_SETUP_HANDOFF_INSTALLER_FD" "the plugin installer" 1
assert_setup_source_descriptor \
  "$SIA_SETUP_HANDOFF_OWNER_FD" "the lifetime owner" 0
if [ "$setup_handoff_worker" = 1 ]; then
  assert_setup_remote_copy \
    "$SIA_SETUP_HANDOFF_ROOT_FD" \
    "$setup_handoff_remote_prefix/$setup_handoff_remote_root_fd" \
    "the plugin root"
  assert_setup_remote_copy \
    "$SIA_SETUP_HANDOFF_HELPER_FD" \
    "$setup_handoff_remote_prefix/$setup_handoff_remote_helper_fd" \
    "the setup helper"
  assert_setup_remote_copy \
    "$SIA_SETUP_HANDOFF_INSTALLER_FD" \
    "$setup_handoff_remote_prefix/$setup_handoff_remote_installer_fd" \
    "the plugin installer"
  assert_setup_remote_copy \
    "$SIA_SETUP_HANDOFF_OWNER_FD" \
    "$setup_handoff_remote_prefix/$setup_handoff_remote_owner_fd" \
    "the lifetime owner"
fi
setup_bound_root="/proc/self/fd/$SIA_SETUP_HANDOFF_ROOT_FD"
assert_setup_directory_path "$setup_bound_root/bin" \
  "the plugin bin directory"
assert_setup_binding "$SIA_SETUP_HANDOFF_HELPER_FD" \
  "$setup_bound_root/bin/sia-setup" "the setup helper"
assert_setup_binding "$SIA_SETUP_HANDOFF_INSTALLER_FD" \
  "$setup_bound_root/install.sh" "the plugin installer"
assert_setup_binding "$SIA_SETUP_HANDOFF_OWNER_FD" \
  "$setup_bound_root/bin/sialifetime.py" "the lifetime owner"
export SIA_SETUP_HANDOFF_ABI SIA_SETUP_HANDOFF_ROOT_PATH \
  SIA_SETUP_HANDOFF_ROOT_FD SIA_SETUP_HANDOFF_HELPER_FD \
  SIA_SETUP_HANDOFF_INSTALLER_FD SIA_SETUP_HANDOFF_OWNER_FD
PLUGIN_ROOT="$SIA_SETUP_HANDOFF_ROOT_PATH"
HELPER="/proc/self/fd/$SIA_SETUP_HANDOFF_HELPER_FD"
INSTALLER="/proc/self/fd/$SIA_SETUP_HANDOFF_INSTALLER_FD"
LIFETIME_OWNER="/proc/self/fd/$SIA_SETUP_HANDOFF_OWNER_FD"

setup_runtime_dir="$XDG_RUNTIME_DIR/khephri.sia-first-light"
setup_marker_path="$setup_runtime_dir/terminal.json"
if [ ! -e "$setup_runtime_dir" ]; then
  install -d -m 0700 -- "$setup_runtime_dir"
fi
if [ ! -d "$setup_runtime_dir" ] || [ -L "$setup_runtime_dir" ] \
    || [ ! -O "$setup_runtime_dir" ]; then
  refuse "the first-light runtime directory is unsafe"
fi
[ "$(stat -c '%a' -- "$setup_runtime_dir")" = 700 ] \
  || refuse "the first-light runtime directory is not owner-only"
# Everything this helper creates under that directory — the presentation
# marker and the install lock — is owner-private by construction, never by
# whatever umask the caller happened to have.
umask 077

case "${1:-}" in
  launch)
    # The caller may bring its own attempt id so it can bind the answer to
    # the click it made; a bare launch draws one.  Either way the id is only
    # a freshness token on an owner-private file, never an authorization.
    [ "$#" -le 2 ] || refuse "launch takes at most one attempt id"
    command -v uwsm-app >/dev/null 2>&1 \
      || refuse "uwsm-app is unavailable"
    command -v xdg-terminal-exec >/dev/null 2>&1 \
      || refuse "xdg-terminal-exec is unavailable"
    attempt_id="${2:-}"
    if [ -n "$attempt_id" ]; then
      valid_attempt_id "$attempt_id" \
        || refuse "the first-light attempt id is malformed"
    else
      attempt_id="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')" \
        || refuse "cannot draw a first-light attempt id"
      valid_attempt_id "$attempt_id" \
        || refuse "cannot draw a first-light attempt id"
    fi
    # Refuse before spawning anything if the marker path is already hostile.
    assert_setup_marker_safe
    # --hold stays as belt and braces for terminals that honour it.  The run
    # stage holds first, so on such a terminal the operator closes a window
    # that is already finished; on Alacritty --hold is dropped and the run
    # stage is the only hold there is.
    setup_handoff_launcher_pid="$BASHPID"
    setup_handoff_launch_prefix="/proc/$setup_handoff_launcher_pid/fd"
    uwsm-app -- xdg-terminal-exec \
      --app-id=org.omarchy.sia-first-light \
      --title="SIA first light" --hold -- \
      "$setup_handoff_launch_prefix/$SIA_SETUP_HANDOFF_HELPER_FD" \
      --sia-setup-handoff=1 "$setup_handoff_launcher_pid" \
      "$SIA_SETUP_HANDOFF_ROOT_FD" "$SIA_SETUP_HANDOFF_HELPER_FD" \
      "$SIA_SETUP_HANDOFF_INSTALLER_FD" "$SIA_SETUP_HANDOFF_OWNER_FD" \
      "$SIA_SETUP_HANDOFF_ROOT_PATH" run "$attempt_id" &
    waited=0
    while [ "$waited" -lt "$SETUP_PRESENT_SECONDS" ]; do
      if setup_presented "$attempt_id"; then
        rm -f -- "$setup_marker_path.$attempt_id"
        printf 'SIA first light: the setup shell started.\n'
        exit 0
      fi
      sleep 1
      waited=$((waited + 1))
    done
    rm -f -- "$setup_marker_path.$attempt_id"
    # The spawned terminal is not ours to kill — uwsm-app hands it to the
    # session manager — so this refuses on what was observed and claims
    # nothing about a window that may still appear.
    refuse "no setup shell started within ${SETUP_PRESENT_SECONDS}s"
    ;;
  run)
    [ "$#" -le 2 ] || refuse "run takes at most one attempt id"
    setup_attempt="${2:-}"
    if [ -n "$setup_attempt" ] && ! valid_attempt_id "$setup_attempt"; then
      refuse "the first-light attempt id is malformed"
    fi
    # The run stage starting is a fact about what the desktop opened, not a
    # prediction about the install, so it is recorded before any installer
    # byte runs.
    publish_setup_presentation "$setup_attempt"
    lock_path="$setup_runtime_dir/install.lock"
    if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
      if [ ! -f "$lock_path" ] || [ -L "$lock_path" ] \
          || [ ! -O "$lock_path" ]; then
        refuse "the first-light lock is unsafe"
      fi
      [ "$(stat -c '%a:%h' -- "$lock_path")" = "600:1" ] \
        || refuse "the first-light lock is not private and singular"
    fi
    exec {setup_lock_fd}>>"$lock_path"
    [ "$(stat -c '%a:%h' -- "$lock_path")" = "600:1" ] \
      || refuse "the first-light lock changed while opening"
    flock -n "$setup_lock_fd" \
      || refuse "another SIA installer is already running"
    printf '\nSIA first light\n'
    printf 'The SIA installer will create or advance this machine\047s local memory store.\n'
    printf 'Keep this terminal open; success is not declared until sia ready passes.\n\n'
    # A Marketplace click is fresh consent for the documented default path,
    # not consent inherited from a prior shell.  Operators who deliberately
    # need one of these overrides can still run install.sh themselves with the
    # variable set at that explicit command boundary.
    unset BASH_ENV ENV \
      SIA_ADOPT_EXISTING_CORPUS SIA_ALLOW_UNPINNED_OLLAMA \
      SIA_INSTALL_KEYBINDING SIA_INSTALL_AGENT_SKILL SIA_REPLACE_AGENT_SKILL \
      SIA_REPLACE_BRAINSTEM_UNIT SIA_REPLACE_CONTINUITY_UNITS \
      SIA_REPLACE_GBRAIN_PIN SIA_REPLACE_NOMIC_LATEST \
      SIA_REPLACE_OLLAMA_RUNTIME SIA_REPLACE_OLLAMA_UNIT \
      SIA_REPLACE_PLUGIN SIA_REPLACE_RUNTIME SIA_REPLACE_SCHEMA_PACK \
      SIA_REPLACE_SIA_CLI SIA_REPLACE_TOOLCHAIN
    # The installer is a child, not an exec target, so this shell stays alive
    # to own the hold and keeps the advisory lock fd open for the whole run.
    # It is waited on rather than run in the foreground because bash defers a
    # trap until a foreground command returns, and `wait` is interruptible: a
    # signal arriving mid-install is acted on now, not after the install.
    # Nothing captures the status: errexit makes the installer's own exit
    # status this helper's exit status, and the EXIT hold reports it without
    # replacing it.
    python3 -I "$LIFETIME_OWNER" setup --caller "$BASHPID" "$setup_lock_fd" "$INSTALLER" &
    setup_installer_pid=$!
    wait "$setup_installer_pid"
    setup_installer_done=1
    ;;
  *)
    refuse "expected launch or run"
    ;;
esac
