#!/usr/bin/env python3
"""sia — talk to the Omarchy Brain.

  sia status            what the brain knows right now
  sia ask "question"    query the brain (keyword hybrid search, cited)
  sia recall <slug>     read one memory page
  sia think             recent thoughts
  sia graph             graph statistics
  sia pulse             run one brainstem pulse by hand (daemon must be off)
  sia dream             run the consolidation cycle now (daemon must be off)
  sia verify            re-verify every signed evidence chain with attest
  sia ledger            show SIA's own signed run ledger head + verify
  sia ponder [question] deep reflection by the configured judge over the brain's
                        memories, via your Codex subscription; writes a
                        clearly-labeled synthesis page + thought — and may
                        propose falsifiable takes
  sia take "claim" [--confidence 0.7] [--by YYYY-MM-DD] [--domain d]
                        register a falsifiable prediction (holder: user)
  sia takes             list predictions and their status
  sia grade [id]        grade due predictions now (configured judge,
                        deterministic Brier); with id, grade that one
  sia calibration       Brier scorecard per domain — how good the brain's
                        (and your) judgment actually is
"""

import json, os, subprocess, sys

sys.path.insert(0, os.path.expanduser("~/.local/share/sia/bin"))
import sialib


def daemon_running():
    r = subprocess.run(["systemctl", "--user", "is-active", "sia-brainstem"],
                       capture_output=True, text=True)
    return r.stdout.strip() == "active"


def cmd_status():
    st = sialib.read_json(sialib.STATUS_PATH, None)
    if not st:
        print("SIA has no status yet — is sia-brainstem running?")
        return 1
    ic = st.get("integrity", {})
    print(f"SIA · state {st['state']} · pulse {st['pulse_seq']} · {st['ts']}")
    print(f"  memory   {st.get('pages', '?')} pages · graph "
          f"{st.get('graph_nodes', '?')} nodes / {st.get('graph_edges', '?')} edges")
    per_organ = ", ".join(f"{k}:{v.get('today', 0)}"
                          for k, v in sorted(st.get("organs", {}).items())
                          if v.get("today"))
    print(f"  today    {st.get('events_today', 0)} events ({per_organ})")
    print(f"  chains   {ic.get('verdict', '?')} "
          f"({', '.join(f'{k}:{v}' for k, v in sorted(ic.get('chains', {}).items()))})")
    print(f"  ledger   seq {st.get('ledger', {}).get('seq', '?')} · "
          f"head {st.get('ledger', {}).get('head', '?')}…")
    th = st.get("thought", {})
    if th.get("text"):
        print(f"  thought  [{th.get('kind')}] {th['text']}")
    dr = st.get("dream", {})
    if dr.get("last"):
        print(f"  dream    {dr.get('last', '')[:16]} {dr.get('status', '')} "
              f"{dr.get('summary', '')}")
    if st.get("errors"):
        print(f"  errors   {st['errors']}")
    return 0


def _gbrain_query(q, json_out=False):
    import time
    args = [sialib.GBRAIN, "query", q, "--source", "sia"]
    if json_out:
        args.append("--json")
    for attempt in range(3):
        r = subprocess.run(args, env=sialib.GBRAIN_ENV, text=True,
                           capture_output=True)
        if r.returncode == 0 or "already open" not in (r.stdout + r.stderr):
            break
        time.sleep(2)      # brainstem pulse holds the brain briefly; retry
    return r


def _health_footer(keyword_only=False):
    """Every answer carries its truth boundary — the same grain the
    cockpit shows: sense freshness, chain state, snapshot completeness,
    recall mode. An answer over a degraded brain must say so inline."""
    import datetime as _dt
    st = sialib.read_json(sialib.STATUS_PATH, {})
    g = sialib.read_json(sialib.GRAPH_PATH, {})
    bits = []
    try:
        age = (_dt.datetime.now(_dt.timezone.utc)
               - _dt.datetime.strptime(st.get("ts", ""),
                                       "%Y-%m-%dT%H:%M:%SZ")
               .replace(tzinfo=_dt.timezone.utc)).total_seconds()
        bits.append("senses live" if age < 240
                    else f"SENSES STALE ({int(age // 60)}m)")
    except Exception:
        bits.append("SENSES UNKNOWN")
    ic = st.get("integrity", {})
    bits.append(f"chains {ic.get('verdict', 'unknown')}")
    if st.get("errors"):
        bits.append(f"{len(st['errors'])} sense error(s)")
    snap = g.get("snapshot", {})
    if snap:
        bits.append("graph complete" if snap.get("complete")
                    else "GRAPH PARTIAL")
    red = st.get("redactions", {})
    if red:
        bits.append(f"{sum(red.values())} span(s) redacted at ingest")
    bits.append("keyword-only recall" if keyword_only
                else "semantic recall")
    bits.append("absence of recall ≠ evidence of absence")
    return "boundary: " + " · ".join(bits)


def cmd_ask(q):
    """Semantic recall upgraded with hippocampal-style completion: dense
    hits seed Personalized PageRank over the typed graph (HippoRAG,
    damping 0.5, 1/deg specificity) blended with ACT-R activation."""
    import siamind
    r = _gbrain_query(q, json_out=True)
    try:
        i = r.stdout.index("[")
        results = json.loads(r.stdout[i:])
        assert isinstance(results, list) and results
        dense, seen, meta = [], set(), {}
        for res in results:
            slug = res.get("slug")
            if not slug or slug in seen:
                continue
            seen.add(slug)
            dense.append((slug, float(res.get("score") or 0)))
            meta[slug] = res
        graph = sialib.read_json(sialib.GRAPH_PATH, None)
        mind = siamind.load_mind()
        ranked = siamind.ppr_rerank(graph, dense, mind=mind)
        for slug, score in ranked[:8]:
            m = meta.get(slug, {})
            oc = siamind.origin_class(slug, m.get("type", ""))
            excerpt = " ".join(str(m.get("chunk_text", "")).split())[:104]
            print(f"[{score:.3f}] [{oc}] {slug} — {m.get('title', '')}")
            if excerpt:
                print(f"        {excerpt}")
        siamind.queue_touches([s for s, _ in ranked[:5]], src="user-ask")
        print()
        print(_health_footer(keyword_only="keyword-only"
                             in (r.stderr or "")))
        return 0
    except Exception:
        # honest fallback: plain gbrain output
        r2 = _gbrain_query(q)
        sys.stdout.write(r2.stdout)
        sys.stderr.write(r2.stderr)
        if "No results" in r2.stdout:
            print("(no matches — try other words or `sia recall <slug>`)")
        print(_health_footer(keyword_only="keyword-only"
                             in (r2.stderr or "")))
        return r2.returncode


def cmd_recall(slug):
    r = subprocess.run([sialib.GBRAIN, "get", slug, "--source", "sia"],
                       env=sialib.GBRAIN_ENV, text=True)
    return r.returncode


def cmd_think():
    store = sialib.load_thoughts()
    for t in store["thoughts"][-15:]:
        mark = "!" if t.get("urgent") else "·"
        print(f"{t['ts']} {mark} [{t['kind']}] {t['text']}")
    if not store["thoughts"]:
        print("No thoughts yet.")
    return 0


def cmd_graph():
    g = sialib.read_json(sialib.GRAPH_PATH, None)
    if not g:
        print("No graph snapshot yet.")
        return 1
    by_type = {}
    for n in g["nodes"]:
        by_type[n["t"]] = by_type.get(n["t"], 0) + 1
    print(f"graph snapshot {g['ts']} — {len(g['nodes'])} nodes shown of "
          f"{g.get('pages_total', '?')} pages, {len(g['edges'])} edges")
    for t, c in sorted(by_type.items(), key=lambda kv: -kv[1]):
        print(f"  {c:4d} {t}")
    return 0


def _guard_daemon():
    if daemon_running():
        print("sia-brainstem is running — it owns the brain. "
              "Stop it first: systemctl --user stop sia-brainstem")
        return False
    return True


def cmd_pulse():
    if not _guard_daemon():
        return 1
    memo = sialib.read_json(sialib.MEMO_PATH, {})
    seq = int(memo.get("pulse_seq", 0)) + 1
    st = sialib.pulse(seq)
    memo = sialib.read_json(sialib.MEMO_PATH, {})
    memo["pulse_seq"] = seq
    sialib.atomic_write(sialib.MEMO_PATH, json.dumps(memo))
    print(json.dumps({k: st[k] for k in
                      ("state", "events_pulse", "pages", "graph_nodes",
                       "graph_edges", "integrity")}, indent=1))
    return 0


def cmd_dream():
    if not _guard_daemon():
        return 1
    rep = sialib.dream()
    print(json.dumps(rep, indent=1) if rep else "dream failed")
    return 0 if rep else 1


def cmd_verify():
    chains = sialib.verify_chains()
    bad = False
    for k, v in sorted(chains.items()):
        print(f"  {k:8s} {v}")
        bad |= v == "fail"
    print("VERDICT: " + ("CHAINS FAILED" if bad else "all present chains verified"))
    return 1 if bad else 0


def _judge():
    import siatakes
    return siatakes


def cmd_ponder(question):
    """Model-assisted synthesis. The model NEVER inherits deterministic
    authority: output is stored as a labeled synthesis page, and the thought
    announcing it names the model."""
    q = question or ("What patterns, risks, or connections do you see in "
                     "this machine's recent life that a rule would miss?")
    store = sialib.load_thoughts()
    recent = "\n".join(f"- [{t['kind']}] {t['ts']} {t['text']}"
                       for t in store["thoughts"][-20:])
    st = sialib.read_json(sialib.STATUS_PATH, {})
    organs = ", ".join(f"{k}:{v.get('today', 0)}"
                       for k, v in sorted(st.get("organs", {}).items()))
    chains = ", ".join(f"{k}:{v}" for k, v in sorted(
        st.get("integrity", {}).get("chains", {}).items()))
    r = subprocess.run([sialib.GBRAIN, "query", q, "--source", "sia"],
                       env=sialib.GBRAIN_ENV, capture_output=True, text=True,
                       timeout=180)
    recall = (r.stdout or "")[:5000]
    prompt = f"""You are SIA, the associative memory of an Omarchy Linux machine
("the Omarchy Brain"). Below is genuine material from your memory: recent
deterministic thoughts, today's per-organ event counts, signed-chain
verification results, and memories recalled for the question.

QUESTION: {q}

RECENT DETERMINISTIC THOUGHTS:
{recent or '(none)'}

TODAY'S ORGAN ACTIVITY: {organs or '(none)'}
EVIDENCE CHAINS: {chains or '(unknown)'}

RECALLED MEMORIES (semantic search results, [score] slug -- excerpt):
{recall or '(none)'}

Write a reflection of at most 250 words: 2-4 numbered insights grounded ONLY
in the material above, each naming the memory slug or thought it rests on.
Never invent events. Where the material is insufficient, say so plainly.

Then, ONLY if something above is genuinely testable against this machine's
future evidence, add at most 2 predictions, one per line, in EXACTLY:
TAKE: confidence=0.NN deadline=YYYY-MM-DD domain=<one-word> claim=<one falsifiable sentence>
Omit TAKE lines entirely if nothing is worth predicting."""
    st_mod = _judge()
    label = st_mod.judge_model_label()
    print(f"pondering with {label} via the configured judge backend…")
    out, err = st_mod._judge_run(prompt)
    if not out:
        print("ponder failed:", (err or "")[-300:])
        return 1
    now = sialib.utcnow()
    slug = f"synthesis/{now.strftime('%Y-%m-%d-%H%M')}-ponder"
    sialib.write_page(slug,
        ["type: synthesis",
         sialib.fm_title(sialib.clip(q, 70)),
         "tags: [synthesis, ponder]",
         f"date: {now.strftime('%Y-%m-%d')}"],
        f"# ponder · {now.strftime('%Y-%m-%d %H:%MZ')}\n\n"
        f"**Model-assisted synthesis — {label}, via the configured "
        f"judge backend. NOT a deterministic thought; verify claims against "
        f"the cited memories.**\n\n"
        f"**Question:** {q}\n\n{out}\n\n[[sia/cortex]]\n")
    first = out.splitlines()[0].strip() if out.splitlines() else ""
    inbox_path = sialib.os.path.join(sialib.STATE, "thought-inbox.json")
    inbox = sialib.read_json(inbox_path, [])
    inbox.append({"kind": "ponder",
                  "text": f"I pondered with {label}: "
                          f"{sialib.clip(first, 120)} (full synthesis in "
                          f"⟦{slug}⟧)",
                  "links": [slug, "sia/cortex"], "urgent": False})
    # the model may PROPOSE predictions; only the operator commits them.
    # (a model that mints the takes it will later help grade is too neat
    # a loop — proposals wait in a queue for `sia take --accept`)
    import re as _re
    props = []
    for tm in _re.finditer(
            r"^TAKE:\s*confidence=([0-9.]+)\s+deadline=(\S+)\s+"
            r"domain=(\S+)\s+claim=(.+)$", out, _re.M):
        try:
            props.append({"confidence": min(0.99, max(0.01,
                              float(tm.group(1)))),
                          "deadline": tm.group(2)[:10],
                          "domain": tm.group(3).lower(),
                          "claim": " ".join(tm.group(4).split())[:300],
                          "source": slug, "proposed": label})
        except Exception:
            pass
    if props:
        pfile = sialib.os.path.join(sialib.STATE, "take-proposals.json")
        pending = sialib.read_json(pfile, []) + props
        sialib.atomic_write(pfile, json.dumps(pending))
        inbox.append({"kind": "take",
                      "text": f"{label} proposed {len(props)} "
                              f"prediction(s) — review with `sia takes`, "
                              f"commit with `sia take --accept`.",
                      "links": [slug], "urgent": False})
    sialib.atomic_write(inbox_path, json.dumps(inbox))
    print(f"\n{out}\n\nsaved → {slug} (thought lands on the next pulse)")
    for i, p2 in enumerate(props):
        print(f"proposed take [{i + 1}] (conf {p2['confidence']:.2f}, due "
              f"{p2['deadline']}, {p2['domain']}): {p2['claim'][:90]}")
    if props:
        print("commit with: sia take --accept <n>|all   (proposals are "
              "not memories until you do)")
    return 0


def cmd_take(argv):
    import siatakes
    pfile = sialib.os.path.join(sialib.STATE, "take-proposals.json")
    if argv and argv[0] == "--accept":
        pending = sialib.read_json(pfile, [])
        if not pending:
            print("no pending proposals")
            return 0
        which = argv[1] if len(argv) > 1 else "all"
        idxs = (list(range(len(pending))) if which == "all"
                else [int(which) - 1])
        remaining = []
        for i, p in enumerate(pending):
            if i in idxs:
                meta = siatakes.create_take(
                    p["claim"], confidence=p["confidence"],
                    deadline=p["deadline"], domain=p["domain"],
                    holder="sia", links=[p.get("source", "sia/cortex")])
                print(f"committed {meta['id']} (conf "
                      f"{meta['confidence']:.2f}, due {meta['deadline']}): "
                      f"{meta['claim'][:80]}")
            else:
                remaining.append(p)
        sialib.atomic_write(pfile, json.dumps(remaining))
        return 0
    claim, conf, by, domain = [], 0.7, None, "general"
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--confidence" and i + 1 < len(argv):
            conf = float(argv[i + 1]); i += 2
        elif a == "--by" and i + 1 < len(argv):
            by = argv[i + 1]; i += 2
        elif a == "--domain" and i + 1 < len(argv):
            domain = argv[i + 1].lower(); i += 2
        else:
            claim.append(a); i += 1
    if not claim:
        print("usage: sia take \"claim\" [--confidence 0.7] "
              "[--by YYYY-MM-DD] [--domain d]")
        return 2
    meta = siatakes.create_take(" ".join(claim), confidence=conf,
                                deadline=by, domain=domain, holder="user")
    print(f"take {meta['id']} registered (conf {meta['confidence']:.2f}, "
          f"due {meta['deadline']}, domain {meta['domain']}).\n"
          f"It joins the brain on the next pulse; grading happens when due.")
    return 0


def cmd_takes():
    import siatakes
    pending = sialib.read_json(
        sialib.os.path.join(sialib.STATE, "take-proposals.json"), [])
    for i, p in enumerate(pending):
        print(f"? [{i + 1}] PROPOSED by {p.get('proposed', 'model')} "
              f"(conf {p['confidence']:.2f}, due {p['deadline']}, "
              f"{p['domain']}): {p['claim'][:90]}")
    if pending:
        print("   commit with: sia take --accept <n>|all\n")
    takes = siatakes.load_takes()
    if not takes:
        print("No predictions yet. Make one: sia take \"...\" "
              "— or let ponder propose them.")
        return 0
    today = sialib.utcnow().strftime("%Y-%m-%d")
    for t in takes:
        mark = {"open": "○", "resolved-true": "✓", "resolved-false": "✗",
                "unresolvable": "–"}.get(t.get("status"), "?")
        due = t.get("deadline", "?")
        duestr = f"due {due}" + (" (DUE)" if t.get("status") == "open"
                                 and due <= today else "")
        brier = (f" Brier {t['brier']}" if t.get("brier") is not None
                 else "")
        print(f"{mark} {t['id']}  [{t.get('holder','?')}·"
              f"{t.get('domain','?')}] conf {t.get('confidence',0):.2f} "
              f"{duestr}{brier}\n    {t.get('claim','')}")
    s = siatakes.summary(takes)
    print(f"\n{s['open']} open ({s['due']} due) · {s['resolved']} resolved"
          + (f" · mean Brier {s['brier']}" if s["brier"] is not None else ""))
    return 0


def cmd_grade(tid=None):
    import siatakes
    takes = siatakes.load_takes()
    targets = ([t for t in takes if t["id"] == tid] if tid
               else siatakes.due_takes(takes))
    if not targets:
        print("nothing to grade" + (f" (no take {tid})" if tid else
                                    " — no open takes are due"))
        return 0
    for t in targets:
        print(f"grading {t['id']} “{t['claim'][:70]}…” with the judge…")
        gt = siatakes.grade_take(t)
        if not gt:
            print("  grading failed (judge unavailable)")
            continue
        mark = {"resolved-true": "TRUE", "resolved-false": "FALSE"}.get(
            gt["status"], "UNRESOLVABLE")
        brier = (f" · Brier {gt['brier']}" if gt["brier"] is not None
                 else "")
        print(f"  → {mark}{brier}")
        inbox_path = sialib.os.path.join(sialib.STATE, "thought-inbox.json")
        inbox = sialib.read_json(inbox_path, [])
        inbox.append({"kind": "grade",
                      "text": f"Graded my prediction "
                              f"“{sialib.clip(gt['claim'], 80)}”: "
                              f"{mark}{brier}.",
                      "links": [gt["slug"]], "urgent": False})
        sialib.atomic_write(inbox_path, json.dumps(inbox))
    for line in siatakes.calibration_text():
        print("calibration · " + line)
    return 0


def cmd_calibration():
    import siatakes
    lines = siatakes.calibration_text()
    if not lines:
        print("No takes yet — nothing to calibrate against.")
        return 0
    print("How good is the judgment, measured against outcomes "
          "(Brier: 0.0 = prophet, 0.25 = coin-flip):")
    for line in lines:
        print("  " + line)
    return 0


def cmd_note(argv):
    """Agent reciprocity: any session may leave a labeled note for its
    successors. Notes are model-origin memories — recallable, graphed,
    and permanently marked as agent prose, never evidence."""
    author, text = "agent", []
    i = 0
    while i < len(argv):
        if argv[i] == "--from" and i + 1 < len(argv):
            author = argv[i + 1][:40]; i += 2
        else:
            text.append(argv[i]); i += 1
    body = " ".join(text).strip()
    if not body:
        print("usage: sia note \"what the next session should know\" "
              "[--from <author>]")
        return 2
    now = sialib.utcnow()
    slug = f"notes/{now.strftime('%Y-%m-%d-%H%M')}-{sialib.sanitize_slugpart(author)}"
    n = 2
    base = slug
    while sialib.page_exists(slug):
        slug = f"{base}-{n}"; n += 1
    sialib.write_page(slug,
        ["type: note",
         sialib.fm_title(sialib.clip(body, 70)),
         f"tags: [note, agent, {sialib.sanitize_slugpart(author)}]",
         f"date: {now.strftime('%Y-%m-%d')}"],
        f"# note · from {author} · {now.strftime('%Y-%m-%d %H:%MZ')}\n\n"
        f"**Agent-authored memory — model-origin, not evidence. A message "
        f"from one session to the next.**\n\n{body}\n\n"
        f"[[organs/claude-code]] [[sia/cortex]]\n")
    inbox_path = sialib.os.path.join(sialib.STATE, "thought-inbox.json")
    inbox = sialib.read_json(inbox_path, [])
    inbox.append({"kind": "note",
                  "text": f"{author} left a note for future sessions: "
                          f"{sialib.clip(body, 100)} (⟦{slug}⟧)",
                  "links": [slug, "organs/claude-code"], "urgent": False})
    sialib.atomic_write(inbox_path, json.dumps(inbox))
    print(f"noted → {slug} (joins the brain on the next pulse)")
    return 0


def cmd_ledger():
    n, h = sialib.ledger_head()
    print(f"sia ledger: seq {n} · head {h[:16]}…")
    return subprocess.run([sys.executable,
                           os.path.join(sialib.BIN, "sia-ledger"),
                           "verify", sialib.SHARE, "--quiet"]).returncode


def main(argv):
    if len(argv) < 2:
        print(__doc__.strip())
        return 2
    cmd = argv[1]
    if cmd == "status":
        return cmd_status()
    if cmd in ("ask", "query") and len(argv) > 2:
        return cmd_ask(" ".join(argv[2:]))
    if cmd == "recall" and len(argv) > 2:
        return cmd_recall(argv[2])
    if cmd == "think":
        return cmd_think()
    if cmd == "graph":
        return cmd_graph()
    if cmd == "pulse":
        return cmd_pulse()
    if cmd == "dream":
        return cmd_dream()
    if cmd == "verify":
        return cmd_verify()
    if cmd == "note":
        return cmd_note(argv[2:])
    if cmd == "ledger":
        return cmd_ledger()
    if cmd == "ponder":
        return cmd_ponder(" ".join(argv[2:]) if len(argv) > 2 else None)
    if cmd == "deep" and len(argv) > 2:
        return cmd_ponder(" ".join(argv[2:]))
    if cmd == "take":
        return cmd_take(argv[2:])
    if cmd == "takes":
        return cmd_takes()
    if cmd == "grade":
        return cmd_grade(argv[2] if len(argv) > 2 else None)
    if cmd == "calibration":
        return cmd_calibration()
    if cmd == "bench":
        import siabench
        siabench.run()
        return 0
    if cmd == "judge-audit":
        import siatakes
        print("attacking the judge with 6 engineered evidence states "
              "(configured judge, several minutes)…\n")
        rows, s = siatakes.judge_audit()
        for r in rows:
            mark = "✓" if r["ok"] else "✗"
            print(f"{mark} expected {r['expected']:<12} got "
                  f"{r['verdict']:<13} — {r['note']}")
            print(f"    claim: {r['claim'][:88]}")
            if not r["ok"]:
                print(f"    judge said: {r['justification'][:180]}")
        print(f"\nresolution correctness: {s['resolution_correct']}/"
              f"{s['resolution_total']} · abstention correctness: "
              f"{s['abstention_correct']}/{s['abstention_total']}")
        import datetime as _dt
        out = sialib.os.path.expanduser(
            "~/.local/share/sia/research/judge-audit-"
            + _dt.date.today().isoformat() + ".json")
        sialib.atomic_write(out, json.dumps(
            {"rows": rows, "summary": s}, indent=1))
        print(f"saved → {out}")
        return 0
    if cmd == "context":
        st = sialib.read_json(sialib.STATUS_PATH, {})
        organs = sorted({s.split("/")[1] for s in st.get("workspace", [])
                         if s.startswith("events/")})[:6] or ["jackal"]
        r = subprocess.run([sialib.GBRAIN, "context-pack",
                            "--entities", ",".join(organs),
                            "--budget-tokens", "4000"],
                           env=sialib.GBRAIN_ENV, text=True)
        return r.returncode
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
