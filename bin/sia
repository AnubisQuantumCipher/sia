#!/usr/bin/env python3
"""sia — talk to the Omarchy Brain.

“Brain” is a product metaphor for auditable local machine memory; it is not a
biological brain and does not establish cognition or neuroscience.

  sia status            current indexed-memory and evidence-source state
  sia live [--json]     inspect the retained source-authorized live loop
  sia version           print the installed SIA runtime release
  sia ready             exit successfully only when memory is reconciled
  sia ask "question" [--no-touch]
                        query local memory; ordinary results record later use
  sia recall <slug> [--no-touch]
                        read one page; ordinary reads strengthen it
  sia memory [slug]     inspect stability decay + SM-2 schedule
  sia memory --pin <slug> | --unpin <slug>
                        queue an operator pin change for the daemon
  sia rehearse [slug]   list due reviews, or recall one page deliberately
  sia think             retained workspace and recent generated entries
  sia graph             graph statistics
  sia context           bounded context pack for agents and sessions
  sia pulse             run one brainstem pulse by hand (daemon must be off)
  sia readmit [--yes] [--json]
                        re-bind storage receipts after a filesystem move
                        (device/inode changed); --yes needs the daemon off
  sia repair-cortex-boundary [--regenerate-legacy-graph] [--json]
                        publish only the witnessed additive cortex prose repair
  sia dream             run the weekly-compaction cycle now (daemon must be off)
  sia verify            re-verify every signed evidence chain with attest
                        (the cockpit supplies a generation-bound receipt)
  sia ledger            show SIA's own signed run ledger head + verify
  sia note "text" [--from author]
                        queue a labeled, model-origin note for the brainstem
  sia ponder [question] model-assisted analysis by the configured, tool-free Claude
                        judge over recalled memories; writes a
                        clearly-labeled synthesis page + generated entry — and may
                        propose falsifiable takes
  sia take "claim" [--confidence 0.7] [--by YYYY-MM-DD] [--domain d]
                        register a falsifiable prediction (holder: user);
                        -- ends options, so claim text may begin with -
  sia takes             list predictions and their status
  sia intend "task" --by YYYY-MM-DD
                        dated commitment that SIA surfaces
                        as its deadline nears (--list · --done <id> [note]);
                        -- ends options here too
  sia grade [id]        grade due predictions now (configured judge,
                        deterministic Brier); with id, grade that one
  sia calibration [--cursor N]
                        descriptive Brier scorecard over resolved takes,
                        with bounded, pageable domain breakdowns
  sia bench [run|generate|score|cognitive|legacy] ...
                        signed-ledger retrieval and abstention benchmark;
                        cognitive runs an externally pinned private raw-vector baseline
  sia judge-audit       exercise the configured judge against engineered
                        evidence states; writes an owner-private report
  sia continuity roots --json
                        show the storage-independent portable-root contract
  sia continuity freeze --output ABSOLUTE_PATH
                        create a completed signed capsule off the live roots
  sia continuity export-identity --output ABSOLUTE_PATH
                        export the offline signing recovery document
  sia continuity verify CAPSULE --json
                        authenticate a completed capsule off-path
  sia backup ...        manage the replaceable recovery-repository adapter
  sia restore ...       prepare off-path recovery; live apply is ceremonial
  sia uninstall [--purge]
                        remove SIA through the installed sealed teardown path
"""

import contextlib, fcntl, json, math, os, re, stat, subprocess, sys


_INHERITED_LIFECYCLE_FD_ENV = "SIA_INHERITED_LIFECYCLE_FD"
_LAUNCHER_ABI = "sia-launch-v1"
_LAUNCHER_ABI_ENV = "SIA_LAUNCHER_ABI"
_LAUNCHER_LIFECYCLE_FD_ENV = "SIA_LAUNCHER_LIFECYCLE_FD"
_LAUNCHER_TARGET_FD_ENV = "SIA_LAUNCHER_TARGET_FD"
_LAUNCHER_TARGET_PATH_ENV = "SIA_LAUNCHER_TARGET_PATH"
_RESTORE_LAUNCH_ABI = "sia-restore-launch-v1"
_RESTORE_LAUNCH_ABI_ENV = "SIA_RESTORE_LAUNCH_ABI"
_RESTORE_LIFECYCLE_FD_ENV = "SIA_RESTORE_LIFECYCLE_FD"
_RESTORE_ADMIN_FD_ENV = "SIA_RESTORE_ADMIN_FD"
_RESTORE_TARGET_FD_ENV = "SIA_RESTORE_TARGET_FD"
_RESTORE_TARGET_PATH_ENV = "SIA_RESTORE_TARGET_PATH"
_RESTORE_MASK_OWNED_ENV = "SIA_RESTORE_MASK_OWNED"
_RESTORE_FINALIZE_ABI_ENV = "SIA_RESTORE_FINALIZE_ABI"
_RESTORE_FINALIZE_ADMIN_FD_ENV = "SIA_RESTORE_FINALIZE_ADMIN_FD"
_RESTORE_MASK_MARKER_BYTES = b"sia-continuity-runtime-mask-v1\n"
_ACTIVE_RESTORE_LIFECYCLE_FD = None


def _validated_inherited_lifecycle_fd(lock):
    """Validate the installer's exclusive lifecycle open-file description.

    The independent probe establishes that a conflicting lock exists.  The
    nonblocking exclusive operation on the inherited descriptor then proves
    that this exact open-file description owns that lock; a separately opened
    descriptor aimed at the same inode cannot impersonate the handoff.
    """
    raw = os.environ.get(_INHERITED_LIFECYCLE_FD_ENV)
    if raw is None:
        return None
    if not raw or not raw.isascii() or not raw.isdigit():
        raise RuntimeError("invalid inherited SIA lifecycle descriptor")
    try:
        inherited_fd = int(raw, 10)
        inherited = os.fstat(inherited_fd)
        target = os.lstat(lock)
    except (OSError, ValueError) as exc:
        raise RuntimeError(
            "invalid inherited SIA lifecycle descriptor") from exc
    if not stat.S_ISREG(inherited.st_mode) \
            or inherited.st_uid != os.geteuid() \
            or not stat.S_ISREG(target.st_mode) \
            or target.st_uid != os.geteuid() \
            or (inherited.st_dev, inherited.st_ino) != \
               (target.st_dev, target.st_ino):
        raise RuntimeError(
            "inherited SIA lifecycle descriptor is not the owned lease")

    flags = (os.O_RDWR | getattr(os, "O_CLOEXEC", 0)
             | getattr(os, "O_NOFOLLOW", 0))
    try:
        probe_fd = os.open(lock, flags)
    except OSError as exc:
        raise RuntimeError("could not probe inherited SIA lifecycle lease") \
            from exc
    try:
        probe = os.fstat(probe_fd)
        if not stat.S_ISREG(probe.st_mode) \
                or probe.st_uid != os.geteuid() \
                or (probe.st_dev, probe.st_ino) != \
                   (inherited.st_dev, inherited.st_ino):
            raise RuntimeError("SIA lifecycle lease changed during handoff")
        try:
            fcntl.flock(probe_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            fcntl.flock(probe_fd, fcntl.LOCK_UN)
            raise RuntimeError(
                "inherited SIA lifecycle descriptor has no conflicting lease")
        try:
            fcntl.flock(probe_fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            fcntl.flock(probe_fd, fcntl.LOCK_UN)
            raise RuntimeError(
                "inherited SIA lifecycle descriptor is not exclusively held")
        try:
            fcntl.flock(inherited_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError(
                "inherited SIA lifecycle descriptor does not own the lease") \
                from exc
    finally:
        os.close(probe_fd)
    return inherited_fd


def _validated_launcher_lifecycle_fd(lock, expected_target):
    """Validate the stable launcher's shared lease and pinned target."""
    names = (_LAUNCHER_ABI_ENV, _LAUNCHER_LIFECYCLE_FD_ENV,
             _LAUNCHER_TARGET_FD_ENV, _LAUNCHER_TARGET_PATH_ENV)
    values = tuple(os.environ.get(name) for name in names)
    if all(value is None for value in values):
        return None
    abi, lifecycle_raw, target_raw, target_path = values
    if abi != _LAUNCHER_ABI \
            or lifecycle_raw is None or target_raw is None \
            or not lifecycle_raw.isascii() or not lifecycle_raw.isdigit() \
            or not target_raw.isascii() or not target_raw.isdigit() \
            or target_path is None \
            or os.path.abspath(target_path) != os.path.abspath(expected_target) \
            or os.path.abspath(__file__) != os.path.abspath(expected_target):
        raise RuntimeError("invalid SIA stable-launcher handoff")
    try:
        lifecycle_fd = int(lifecycle_raw, 10)
        target_fd = int(target_raw, 10)
        inherited = os.fstat(lifecycle_fd)
        lock_target = os.lstat(lock)
        pinned_target = os.fstat(target_fd)
        current_target = os.lstat(expected_target)
    except (OSError, ValueError) as exc:
        raise RuntimeError("invalid SIA stable-launcher handoff") from exc
    if not stat.S_ISREG(inherited.st_mode) \
            or inherited.st_uid != os.geteuid() \
            or not stat.S_ISREG(lock_target.st_mode) \
            or lock_target.st_uid != os.geteuid() \
            or (inherited.st_dev, inherited.st_ino) != \
               (lock_target.st_dev, lock_target.st_ino) \
            or not stat.S_ISREG(pinned_target.st_mode) \
            or pinned_target.st_uid != os.geteuid() \
            or not stat.S_ISREG(current_target.st_mode) \
            or current_target.st_uid != os.geteuid() \
            or (pinned_target.st_dev, pinned_target.st_ino) != \
               (current_target.st_dev, current_target.st_ino):
        raise RuntimeError("SIA stable-launcher handoff changed generation")

    flags = (os.O_RDWR | getattr(os, "O_CLOEXEC", 0)
             | getattr(os, "O_NOFOLLOW", 0))
    try:
        probe_fd = os.open(lock, flags)
    except OSError as exc:
        raise RuntimeError("could not probe SIA stable-launcher lease") \
            from exc
    try:
        probe = os.fstat(probe_fd)
        if not stat.S_ISREG(probe.st_mode) \
                or probe.st_uid != os.geteuid() \
                or (probe.st_dev, probe.st_ino) != \
                   (inherited.st_dev, inherited.st_ino):
            raise RuntimeError("SIA stable-launcher lease changed")
        try:
            fcntl.flock(probe_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            fcntl.flock(probe_fd, fcntl.LOCK_UN)
            raise RuntimeError("SIA stable launcher holds no shared lease")
        try:
            fcntl.flock(probe_fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("SIA stable launcher inherited an exclusive lease") \
                from exc
        else:
            fcntl.flock(probe_fd, fcntl.LOCK_UN)
        try:
            fcntl.flock(lifecycle_fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("SIA stable-launcher lease is not shared") \
                from exc
    finally:
        os.close(probe_fd)
    return lifecycle_fd


def _validated_restore_launcher_fd(lock, expected_target):
    """Validate the one hidden stable-launcher path that holds lifecycle EX."""
    names = (_RESTORE_LAUNCH_ABI_ENV, _RESTORE_LIFECYCLE_FD_ENV,
             _RESTORE_ADMIN_FD_ENV, _RESTORE_TARGET_FD_ENV,
             _RESTORE_TARGET_PATH_ENV, _RESTORE_MASK_OWNED_ENV)
    values = tuple(os.environ.get(name) for name in names)
    if all(value is None for value in values):
        return None
    abi, lifecycle_raw, admin_raw, target_raw, target_path, mask_owned = values
    if abi != _RESTORE_LAUNCH_ABI \
            or lifecycle_raw is None or admin_raw is None \
            or target_raw is None \
            or not lifecycle_raw.isascii() or not lifecycle_raw.isdigit() \
            or not admin_raw.isascii() or not admin_raw.isdigit() \
            or not target_raw.isascii() or not target_raw.isdigit() \
            or mask_owned not in {"0", "1"} \
            or target_path is None \
            or os.path.abspath(target_path) != os.path.abspath(expected_target) \
            or os.path.abspath(__file__) != os.path.abspath(expected_target) \
            or not ((len(sys.argv) == 3
                     and sys.argv[1] == "_continuity-restore-worker"
                     and os.path.isabs(sys.argv[2]))
                    or (len(sys.argv) == 3
                        and sys.argv[1] == "_continuity-restore-recover"
                        and re.fullmatch(r"[0-9a-f]+", sys.argv[2])
                        is not None)) \
            or os.environ.get(_INHERITED_LIFECYCLE_FD_ENV) is not None:
        raise RuntimeError("invalid SIA restore-launcher handoff")
    if any(os.environ.get(name) is not None for name in (
            _LAUNCHER_ABI_ENV, _LAUNCHER_LIFECYCLE_FD_ENV,
            _LAUNCHER_TARGET_FD_ENV, _LAUNCHER_TARGET_PATH_ENV,
            _RESTORE_FINALIZE_ABI_ENV,
            _RESTORE_FINALIZE_ADMIN_FD_ENV)):
        raise RuntimeError("mixed SIA launcher capabilities are forbidden")
    try:
        lifecycle_fd = int(lifecycle_raw, 10)
        admin_fd = int(admin_raw, 10)
        target_fd = int(target_raw, 10)
        inherited = os.fstat(lifecycle_fd)
        lock_target = os.lstat(lock)
        admin = os.fstat(admin_fd)
        admin_path = os.path.join(
            os.path.dirname(lock), "sia.lifecycle-admin.lock")
        admin_target = os.lstat(admin_path)
        pinned_target = os.fstat(target_fd)
        current_target = os.lstat(expected_target)
    except (OSError, ValueError) as exc:
        raise RuntimeError("invalid SIA restore-launcher handoff") from exc
    if not stat.S_ISREG(inherited.st_mode) \
            or inherited.st_uid != os.geteuid() \
            or not stat.S_ISREG(lock_target.st_mode) \
            or lock_target.st_uid != os.geteuid() \
            or (inherited.st_dev, inherited.st_ino) != \
               (lock_target.st_dev, lock_target.st_ino) \
            or not stat.S_ISREG(admin.st_mode) \
            or admin.st_uid != os.geteuid() \
            or not stat.S_ISREG(admin_target.st_mode) \
            or admin_target.st_uid != os.geteuid() \
            or (admin.st_dev, admin.st_ino) != \
               (admin_target.st_dev, admin_target.st_ino) \
            or not stat.S_ISREG(pinned_target.st_mode) \
            or pinned_target.st_uid != os.geteuid() \
            or not stat.S_ISREG(current_target.st_mode) \
            or current_target.st_uid != os.geteuid() \
            or (pinned_target.st_dev, pinned_target.st_ino) != \
               (current_target.st_dev, current_target.st_ino):
        raise RuntimeError("SIA restore-launcher generation changed")
    flags = (os.O_RDWR | getattr(os, "O_CLOEXEC", 0)
             | getattr(os, "O_NOFOLLOW", 0))
    probe_fd = os.open(lock, flags)
    try:
        probe = os.fstat(probe_fd)
        if not stat.S_ISREG(probe.st_mode) \
                or probe.st_uid != os.geteuid() \
                or (probe.st_dev, probe.st_ino) != \
                   (inherited.st_dev, inherited.st_ino):
            raise RuntimeError("SIA restore lifecycle lease changed")
        try:
            fcntl.flock(probe_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            fcntl.flock(probe_fd, fcntl.LOCK_UN)
            raise RuntimeError("SIA restore lifecycle lease is not held")
        try:
            fcntl.flock(probe_fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            fcntl.flock(probe_fd, fcntl.LOCK_UN)
            raise RuntimeError("SIA restore lifecycle lease is not exclusive")
        try:
            fcntl.flock(lifecycle_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError(
                "SIA restore descriptor does not own lifecycle EX") from exc
    finally:
        os.close(probe_fd)
    admin_probe = os.open(admin_path, flags)
    try:
        probe = os.fstat(admin_probe)
        if not stat.S_ISREG(probe.st_mode) \
                or probe.st_uid != os.geteuid() \
                or (probe.st_dev, probe.st_ino) != \
                   (admin.st_dev, admin.st_ino):
            raise RuntimeError("SIA restore admin lease changed")
        try:
            fcntl.flock(admin_probe, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            fcntl.flock(admin_probe, fcntl.LOCK_UN)
            raise RuntimeError("SIA restore admin lease is not exclusive")
        try:
            fcntl.flock(admin_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError(
                "SIA restore descriptor does not own admin EX") from exc
    finally:
        os.close(admin_probe)
    marker_path = os.path.join(
        os.path.dirname(lock), "sia-continuity", "restore-runtime-mask")
    if mask_owned == "1":
        marker_flags = (os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
                        | getattr(os, "O_NOFOLLOW", 0))
        marker_fd = None
        try:
            marker_fd = os.open(marker_path, marker_flags)
            marker_info = os.fstat(marker_fd)
            if marker_info.st_size != len(_RESTORE_MASK_MARKER_BYTES):
                raise RuntimeError(
                    "SIA restore runtime-mask marker is unsafe")
            marker_bytes = os.read(
                marker_fd, len(_RESTORE_MASK_MARKER_BYTES))
        except OSError as exc:
            raise RuntimeError("SIA restore runtime-mask marker is absent") \
                from exc
        finally:
            if marker_fd is not None:
                os.close(marker_fd)
        if not stat.S_ISREG(marker_info.st_mode) \
                or marker_info.st_uid != os.geteuid() \
                or marker_info.st_nlink != 1 \
                or stat.S_IMODE(marker_info.st_mode) != 0o600 \
                or marker_bytes != _RESTORE_MASK_MARKER_BYTES:
            raise RuntimeError("SIA restore runtime-mask marker is unsafe")
    elif os.path.lexists(marker_path):
        raise RuntimeError("unowned SIA restore runtime-mask marker exists")
    return lifecycle_fd


def _runtime_module_dir(script_path=None, home=None):
    """Find SIA's Python modules in a checkout or an installed runtime."""
    script_dir = os.path.dirname(os.path.abspath(script_path or __file__))
    installed_dir = os.path.join(
        home if home is not None else os.path.expanduser("~"),
        ".local", "share", "sia", "bin")
    for candidate in (script_dir, installed_dir):
        if os.path.isfile(os.path.join(candidate, "sialib.py")):
            return candidate
    raise ImportError(
        "SIA runtime modules not found beside the CLI or under "
        "~/.local/share/sia/bin; reinstall SIA")


@contextlib.contextmanager
def _runtime_generation_lease(home=None):
    """Pin one installed runtime generation before importing its modules."""
    home = home if home is not None else os.path.expanduser("~")
    parent = os.path.join(home, ".local", "state")
    lock = os.path.join(parent, "sia.lifecycle.lock")
    tombstone = os.path.join(parent, "sia.lifecycle-removed")
    os.makedirs(parent, exist_ok=True)
    if _validated_inherited_lifecycle_fd(lock) is not None:
        # The installer keeps both its exclusive lease and, on a purged
        # reinstall, the public tombstone.  Only this validated child may run
        # first light inside that otherwise closed generation.
        yield
        return
    expected_target = os.path.join(
        home, ".local", "share", "sia", "bin", "sia-cli")
    restore_fd = _validated_restore_launcher_fd(lock, expected_target)
    if restore_fd is not None:
        if os.path.lexists(tombstone):
            marker = os.lstat(tombstone)
            if not stat.S_ISREG(marker.st_mode) \
                    or marker.st_uid != os.geteuid():
                raise RuntimeError("SIA lifecycle removal marker is unsafe")
            raise RuntimeError(
                "SIA runtime was removed; reinstall before restoring")
        global _ACTIVE_RESTORE_LIFECYCLE_FD
        _ACTIVE_RESTORE_LIFECYCLE_FD = restore_fd
        os.environ[_INHERITED_LIFECYCLE_FD_ENV] = str(restore_fd)
        try:
            yield
        finally:
            _ACTIVE_RESTORE_LIFECYCLE_FD = None
            os.environ.pop(_INHERITED_LIFECYCLE_FD_ENV, None)
        return
    if _validated_launcher_lifecycle_fd(lock, expected_target) is not None:
        if os.path.lexists(tombstone):
            marker = os.lstat(tombstone)
            if not stat.S_ISREG(marker.st_mode) \
                    or marker.st_uid != os.geteuid():
                raise RuntimeError("SIA lifecycle removal marker is unsafe")
            raise RuntimeError(
                "SIA runtime was removed; reinstall before using it")
        yield
        return
    flags = (os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0)
             | getattr(os, "O_NOFOLLOW", 0))
    fd = os.open(lock, flags, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
            raise RuntimeError("SIA lifecycle lease is not an owned regular file")
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_SH)
        try:
            if os.path.lexists(tombstone):
                marker = os.lstat(tombstone)
                if not stat.S_ISREG(marker.st_mode) \
                        or marker.st_uid != os.geteuid():
                    raise RuntimeError("SIA lifecycle removal marker is unsafe")
                raise RuntimeError(
                    "SIA runtime was removed; reinstall before using it")
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


# Importing launchers in the test harness keeps the existing module surface.
# Executed launchers defer this import until the generation lease is held.
sialib = None
if __name__ != "__main__":
    sys.path.insert(0, _runtime_module_dir())
    import sialib as _sialib
    sialib = _sialib


def daemon_running():
    r = sialib._run_bounded_text_process(
        ["systemctl", "--user", "is-active", "sia-brainstem"],
        env=None, timeout=sialib.JOURNAL_TIMEOUT_SECONDS, cwd=None,
        label="systemctl status")
    return r.stdout.strip() == "active"


MAX_LIVE_TEXT_BYTES = 65_536


def _live_refusal_result(reason, *, refusal=None):
    import sialiveview
    value = (refusal if isinstance(refusal, sialiveview.LiveViewRefusal)
             else sialiveview.LiveViewRefusal(reason))
    return {
        "schema": "sia-controller-live-view-refusal-v1",
        "status": "refused", "reason": value.reason,
        "upstream_reason": value.upstream_reason,
        "non_claims": list(sialiveview.NON_CLAIMS),
        "upstream_non_claims": value.upstream_non_claims,
    }


def _read_live_view_result():
    import sialiveview
    try:
        return sialiveview.read_cached_view(sialib.__dict__)
    except sialiveview.LiveViewRefusal as exc:
        return _live_refusal_result(exc.reason, refusal=exc)
    except (OSError, RuntimeError, TypeError, ValueError, KeyError,
            AttributeError, OverflowError, RecursionError):
        return _live_refusal_result("live-inspection-unavailable")


def _live_score_text(item):
    if item["score"] is None:
        return item["status"] + " (" + item["reason"] + ")"
    # String conversion renders the retained component observation. No score
    # adjustment, rounding, confidence conversion or new metric occurs here.
    return str(item["score"]) + " (" + item["status"] + ")"


def _live_view_text(value):
    if value["status"] == "refused":
        lines = ["  live     refused · " + value["reason"]]
        if value["upstream_reason"] is not None:
            lines.append("           source boundary: " + value["upstream_reason"])
    else:
        workspace = value["workspace"]
        selection = workspace["selection"]
        lines = [
            "  live     retained pulse " + str(value["publication"]["pulse_seq"])
            + " · as_of " + str(value["as_of"]) + " · computed-unverified",
            "  workspace " + workspace["phase"] + " · " + workspace["transition"]
            + " · capacity " + str(workspace["capacity"])
            + " · ignition threshold " + str(workspace["ignition_threshold"]),
        ]
        if workspace["release_reason"] is not None:
            lines.append("           release: " + workspace["release_reason"])
        if selection is not None:
            lines.append("           selection retained at " + str(selection["observed_at"])
                         + " · held expiry " + str(workspace["expires_at"]))
            selected_scores = {row["subject"]: row
                               for row in selection["activation"]["activations"]}
            current_scores = {row["subject"]: row
                              for row in value["activation"]["activations"]}
            origins = {row["subject"]: row["origin"]
                       for row in workspace["selected_sources"]}
            for subject in workspace["slots"]:
                lines.append("           [origin:" + origins[subject] + "] " + subject)
                lines.append("             why: retained activation selection "
                             + _live_score_text(selected_scores[subject])
                             + " · current " + _live_score_text(current_scores[subject]))
        else:
            lines.append("           no selected slot in this retained observation")
        lines.append("  encoding " + value["encoding"]["status"]
                     + " · activation " + value["activation"]["status"]
                     + " · co-retrieval " + value["coretrieval"]["status"])
        idle = value["idle"]
        availability = idle["availability"]
        if availability is None:
            availability = "requested" if idle["requested"] else "not-requested"
        lines.append("  idle     " + availability + " · gist receipt "
                     + idle["gist_publication_status"])
    lines.extend("  boundary " + boundary for boundary in value["non_claims"])
    lines.append("           full retained component boundaries and identities: sia live --json")
    result = "\n".join(lines) + "\n"
    if sialib.strip_controls(result) != result \
            or len(result.encode("utf-8")) > MAX_LIVE_TEXT_BYTES:
        raise ValueError("live display representation")
    return result


def _print_live_summary(value=None):
    selected = _read_live_view_result() if value is None else value
    try:
        text = _live_view_text(selected)
    except (OSError, RuntimeError, TypeError, ValueError, KeyError,
            AttributeError, OverflowError, RecursionError):
        selected = _live_refusal_result("live-display-unavailable")
        text = _live_view_text(selected)
    sys.stdout.write(text)
    return selected


def _print_live_json(value):
    import sialiveview
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"),
                         ensure_ascii=True, allow_nan=False)
    # The newline is part of the complete public output envelope.
    if len(encoded.encode("utf-8")) >= sialiveview.MAX_VIEW_BYTES:
        value = _live_refusal_result("live-output-capacity")
        encoded = json.dumps(value, sort_keys=True, separators=(",", ":"),
                             ensure_ascii=True, allow_nan=False)
        if len(encoded.encode("utf-8")) >= sialiveview.MAX_VIEW_BYTES:
            print("SIA live output refused: live-output-capacity", file=sys.stderr)
            return 1
    print(encoded)
    return 1 if value["status"] == "refused" else 0


def cmd_live(args):
    if args not in ([], ["--json"]):
        print("usage: sia live [--json]")
        return 2
    value = _read_live_view_result()
    if args == ["--json"]:
        return _print_live_json(value)
    value = _print_live_summary(value)
    return 1 if value["status"] == "refused" else 0


@contextlib.contextmanager
def _corpus_owner_nowait():
    """Join an inherited owner or acquire the resident transaction immediately."""
    if sialib._CORPUS_OWNER_DEPTH.get() \
            or sialib._validated_inherited_corpus_fd() is not None:
        with sialib.corpus_owner() as owner_fd:
            yield owner_fd
        return
    with sialib._owner_lease(
            sialib.CORPUS_OWNER_LOCK, "SIA corpus transaction",
            blocking=False) as owner_fd:
        depth_token = sialib._CORPUS_OWNER_DEPTH.set(1)
        fd_token = sialib._CORPUS_OWNER_FD.set(owner_fd)
        try:
            yield owner_fd
        finally:
            sialib._CORPUS_OWNER_FD.reset(fd_token)
            sialib._CORPUS_OWNER_DEPTH.reset(depth_token)


def _print_pulse_failure():
    """Name the last retained pulse refusal; SOURCE HEALTH cannot publish it
    while a controller-source transaction holds publication authority."""
    failure = sialib.read_pulse_failure()
    if failure is None:
        return None
    print(f"  pulse    last pulse {failure['pulse_seq']} FAILED at "
          f"{failure['failed_at']}: {failure['detail']}")
    print("           the resident daemon retries; see: journalctl --user -u "
          "sia-brainstem")
    return failure


def cmd_status():
    try:
        with _corpus_owner_nowait():
            return _cmd_status_owned()
    except sialib.OwnerBusy:
        print("SIA · resident pulse in progress · readiness check deferred")
        _print_pulse_failure()
        selected = _print_live_summary()
        return 1 if selected["status"] == "refused" else 0


def _cmd_status_owned():
    try:
        st = sialib.read_state_json(
            sialib.STATUS_PATH, None, "resident status", expected_type=dict)
    except RuntimeError:
        print("SIA status snapshot is invalid; current claims are unavailable")
        if sialib.CONFIG_ERRORS:
            print(f"  config   {sialib.CONFIG_ERRORS}")
        return 1
    if st is None:
        print("SIA has no status yet — is sia-brainstem running?")
        if sialib.CONFIG_ERRORS:
            print(f"  config   {sialib.CONFIG_ERRORS}")
        return 1
    if sialib._recoverable_status_integrity(st) is None:
        print("SIA status snapshot is invalid; current claims are unavailable")
        if sialib.CONFIG_ERRORS:
            print(f"  config   {sialib.CONFIG_ERRORS}")
        return 1
    try:
        graph = sialib.read_state_json(
            sialib.GRAPH_PATH, None, "resident graph", expected_type=dict)
    except RuntimeError:
        print("SIA graph snapshot is invalid; current claims are unavailable")
        if sialib.CONFIG_ERRORS:
            print(f"  config   {sialib.CONFIG_ERRORS}")
        return 1
    graph_generation = sialib._recoverable_graph_snapshot(graph)
    graph_mismatch = (
        not _valid_verify_graph_snapshot(graph, st)
        if st["graph_publication_id"] else graph_generation is not None)
    if graph_mismatch:
        print("SIA status/graph generation mismatch; "
              "current claims are unavailable")
        if sialib.CONFIG_ERRORS:
            print(f"  config   {sialib.CONFIG_ERRORS}")
        return 1
    ic = st.get("integrity", {})
    print(f"SIA · state {st['state']} · pulse {st['pulse_seq']} · {st['ts']}")
    ready, readiness_reason = sialib.memory_readiness()
    if ready:
        print("  readiness READY — corpus, PGLite, and graph reconciled")
    else:
        print(f"  readiness BLOCKED — {readiness_reason}")
    if st["graph_publication_id"]:
        print(f"  memory   {st.get('pages', '?')} pages · graph "
              f"{st.get('graph_nodes', '?')} nodes / "
              f"{st.get('graph_edges', '?')} edges")
    else:
        print("  memory   unavailable — no admitted graph generation")
    per_organ = ", ".join(f"{k}:{v.get('today', 0)}"
                          for k, v in sorted(st.get("organs", {}).items())
                          if v.get("today"))
    print(f"  today    {st.get('events_today', 0)} events ({per_organ})")
    print(f"  chains   {ic.get('verdict', '?')} "
          f"({', '.join(f'{k}:{v}' for k, v in sorted(ic.get('chains', {}).items()))})")
    ledger = st.get("ledger", {})
    if ledger.get("seq") == 0 and ledger.get("head") == "":
        print("  ledger   signed ledger head unavailable")
    else:
        print(f"  ledger   seq {ledger.get('seq', '?')} · "
              f"head {ledger.get('head', '?')}…")
    mind = st.get("mind", {})
    if mind:
        print(f"  decay    {mind.get('decay_active', '?')} active / "
              f"{mind.get('decay_demoted', '?')} demoted co-return edges · evidence kept")
        print(f"  review   {mind.get('rehearsal_due', '?')} due / "
              f"{mind.get('rehearsal_eligible', '?')} eligible · "
              f"{mind.get('pinned', '?')} pinned")
        familiarity = {
            "complete": "complete · first/new-shape detection available",
            "incomplete": "incomplete · first/new-shape claims withheld",
            "bootstrap-pending": (
                "bootstrap pending · baseline not admitted; "
                "first/new-shape claims withheld"),
        }.get(mind.get("familiarity_status"),
              "unavailable · detector status invalid")
        if "familiarity_status" not in mind:
            familiarity = (
                "unavailable · legacy status; detector availability unreported")
        print(f"  familiarity {familiarity}")
    th = st.get("thought", {})
    if th.get("text"):
        origin = th.get("origin")
        if origin not in {"evidence", "derived", "model"}:
            origin = "legacy-unlabeled"
        print(f"  entry    [origin:{origin}] "
              f"[{sialib.clip(th.get('kind'), 30)}] "
              f"{sialib.inert_summary(th['text'])}")
    dr = st.get("dream", {})
    if dr.get("attempt"):
        print(f"  weekly   attempt {dr['attempt'][:16]} "
              f"{dr.get('status', '')} {dr.get('summary', '')}")
        if dr.get("last"):
            print(f"           prior success {dr['last'][:16]}")
    elif dr.get("last"):
        print(f"  weekly   {dr.get('last', '')[:16]} {dr.get('status', '')} "
              f"{dr.get('summary', '')}")
    if st.get("errors"):
        print(f"  errors   {st['errors']}")
    if sialib.CONFIG_ERRORS:
        print(f"  config   {sialib.CONFIG_ERRORS}")
    _print_live_summary()
    return 0


def cmd_ready():
    """Machine-readable health gate for installers and operators."""
    with sialib.corpus_owner():
        ready, reason = sialib.memory_readiness()
    if ready:
        print("SIA memory ready")
        return 0
    print("SIA memory not ready: " + reason)
    _print_pulse_failure()
    return 1


_CORPUS_RECEIPT_PATH = os.path.join(sialib.STATE, "managed-install", "corpus")
_CORPUS_RECEIPT_HEAD = ("managed-by=khephri.sia", "kind=corpus-v2")


def _corpus_root_identity():
    """The installer's corpus root identity: dev:ino:mode:uid of the live
    corpus directory, opened without following links."""
    flags = (os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
             | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0))
    descriptor = os.open(sialib.CORPUS, flags)
    try:
        info = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        raise ValueError("corpus root is not an owned directory")
    return ":".join(str(value) for value in (
        info.st_dev, info.st_ino, info.st_mode, info.st_uid))


def _corpus_receipt_readmit(apply):
    """Observe, and with ``apply`` re-bind, the installer's corpus receipt.

    The receipt is `managed-by=khephri.sia / kind=corpus-v2 / path= / root=`.
    Only a v2 receipt for this exact corpus path is ever rewritten, and only
    its root line changes; anything else is left for the installer's own
    fail-closed recovery.
    """
    result = {"path": _CORPUS_RECEIPT_PATH}
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) \
        | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(_CORPUS_RECEIPT_PATH, flags)
    except FileNotFoundError:
        result.update(status="absent", detail="no corpus receipt is installed")
        return result
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() \
                or info.st_nlink != 1 or info.st_size > 4096:
            raise ValueError("corpus receipt is not an owned private file")
        raw = os.read(descriptor, 4097)
    finally:
        os.close(descriptor)
    lines = raw.decode("utf-8", "strict").split("\n")
    if lines and lines[-1] == "":
        lines = lines[:-1]
    expected_head = list(_CORPUS_RECEIPT_HEAD) + ["path=" + sialib.CORPUS]
    if len(lines) != 4 or lines[:3] != expected_head \
            or not lines[3].startswith("root=") \
            or re.fullmatch(r"root=[0-9]+:[0-9]+:[0-9]+:[0-9]+", lines[3]) is None:
        result.update(status="unrecognized",
                      detail="receipt is not a v2 receipt for this corpus; "
                             "rerun install.sh for its own recovery")
        return result
    recorded = lines[3][len("root="):]
    observed = _corpus_root_identity()
    result.update(recorded_root=recorded, observed_root=observed)
    if recorded == observed:
        result.update(status="bound", detail="corpus root identity matches")
        return result
    result["detail"] = f"corpus root expected {recorded}, observed {observed}"
    if not apply:
        result["status"] = "drifted"
        return result
    payload = "\n".join(expected_head + ["root=" + observed]) + "\n"
    sialib.atomic_write(_CORPUS_RECEIPT_PATH, payload, mode=0o600)
    with open(_CORPUS_RECEIPT_PATH, encoding="utf-8") as stream:
        if stream.read() != payload:
            raise RuntimeError("corpus receipt readback differs")
    if _corpus_root_identity() != observed:
        raise RuntimeError("corpus root changed during readmission")
    result.update(status="readmitted", previous_root=recorded)
    return result


def cmd_readmit(args):
    """Re-bind storage identity receipts after a filesystem move.

    A btrfs subvolume change, a copied home directory, or a restore by copy
    changes the device and inode numbers that two receipts bind: the
    installer's corpus receipt and the delivery epoch's records directory.
    Both stay refused until an operator readmits them; nothing is guessed.
    """
    if len(args) != len(set(args)) or any(
            item not in {"--yes", "--json"} for item in args):
        print("usage: sia readmit [--yes] [--json]")
        return 2
    apply = "--yes" in args
    as_json = "--json" in args
    import time
    import siacontrollerdeliveryepoch as epochs
    report = {"schema": "sia-readmit-v1", "applied": apply}
    try:
        with sialib.brainstem_owner(), sialib.corpus_owner():
            report["corpus_receipt"] = _corpus_receipt_readmit(apply)
            report["delivery_epoch"] = epochs.readmit_epoch(
                sialib.__dict__, memo=sialib.load_memo(),
                readmitted_at=int(time.time()), apply=apply)
    except sialib.OwnerBusy:
        report["status"] = "refused"
        report["reason"] = "runtime-owned"
        if as_json:
            print(json.dumps(report, sort_keys=True))
        else:
            print("SIA readmit refused: runtime-owned — stop the resident "
                  "daemon first:")
            print("  systemctl --user stop sia-brainstem && sia readmit"
                  + (" --yes" if apply else "")
                  + " && systemctl --user start sia-brainstem")
        return 1
    except epochs.ControllerDeliveryEpochRefusal as exc:
        report["status"] = "refused"
        report["reason"] = exc.reason
        if exc.detail is not None:
            report["detail"] = exc.detail
        if as_json:
            print(json.dumps(report, sort_keys=True))
        else:
            print("SIA readmit refused: " + exc.reason
                  + ("" if exc.detail is None else " (" + exc.detail + ")"))
        return 1
    except (OSError, RuntimeError, ValueError) as exc:
        report["status"] = "refused"
        report["reason"] = "receipt-observation-refused"
        report["detail"] = sialib.clip(sialib.inert_summary(str(exc)), 160)
        if as_json:
            print(json.dumps(report, sort_keys=True))
        else:
            print("SIA readmit refused: " + report["detail"])
        return 1
    states = {report["corpus_receipt"]["status"],
              report["delivery_epoch"]["status"]}
    report["status"] = ("drifted" if "drifted" in states
                        else "readmitted" if "readmitted" in states
                        else "bound")
    if as_json:
        print(json.dumps(report, sort_keys=True))
    else:
        for label, key in (("corpus receipt", "corpus_receipt"),
                           ("delivery epoch", "delivery_epoch")):
            item = report[key]
            print(f"  {label:15} {item['status']:11} {item['detail']}")
        if report["status"] == "drifted":
            print("storage identity drifted; to re-bind it (daemon must be off):")
            print("  systemctl --user stop sia-brainstem && sia readmit --yes "
                  "&& systemctl --user start sia-brainstem")
        elif report["status"] == "readmitted":
            print("storage receipts readmitted; the next pulse revalidates the "
                  "retained journal content and republishes memory.")
        else:
            print("storage identity is bound; nothing to readmit.")
        for line in epochs.READMISSION_NON_CLAIMS:
            print("  boundary " + line)
    return 1 if report["status"] == "drifted" else 0


def _gbrain_read(args, timeout=None):
    import time
    for attempt in range(3):
        # sialib.gbrain holds SIA's cross-process PGLite owner lease.
        r = (sialib.gbrain(args, timeout=timeout) if timeout is not None
             else sialib.gbrain(args))
        if r.returncode == 0 or "already open" not in (r.stdout + r.stderr):
            break
        time.sleep(2)      # brainstem pulse briefly holds the memory index; retry
    return r


def _gbrain_query(q, json_out=False):
    args = ["query", q, "--source", "sia"]
    if json_out:
        args.append("--json")
    return _gbrain_read(args)


def _canonical_slug(slug):
    return (isinstance(slug, str) and 0 < len(slug) <= 200
            and "//" not in slug
            and re.fullmatch(r"[a-z0-9][a-z0-9/._-]*", slug) is not None
            and all(part not in {"", ".", ".."}
                    for part in slug.split("/")))


def _existing_corpus_page(slug):
    """Accept only a real Markdown page contained by the corpus root."""
    if not _canonical_slug(slug):
        return False
    path = sialib.corpus_path(slug)
    try:
        import stat
        corpus_root = os.path.realpath(sialib.CORPUS)
        resolved = os.path.realpath(path)
        if os.path.commonpath((corpus_root, resolved)) != corpus_root:
            return False
        return stat.S_ISREG(os.stat(path, follow_symlinks=False).st_mode)
    except (OSError, ValueError):
        return False


def _reinforce(slugs, src):
    """Queue recall reinforcement for the brainstem and say so when it is
    refused.

    Every recall verb goes through here because `ask` and `recall` had
    already drifted apart: both printed this same refusal, but `recall`
    returned 1 and `ask` returned 0, so the same broken touch queue was a
    failure through one verb and a success through the other. One path
    means the message and the status decision cannot diverge again.

    The status contract this pins: a refused reinforcement is NOT a failed
    answer. Exit status answers "did the caller get the memory it asked
    for?", and the memory is already on stdout, correct and origin-labeled,
    when the touch queue is down. Reinforcement is a write-behind side
    effect on a separate queue that the brainstem drains later.

    So both verbs return 0 and the refusal travels in-band instead: on
    stderr here, and in the answer's own truth-boundary line. The opposite
    choice — failing `ask` too — was rejected because `ask` already spends
    status 1 on "result admission refused", which means no trustworthy
    answer was printed at all. Two opposite situations behind one status is
    exactly the ambiguity this audit found.

    Fail-closed is kept where it carries meaning: `rehearse` exists to
    reinforce, so it still refuses (see cmd_rehearse) using the reason
    recorded by its caller.
    """
    import siamind
    if siamind.queue_touches(slugs, src=src):
        return True
    print("reinforcement refused: touch queue is unavailable; "
          "the memory above still stands", file=sys.stderr)
    return False


def _health_footer(keyword_only=False, recall_degraded="",
                   reinforcement_refused=False):
    """Every recall answer carries its truth boundary — the same grain the
    cockpit shows: sense freshness, chain state, snapshot completeness,
    recall mode. An answer over a degraded memory index must say so inline."""
    import datetime as _dt
    status_read_invalid = False
    graph_read_invalid = False
    try:
        raw_status = sialib.read_state_json(
            sialib.STATUS_PATH, None, "resident status", expected_type=dict)
    except RuntimeError:
        raw_status = None
        status_read_invalid = True
    try:
        raw_graph = sialib.read_state_json(
            sialib.GRAPH_PATH, None, "resident graph", expected_type=dict)
    except RuntimeError:
        raw_graph = None
        graph_read_invalid = True
    bits = []
    status_valid = sialib._recoverable_status_integrity(raw_status) \
        is not None
    graph_generation = sialib._recoverable_graph_snapshot(raw_graph)
    st = raw_status if status_valid else {}
    g = raw_graph if graph_generation is not None else {}
    if status_read_invalid or raw_status is not None and not status_valid:
        bits.append("STATUS SNAPSHOT INVALID")
    try:
        age = (_dt.datetime.now(_dt.timezone.utc)
               - _dt.datetime.strptime(st.get("ts", ""),
                                       "%Y-%m-%dT%H:%M:%SZ")
               .replace(tzinfo=_dt.timezone.utc)).total_seconds()
        if age < 0:
            bits.append("SENSES STALE (future timestamp)")
        elif age < 240:
            bits.append("senses live")
        else:
            bits.append(f"SENSES STALE ({int(age // 60)}m)")
    except Exception:
        bits.append("SENSES UNKNOWN")
    ic = st.get("integrity")
    verdict = ic.get("verdict") if isinstance(ic, dict) else None
    if verdict not in {"pass", "fail", "degraded", "unknown"}:
        verdict = "unknown"
    bits.append(f"chains {verdict}")
    errors = st.get("errors")
    if isinstance(errors, dict):
        if errors:
            bits.append(f"{len(errors)} sense error(s)")
    elif errors is not None:
        bits.append("sense errors unknown")
    snap = g.get("snapshot")
    status_graph_id = st.get("graph_publication_id")
    graph_id = g.get("publication_id")
    status_graph_known = isinstance(status_graph_id, str) \
        and bool(status_graph_id)
    graph_id_known = isinstance(graph_id, str) and bool(graph_id)
    graph_bound = graph_generation is not None and status_valid \
        and status_graph_id == graph_generation["publication_id"] \
        and st.get("graph_nodes") == graph_generation["nodes"] \
        and st.get("graph_edges") == graph_generation["edges"] \
        and st.get("pages") == graph_generation["pages"]
    if graph_read_invalid or raw_graph is not None \
            and graph_generation is None:
        bits.append("GRAPH SNAPSHOT INVALID")
    elif status_graph_known and graph_id_known and not graph_bound:
        bits.append("GRAPH GENERATION MISMATCH")
    elif not status_graph_known or not graph_id_known:
        bits.append("GRAPH GENERATION UNKNOWN")
    elif isinstance(snap, dict) and isinstance(snap.get("complete"), bool):
        bits.append("graph complete" if snap["complete"]
                    else "GRAPH PARTIAL")
    else:
        bits.append("GRAPH UNKNOWN")
    red = st.get("redactions")
    if isinstance(red, dict) and all(
            isinstance(value, int) and not isinstance(value, bool)
            and value >= 0 for value in red.values()):
        if red:
            bits.append(f"{sum(red.values())} span(s) redacted at ingest")
    elif red is not None:
        bits.append("redactions unknown")
    bits.append("keyword-only recall" if keyword_only
                else "semantic recall")
    if recall_degraded:
        bits.append(recall_degraded)
    if reinforcement_refused:
        # Returning 0 on a refused touch is only honest if the answer
        # itself carries the fact. stderr can be discarded; this line
        # travels with the memory.
        bits.append("not reinforced: touch queue unavailable")
    bits.append("absence of recall ≠ evidence of absence")
    return "boundary: " + " · ".join(bits)


def cmd_ask(q, touch=True):
    """Semantic recall uses origin-weighted hybrid-query ordering by measured
    default. The optional retrieval.associative_rerank configuration seeds
    graph PPR from hybrid-query hits and blends it with usage salience."""
    import siamind
    r = _gbrain_query(q, json_out=True)
    try:
        if r.returncode != 0:
            raise RuntimeError("memory engine query did not complete")
        i = r.stdout.index("[")
        try:
            results = sialib._strict_json_loads(r.stdout[i:])
        except (UnicodeError, ValueError, RecursionError) as exc:
            raise ValueError("memory engine JSON is malformed") from exc
        if not isinstance(results, list):
            raise ValueError("memory engine result is not a list")
        hybrid_hits, seen, meta, origins = [], set(), {}, {}
        for res in results:
            if not isinstance(res, dict):
                raise ValueError("memory engine result row is not an object")
            slug = res.get("slug")
            if not isinstance(slug, str) or not _canonical_slug(slug):
                raise ValueError("memory engine returned an invalid slug")
            if slug in seen:
                continue
            try:
                score = float(res.get("score") or 0)
            except (TypeError, ValueError, OverflowError) as exc:
                raise ValueError("memory engine returned an invalid score") \
                    from exc
            if not math.isfinite(score):
                raise ValueError("memory engine returned a non-finite score")
            seen.add(slug)
            hybrid_hits.append((slug, score))
            meta[slug] = res
            origins[slug] = sialib.corpus_origin(
                slug, res.get("type", ""))
        if not hybrid_hits:
            print("(no matches — try other words or `sia recall <slug>`)")
            print(_health_footer(keyword_only="keyword-only"
                                 in (r.stderr or "")))
            return 0
        recall_degraded = ""
        if not sialib.associative_rerank_enabled():
            # Off by measurement (see sialib.associative_rerank_enabled):
            # Origin-weighted hybrid-query ordering, labeled in the footer.
            ranked = siamind.ppr_rerank(
                None, hybrid_hits, origins=origins)
            recall_degraded = ("associative rerank off by measured default; "
                              "retrieval.associative_rerank enables it")
        else:
            try:
                graph = sialib._require_recoverable_graph_snapshot(
                    sialib.read_json(sialib.GRAPH_PATH, None))
                mind = siamind.load_mind()
                ranked = siamind.ppr_rerank(
                    graph, hybrid_hits, mind=mind, origins=origins,
                    require_associative=True)
            except Exception:
                ranked = siamind.ppr_rerank(
                    None, hybrid_hits, origins=origins)
                recall_degraded = "associative rerank unavailable; origin-safe fallback"
        for slug, score in ranked[:8]:
            m = meta.get(slug, {})
            oc = origins[slug]
            title = sialib.neutralize_unverified_jackal_recall(
                slug, m.get("title", ""))
            excerpt_source = sialib.neutralize_unverified_jackal_recall(
                slug, m.get("chunk_text", ""))
            if slug == "sia/cortex":
                excerpt_source = excerpt_source.replace(
                    sialib.BRAIN_METAPHOR_BOUNDARY, "").strip()
            excerpt = sialib.clip(excerpt_source, 104)
            print(f"[{score:.3f}] [{oc}] {slug} — "
                  f"{sialib.clip(title, 120)}")
            if slug == "sia/cortex":
                print(f"        {sialib.BRAIN_METAPHOR_BOUNDARY}")
            if excerpt:
                print(f"        {excerpt}")
        not_reinforced = False
        if touch:
            not_reinforced = not _reinforce(
                [s for s, _ in ranked[:5]], "user-ask")
        print()
        print(_health_footer(keyword_only="keyword-only"
                             in (r.stderr or ""),
                             recall_degraded=recall_degraded,
                             reinforcement_refused=not_reinforced))
        return 0
    except Exception as exc:
        print("SIA recall refused: origin-labeled result admission failed "
              f"({sialib.clip(exc, 120)})", file=sys.stderr)
        print(_health_footer(keyword_only="keyword-only"
                             in (r.stderr or ""),
                             recall_degraded="result admission refused"))
        return 1


_RECALL_TIMEOUT_SECONDS = 120


def _recall_binary_stdout():
    sink = getattr(sys.stdout, "buffer", None)
    if not callable(getattr(sink, "write", None)) \
            or not callable(getattr(sink, "flush", None)):
        raise RuntimeError("binary stdout is unavailable")
    return sink


def _new_delivery_request_id():
    import uuid
    return uuid.uuid4().hex


def _recall_completion_clock():
    import time
    return int(time.time())


def _source_recall(slug, touch, touch_result):
    import siacontrollerrecallcli
    try:
        siacontrollerrecallcli.recall_from_current_source(
            sialib.__dict__, subject=slug, timeout=_RECALL_TIMEOUT_SECONDS,
            request_id=_new_delivery_request_id(),
            binary_sink=_recall_binary_stdout(),
            clock=_recall_completion_clock)
    except siacontrollerrecallcli.ControllerRecallCliRefusal as exc:
        if isinstance(touch_result, dict):
            touch_result["reason"] = "source-recall-refused"
            touch_result["output_state"] = exc.output_state
        print("SIA recall refused: " + sialib.clip(exc.reason, 120)
              + " (output state " + exc.output_state + ")", file=sys.stderr)
        return 1
    except (OSError, RuntimeError, TypeError, ValueError, KeyError,
            AttributeError, OverflowError, RecursionError) as exc:
        if isinstance(touch_result, dict):
            touch_result["reason"] = "source-recall-refused"
            touch_result["output_state"] = "not-started"
        print("SIA recall refused: current-source-recall-unavailable "
              "(output state not-started; " + sialib.clip(exc, 120) + ")",
              file=sys.stderr)
        return 1
    if touch:
        if not _reinforce([slug], "user-recall"):
            if isinstance(touch_result, dict):
                touch_result["reason"] = "touch-queue-unavailable"
            return 0
        if isinstance(touch_result, dict):
            touch_result["queued"] = True
    return 0


def cmd_recall(slug, touch=True, touch_result=None):
    if isinstance(touch_result, dict):
        touch_result.clear()
        touch_result["queued"] = False
    if not _canonical_slug(slug):
        print("slug must be a canonical SIA corpus slug without traversal")
        return 2
    if not sialib.page_exists(slug):
        print(f"memory not found: {slug}")
        return 3
    if sialib.unverified_jackal_recall_page(slug):
        if isinstance(touch_result, dict):
            touch_result["reason"] = "unverified-jackal-page"
        print(f"[origin:{sialib.corpus_origin(slug)}] {slug}")
        print(sialib.UNVERIFIED_JACKAL_RECALL_NOTICE)
        return 0
    if sialib._controller_source_enabled():
        return _source_recall(slug, touch, touch_result)
    cortex = slug == "sia/cortex"
    r = _gbrain_read(["get", slug, "--source", "sia"])
    if r.returncode == 0:
        print(f"[origin:{sialib.corpus_origin(slug)}] {slug}")
        if cortex:
            print(sialib.BRAIN_METAPHOR_BOUNDARY)
    rendered_stdout = sialib.strip_controls(r.stdout)
    if cortex:
        rendered_stdout = rendered_stdout.replace(
            sialib.BRAIN_METAPHOR_BOUNDARY, "")
    sys.stdout.write(rendered_stdout)
    sys.stderr.write(sialib.strip_controls(r.stderr))
    if r.returncode == 0 and touch:
        if not _reinforce([slug], "user-recall"):
            # Same contract as cmd_ask: the page is already on stdout, so
            # the read succeeded. Record the reason instead of failing, and
            # let a caller whose purpose IS reinforcement decide (rehearse).
            if isinstance(touch_result, dict):
                touch_result["reason"] = "touch-queue-unavailable"
            return r.returncode
        if isinstance(touch_result, dict):
            touch_result["queued"] = True
    return r.returncode


def _stamp(ts):
    import datetime
    if not ts:
        return "never"
    return datetime.datetime.fromtimestamp(
        float(ts), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_memory(argv):
    import siamind
    if argv and argv[0] in ("--pin", "--unpin"):
        if len(argv) != 2:
            print(f"usage: sia memory {argv[0]} <slug>")
            return 2
        if not _canonical_slug(argv[1]):
            print("slug must be a canonical SIA corpus slug without traversal")
            return 2
        pinned = argv[0] == "--pin"
        if pinned and not _existing_corpus_page(argv[1]):
            print(f"no canonical corpus page for {argv[1]} — "
                  "pins apply only to existing memories")
            return 1
        if not siamind.queue_pin(argv[1], pinned=pinned):
            print("could not queue pin change")
            return 1
        print(f"queued {'pin' if pinned else 'unpin'} for {argv[1]} — "
              "the brainstem applies it on the next pulse")
        return 0
    if argv and argv[0] == "--efficacy":
        # ROADMAP P1.3: descriptive rehearsal-efficacy report. Runs the
        # hybrid-query probes once and partitions by SM-2 review state; the
        # interpretation rule is fixed in ROADMAP.md before the data spoke.
        import siabench
        try:
            report = siabench.rehearsal_efficacy()
        except siabench.BenchmarkRefusal as exc:
            print(f"efficacy refused: {exc}")
            return 2
        if not report:
            print("no eligible probes — corpus has no probe-covered organs")
            return 1
        print("rehearsal efficacy — descriptive, tiny populations, "
              "slug-proximity heuristic:")
        for bucket in ("rehearsed", "unrehearsed"):
            row = report[bucket]
            rate = ("n/a" if row["hit_rate"] is None
                    else f"{row['hit_rate']:.3f}")
            print(f"  {bucket:12} probes {row['probes']:3} · "
                  f"hits {row['hits']:3} · hit-rate {rate}")
        print(f"  reviewed pages {report['reviewed_page_count']} · "
              f"probe count {report['probe_count']}")
        for line in report["non_claims"]:
            print(f"  · {line}")
        return 0
    mind = siamind.load_mind()
    now = __import__("time").time()
    if argv and not argv[0].startswith("--"):
        slug = argv[0]
        if not _canonical_slug(slug):
            print("slug must be a canonical SIA corpus slug without traversal")
            return 2
        node = mind.get("nodes", {}).get(slug)
        if node is None:
            print(f"no stability state for {slug} (pin it to begin tracking)")
            return 1
        r = siamind.retention(node, now)
        print(f"{slug}\n  stability {node.get('s', 0):.3f} days · "
              f"retention {r:.6f} · last touch {_stamp(node.get('last_touch'))}")
        print(f"  safety priority {node.get('arousal', 0):.2f} · "
              f"pins {','.join(node.get('pins', [])) or 'none'}")
        review = node.get("review")
        if review:
            print(f"  SM-2 q={review.get('last_quality')} · "
                  f"EF {review.get('ef', 0):.3f} · reps {review.get('reps', 0)} "
                  f"· interval {review.get('interval_days', 0)}d · "
                  f"due {_stamp(review.get('due_at'))}")
        else:
            print("  SM-2 not eligible (needs safety priority ≥ 0.7 or an operator pin)")
        return 0
    summary = siamind.memory_summary(mind, now)
    print(f"memory state v{summary['v']} · {summary['nodes']} nodes · "
          f"{summary['edges']} co-return edges")
    print(f"stability lens · {summary['active_edges']} active · "
          f"{summary['demoted_edges']} demoted below R="
          f"{summary['threshold']} · no evidence deleted")
    print(f"SM-2 · {summary['due']} due · {summary['eligible']} eligible · "
          f"{summary['pinned']} pinned")
    due = []
    for slug, node in mind.get("nodes", {}).items():
        review = node.get("review")
        if review and float(review.get("due_at", now)) <= now and \
                siamind.is_important(node):
            due.append((float(review.get("due_at", 0)), slug,
                        review.get("last_quality")))
    for _, slug, quality in sorted(due):
        print(f"  due  {slug} (last q={quality})")
    return 0


def cmd_rehearse(argv):
    if not argv:
        return cmd_memory(["--due"])
    touch_result = {}
    rc = cmd_recall(argv[0], touch_result=touch_result)
    if rc == 0 and touch_result.get("queued"):
        print(f"\nrehearsal touch queued for {argv[0]}; the next scheduled run "
              "grades this deterministic user recall as q=5")
    elif rc == 0 and touch_result.get("reason") == "unverified-jackal-page":
        print("\nrehearsal touch not queued: an unverified JACKAL page is "
              "recall-visible but intentionally excluded from reinforcement")
    elif rc == 0 and touch_result.get("reason") == "touch-queue-unavailable":
        # `recall` reports 0 because the page was delivered. `rehearse` is
        # not a read verb: its whole product is the queued touch that the
        # next scheduled run grades as q=5. With no touch queued it accomplished
        # nothing, so it refuses rather than reporting a rehearsal that
        # never happened.
        return 1
    return rc


def cmd_think():
    _print_live_summary()
    store = sialib.load_thoughts()
    for t in store["thoughts"][-15:]:
        mark = "!" if t.get("urgent") else "·"
        origin = t.get("origin")
        if origin not in {"evidence", "derived", "model"}:
            origin = "legacy-unlabeled"
        print(f"{sialib.strip_controls(t['ts'])} {mark} "
              f"[origin:{origin}] [{sialib.clip(t['kind'], 30)}] "
              f"{sialib.inert_summary(t['text'])}")
    if not store["thoughts"]:
        print("No generated entries yet.")
    return 0


def cmd_graph():
    try:
        g = sialib.read_state_json(
            sialib.GRAPH_PATH, None, "resident graph", expected_type=dict)
    except RuntimeError:
        print("Graph snapshot is invalid; graph claims are unavailable")
        return 1
    if g is None:
        print("No graph snapshot yet.")
        return 1
    if sialib._recoverable_graph_snapshot(g) is None:
        print("Graph snapshot is invalid; graph claims are unavailable")
        return 1
    by_type = {}
    for n in g["nodes"]:
        by_type[n["t"]] = by_type.get(n["t"], 0) + 1
    print(f"graph snapshot {g['ts']} — {len(g['nodes'])} nodes shown of "
          f"{g.get('pages_total', '?')} pages, {len(g['edges'])} edges")
    for t, c in sorted(by_type.items(), key=lambda kv: -kv[1]):
        print(f"  {c:4d} {t}")
    return 0


def _print_owner_refusal():
    print("sia-brainstem or another manual operation owns the local memory runtime. "
          "Stop the resident service before running a manual pulse or dream: "
          "systemctl --user stop sia-brainstem")


def cmd_pulse():
    try:
        with sialib.brainstem_owner():
            return _cmd_pulse_owned()
    except sialib.OwnerBusy:
        _print_owner_refusal()
        return 1
    except ValueError as exc:
        print(f"manual pulse refused: {exc}")
        return 1


def cmd_repair_cortex_boundary(args):
    if len(args) != len(set(args)) or any(
            item not in {"--json", "--regenerate-legacy-graph"} for item in args):
        print("usage: sia repair-cortex-boundary [--regenerate-legacy-graph] [--json]")
        return 2
    import siacortexrepair
    try:
        result = siacortexrepair.repair_cortex_boundary(
            sialib, regenerate_legacy_graph="--regenerate-legacy-graph" in args)
    except sialib.OwnerBusy:
        result = siacortexrepair.refusal_result(
            siacortexrepair.RepairRefusal("runtime-owned"))
    except (OSError, RuntimeError, ValueError, OverflowError) as exc:
        # Only the module's closed typed reason codes cross this boundary;
        # arbitrary corpus, Git, keeper, or exception text never does.
        result = siacortexrepair.refusal_result(exc)
    encoded = json.dumps(result, sort_keys=True, separators=(",", ":"),
                         ensure_ascii=False, allow_nan=False)
    if len(encoded.encode("utf-8")) > sialib.MAX_CONFIG_BYTES:
        print("Cortex repair refused: result-output-bound")
        return 1
    if "--json" in args:
        print(encoded)
    else:
        print("Cortex boundary: " + result["status"] + ".")
        if result["status"] == "refused":
            print("Reason: " + result["reason_code"] + " (" + result["phase"] + ").")
        for nonclaim in result["non_claims"]:
            print(nonclaim)
    return 1 if result["status"] == "refused" else 0


def _memo_pulse_sequence(memo):
    if not isinstance(memo, dict):
        raise ValueError("brainstem memo must be an object")
    seq = memo.get("pulse_seq", 0)
    if isinstance(seq, bool) or not isinstance(seq, int) or seq < 0:
        raise ValueError("brainstem pulse sequence is invalid")
    if seq >= sialib.MAX_JSON_SAFE_INTEGER:
        raise ValueError("brainstem pulse sequence is exhausted")
    if not isinstance(memo.get("sync_needed", False), bool):
        raise ValueError("brainstem sync-needed state is invalid")
    return seq


def _cmd_pulse_owned():
    # The corpus lease spans both the whole-memo sequence reservation and the
    # pulse cycle. This preserves a concurrent manual writer's sync_needed bit
    # and prevents an old publication callback from rolling pulse_seq back.
    with sialib.corpus_owner():
        memo = sialib.load_memo()
        source_cycle = (sialib._controller_source_present(memo)
                        or sialib._controller_source_enabled())
        if source_cycle:
            st = sialib._run_controller_source_cycle()
            import sialiveview
            sialiveview.publish_cache(sialib.__dict__)
        else:
            sialib._settle_pending_brainstem_failure_publication(memo)
            sialib._require_status_memo_fields(memo)
            cursors = sialib.load_cursors()
            sialib._recover_notify_baseline_attempt(memo, cursors)
            source_marker = sialib._pending_source_replay_marker(memo)
            if source_marker is not None:
                sialib._authorize_pending_source_replay(
                    source_marker, cursors)
            sialib._pending_pulse_marker(memo)
            sialib._pending_pulse_status_effects(memo)
            current = _memo_pulse_sequence(memo)
            admitted_status = sialib._require_status_sequence_not_ahead(current)
            seq = current + 1
            # Durable allocation comes before effects: interruption can create
            # a gap, never reuse the same pulse sequence.
            memo["pulse_seq"] = seq
            sialib._write_memo(memo)
            st = sialib._pulse_transaction(
                seq, admitted_status=admitted_status)
    if st.get("graph_publication_id"):
        rendered = {key: st[key] for key in
                    ("state", "events_pulse", "pages", "graph_nodes",
                     "graph_edges", "integrity")}
    else:
        rendered = {key: st[key] for key in
                    ("state", "events_pulse", "integrity")}
        rendered["graph"] = "unavailable"
        if st.get("errors"):
            rendered["errors"] = st["errors"]
    print(json.dumps(rendered, indent=1))
    return 0


def cmd_dream():
    try:
        with sialib.brainstem_owner():
            return _cmd_dream_owned()
    except sialib.OwnerBusy:
        _print_owner_refusal()
        return 1


def _cmd_dream_owned():
    memo = sialib.load_memo()
    if (sialib._controller_source_present(memo)
            or sialib._controller_source_enabled()):
        raise RuntimeError(
            "legacy dream refused while controller-source authority is active")
    rep = sialib.dream()
    print(json.dumps(rep, indent=1) if rep else "weekly maintenance failed")
    return 0 if rep else 1


def _gbrain_pin_check(pin_paths=None):
    """Compare the runtime's exposed version with SIA's expected pin.

    ``gbrain --version`` does not expose a source commit, so this check never
    claims that the installed executable's commit was verified.
    """
    pins = pin_paths
    if pins is None:
        pins = []
        for candidate in (
                sialib.os.path.expanduser(
                    "~/.local/share/sia/GBRAIN_PIN"),
                sialib.os.path.expanduser(
                    "~/.config/omarchy/plugins/khephri.sia/GBRAIN_PIN")):
            try:
                if stat.S_ISREG(os.lstat(candidate).st_mode):
                    pins.append(candidate)
                    break
            except OSError:
                continue
    if not pins:
        return
    try:
        pin = {}
        path = pins[0]
        fd = sialib._open_source_nofollow(path, os.O_RDONLY)
        with sialib.siaqueue.regular_file_stream(
                fd, label="gbrain pin", error_type=OSError) as stream:
            before = os.fstat(stream.fileno())
            if not stat.S_ISREG(before.st_mode) \
                    or before.st_uid != os.geteuid() \
                    or before.st_size > sialib.MAX_CONFIG_BYTES:
                return
            raw = stream.read(sialib.MAX_CONFIG_BYTES + 1)
            after = os.fstat(stream.fileno())
            current = sialib._source_path_identity(path, os.O_RDONLY)
        observed = (before.st_dev, before.st_ino, before.st_size,
                    before.st_mtime_ns, before.st_ctime_ns)
        finished = (after.st_dev, after.st_ino, after.st_size,
                    after.st_mtime_ns, after.st_ctime_ns)
        target = (current.st_dev, current.st_ino, current.st_size,
                  current.st_mtime_ns, current.st_ctime_ns)
        if observed != finished or finished != target \
                or len(raw) > sialib.MAX_CONFIG_BYTES:
            return
        for raw_line in raw.decode("utf-8", errors="strict").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            pin[key.strip()] = value.strip()
        want = pin.get("commit", "").strip()
    except (OSError, UnicodeError):
        return
    ver = ""
    try:
        r = sialib._run_bounded_text_process(
            [sialib.GBRAIN, "--version"], env=sialib.GBRAIN_ENV,
            timeout=sialib.JOURNAL_TIMEOUT_SECONDS, cwd=None,
            label="gbrain version",
            output_limit=sialib.MAX_GBRAIN_OUTPUT_BYTES)
        reported = (r.stdout or r.stderr or "").strip().splitlines()
        ver = reported[-1] if reported else ""
    except Exception:
        pass
    exp = pin.get("version", "").strip()
    commit_note = (f"; expected source commit {want} is not self-verifiable "
                   "from gbrain --version" if want else "")
    if not ver:
        expectation = f"; expected version {exp}" if exp else ""
        print(f"  gbrain   runtime version unavailable{expectation}"
              f"{commit_note}")
    elif exp and exp not in ver:
        print(f"  gbrain   VERSION DRIFT — running {ver!r}, expected {exp}"
              f"{commit_note}; re-run sia bench + sia judge-audit")
    else:
        version_note = f"; version matches expected pin {exp}" if exp else ""
        print(f"  gbrain   {ver}{version_note}{commit_note}")


_VERIFY_BASIS_KEYS = frozenset({
    "graph_publication_id", "ledger_head", "ledger_seq",
    "status_publication_id",
})
_VERIFY_BASIS_RECEIPT = "SIA-VERIFIED-BASIS "


def _parse_verify_basis(argv):
    """Parse the cockpit's closed generation claim, or ordinary CLI mode."""
    if not argv:
        return None
    if len(argv) != 2 or argv[0] != "--expect-basis" \
            or not isinstance(argv[1], str):
        raise ValueError("usage: sia verify [--expect-basis JSON]")
    try:
        encoded = argv[1].encode("utf-8")
    except UnicodeError as exc:
        raise ValueError("verification basis is malformed") from exc
    if len(encoded) > sialib.MAX_CONFIG_BYTES:
        raise ValueError("verification basis exceeds its byte bound")
    try:
        basis = sialib._strict_json_loads(argv[1])
    except (UnicodeError, ValueError, RecursionError) as exc:
        raise ValueError("verification basis is malformed") from exc
    if not isinstance(basis, dict) or set(basis) != _VERIFY_BASIS_KEYS:
        raise ValueError("verification basis has the wrong shape")
    for key in ("graph_publication_id", "status_publication_id"):
        if not sialib._status_publication_id(basis[key]):
            raise ValueError("verification publication identity is invalid")
    sequence = basis["ledger_seq"]
    if isinstance(sequence, bool) or not isinstance(sequence, int) \
            or not 0 < sequence <= sialib.MAX_JSON_SAFE_INTEGER:
        raise ValueError("verification ledger sequence is invalid")
    head = basis["ledger_head"]
    if not isinstance(head, str) \
            or re.fullmatch(r"[0-9a-f]{12}", head) is None:
        raise ValueError("verification ledger head is invalid")
    return {key: basis[key] for key in sorted(_VERIFY_BASIS_KEYS)}


def _valid_verify_graph_snapshot(graph, status):
    """Recognize the exact graph generation the cockpit is allowed to show."""
    generation = sialib._recoverable_graph_snapshot(graph)
    return generation is not None and isinstance(status, dict) \
        and status.get("graph_publication_id") \
            == generation["publication_id"] \
        and status.get("graph_nodes") == generation["nodes"] \
        and status.get("graph_edges") == generation["edges"] \
        and status.get("pages") == generation["pages"]


def _current_verify_basis():
    """Read one live status/graph/ledger generation under corpus_owner()."""
    status = sialib.read_json(sialib.STATUS_PATH, None)
    graph = sialib.read_json(sialib.GRAPH_PATH, None)
    if sialib._recoverable_status_integrity(status) is None \
            or not _valid_verify_graph_snapshot(graph, status):
        raise RuntimeError("resident snapshots are not valid")
    status_publication = status.get("publication_id")
    graph_publication = graph.get("publication_id")
    if not sialib._status_publication_id(status_publication) \
            or not sialib._status_publication_id(graph_publication) \
            or status.get("graph_publication_id") != graph_publication:
        raise RuntimeError("resident snapshots are not one generation")
    ledger = status.get("ledger")
    live_sequence, live_head = sialib.ledger_head()
    if isinstance(live_sequence, bool) \
            or not isinstance(live_sequence, int) \
            or not 0 < live_sequence <= sialib.MAX_JSON_SAFE_INTEGER \
            or not isinstance(live_head, str) \
            or re.fullmatch(r"[0-9a-f]{64}", live_head) is None:
        raise RuntimeError("resident ledger head is unavailable")
    if not isinstance(ledger, dict) \
            or ledger.get("seq") != live_sequence \
            or ledger.get("head") != live_head[:12]:
        raise RuntimeError("displayed ledger generation is no longer live")
    return {
        "graph_publication_id": graph_publication,
        "ledger_head": ledger["head"],
        "ledger_seq": ledger["seq"],
        "status_publication_id": status_publication,
    }


def _verify_basis_json(basis):
    return json.dumps(basis, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False)


def cmd_verify(argv=()):
    try:
        expected = _parse_verify_basis(argv)
    except ValueError as exc:
        print(f"verification refused: {exc}")
        return 2

    # Interactive CLI verification retains its historical report.  The
    # cockpit mode additionally pins the status, graph, and SIA-ledger head
    # under the corpus lease and reads them back after every verifier exits.
    owner = sialib.corpus_owner() if expected is not None \
        else contextlib.nullcontext()
    try:
        with owner:
            before = _current_verify_basis() if expected is not None else None
            if expected is not None and before != expected:
                raise RuntimeError(
                    "displayed snapshot generation is no longer live")
            chains = sialib.verify_chains()
            after = _current_verify_basis() if expected is not None else None
            if expected is not None and (after != before or after != expected):
                raise RuntimeError(
                    "snapshot generation changed during verification")
    except (OSError, RuntimeError, TypeError, ValueError) as exc:
        print(f"verification refused: {exc}")
        print("VERDICT: CHAINS INCOMPLETE")
        return 1

    incomplete = False
    for k, v in sorted(chains.items()):
        print(f"  {k:8s} {v}")
        incomplete |= v != "pass"
    _gbrain_pin_check()
    print("VERDICT: " + ("CHAINS INCOMPLETE" if incomplete
                         else "all registered chains verified"))
    if expected is not None and not incomplete:
        # The UI requires this exact final line.  That readback prevents an
        # older CLI which ignores --expect-basis from authorizing a claim.
        print(_VERIFY_BASIS_RECEIPT + _verify_basis_json(expected))
    return 1 if incomplete else 0


def _judge():
    import siatakes
    return siatakes


def _claim_status_snapshot():
    try:
        status = sialib.read_state_json(
            sialib.STATUS_PATH, None, "resident status", expected_type=dict)
    except RuntimeError as exc:
        raise ValueError("resident status snapshot is invalid") from exc
    if status is not None \
            and sialib._recoverable_status_integrity(status) is None:
        raise ValueError("resident status snapshot is invalid")
    return status


def cmd_ponder(question):
    """Model-assisted synthesis. The model NEVER inherits deterministic
    authority: output is stored as a labeled synthesis page, and the entry
    announcing it names the model."""
    q = question or ("What patterns, risks, or connections do you see in "
                     "this machine's recent activity that a rule would miss?")
    store = sialib.load_thoughts()
    recent = "\n".join(
        f"- [origin:{t.get('origin', 'legacy-unlabeled')}] "
        f"[{t['kind']}] {t['ts']} "
        f"{sialib.neutralize_unverified_jackal_output(t['text'])}"
        for t in store["thoughts"][-20:])
    try:
        st = _claim_status_snapshot()
    except ValueError as exc:
        print(f"ponder refused: {exc}")
        return 1
    if st is None:
        organs = "(unknown — no status snapshot)"
        chains = "(unknown — no status snapshot)"
    else:
        organs = ", ".join(f"{k}:{v.get('today', 0)}"
                           for k, v in sorted(st["organs"].items())) \
            or "(none)"
        chains = ", ".join(f"{k}:{v}" for k, v in sorted(
            st["integrity"]["chains"].items())) or "(none)"
    r = _gbrain_read(["query", q, "--source", "sia"], timeout=180)
    recall = sialib.neutralize_unverified_jackal_output(
        r.stdout or "")[:5000]
    prompt = f"""You are SIA, a local machine-memory interface on an Omarchy Linux
machine. "Omarchy Brain" is only the product metaphor, not a biological or
scientific claim. Below is genuine material from the local corpus: recent
deterministic generated entries, today's per-source event counts, signed-chain
verification results, and memories recalled for the question.

QUESTION: {q}

RECENT DETERMINISTIC ENTRIES:
{recent or '(none)'}

TODAY'S SOURCE ACTIVITY: {organs}
EVIDENCE CHAINS: {chains}

RECALLED MEMORIES (semantic search results, [score] slug -- excerpt):
{recall or '(none)'}

Write a reflection of at most 250 words: 2-4 numbered insights grounded ONLY
in the material above, each naming the memory slug or entry it rests on.
Never invent events. Where the material is insufficient, say so plainly.

Then, ONLY if something above is genuinely testable against this machine's
future evidence, add at most 2 predictions, one per line, in EXACTLY:
TAKE: confidence=0.NN deadline=YYYY-MM-DD domain=<one-word> claim=<one falsifiable sentence>
Omit TAKE lines entirely if nothing is worth predicting."""
    st_mod = _judge()
    label = st_mod.judge_model_label()
    print(f"pondering with {label} via the configured judge backend…")
    out, err = st_mod._judge_run(prompt)
    if not out:
        print("ponder failed:", (err or "")[-300:])
        return 1
    out = sialib.bounded_model_output(out)
    stored_out = sialib.inert_model_block(out)
    stored_question = sialib.inert_summary(q)
    now = sialib.utcnow()
    with sialib.corpus_owner(), sialib.corpus_publication():
        base = f"synthesis/{now.strftime('%Y-%m-%d-%H%M')}-ponder"
        slug = base
        suffix = 2
        collision_checks = 0
        while sialib.page_exists(slug):
            if collision_checks >= sialib.MAX_THOUGHT_RECOVERY_RECORDS:
                print("ponder refused: synthesis path collision search "
                      "reached its bound")
                return 1
            collision_checks += 1
            slug = f"{base}-{suffix}"
            suffix += 1
        sialib.write_page(slug,
            ["type: synthesis",
             sialib.fm_title(sialib.clip(q, 70)),
             "tags: [synthesis, ponder]",
             "origin: model",
             f"date: {now.strftime('%Y-%m-%d')}"],
            f"# ponder · {now.strftime('%Y-%m-%d %H:%MZ')}\n\n"
            f"**Model-assisted synthesis — {label}, via the configured "
            f"judge backend. NOT a deterministic entry; verify claims against "
            f"the cited memories.**\n\n"
            f"**Question:** {stored_question}\n\n"
            f"<pre class=\"sia-model-output\">{stored_out}</pre>\n\n"
            f"[[sia/cortex]]\n")
    first = out.splitlines()[0].strip() if out.splitlines() else ""
    ponder_thought = {"kind": "ponder", "origin": "model",
                      "text": f"Model-assisted analysis via {label}: "
                              f"{sialib.clip(first, 120)} (full synthesis in "
                              f"⟦{slug}⟧)",
                      "links": [slug, "sia/cortex"], "urgent": False}
    # the model may PROPOSE predictions; only the operator commits them.
    # (a model that mints the takes it will later help grade is too neat
    # a loop — proposals wait in a queue for `sia take --accept`)
    import re as _re
    import siatakes as _st
    props = []
    for tm in _re.finditer(
            r"^TAKE:\s*confidence=([0-9.]+)\s+deadline=(\S+)\s+"
            r"domain=(\S+)\s+claim=(.+)$", out, _re.M):
        try:
            props.append(_st.validate_proposal({
                "confidence": min(0.99, max(0.01, float(tm.group(1)))),
                "deadline": tm.group(2)[:10],
                "domain": tm.group(3).lower(),
                "claim": sialib.inert_summary(
                    " ".join(tm.group(4).split())[:300]),
                "source": slug, "proposed": label}, require_future=True))
            if len(props) >= 2:
                break
        except Exception:
            pass
    if props:
        _st.locked_proposals(sialib.STATE, lambda cur: cur + props)
    sialib.append_thought_inbox(ponder_thought)
    if props:
        sialib.append_thought_inbox({
            "kind": "take", "origin": "model",
            "text": f"{label} proposed {len(props)} prediction(s) — review "
                    f"with `sia takes`, commit with `sia take --accept`.",
            "links": [slug], "urgent": False})
    print(f"\n{sialib.strip_controls(out)}\n\nsaved → {slug} "
          "(generated entry publishes on the next pulse)")
    for p2 in props:
        print(f"proposed take [{p2['proposal_id']}] "
              f"(conf {p2['confidence']:.2f}, due "
              f"{p2['deadline']}, {sialib.clip(p2['domain'], 30)}): "
              f"{sialib.clip(p2['claim'], 90)}")
    if props:
        print("commit with: sia take --accept <proposal-id>|all   (proposals are "
              "not memories until you do)")
    return 0


def cmd_take(argv):
    import siatakes
    pfile = sialib.os.path.join(sialib.STATE, "take-proposals.json")
    if argv and argv[0] == "--accept":
        which = argv[1] if len(argv) > 1 else "all"
        committed = []

        # accept under the same flock every proposal writer holds, so a
        # daemon auto-proposal landing mid-accept is neither lost nor
        # resurrected
        def _accept(pending):
            if not pending:
                return pending
            if which == "all":
                idxs = set(range(len(pending)))
            else:
                if not re.fullmatch(r"[0-9a-f]{6,20}", which):
                    raise ValueError(
                        "proposal selector must be an id prefix or all")
                matches = [i for i, row in enumerate(pending)
                           if row["proposal_id"].startswith(which)]
                if len(matches) != 1:
                    raise ValueError(
                        "proposal id prefix is absent or ambiguous")
                idxs = {matches[0]}
            # Validate every selected record before the first corpus write.
            selected_rows = {i: siatakes.validate_proposal(
                                 pending[i], require_future=True)
                             for i in idxs}
            remaining = []
            for i, p in enumerate(pending):
                if i in idxs:
                    p = selected_rows[i]
                    committed.append(siatakes.create_take(
                        p["claim"], confidence=p["confidence"],
                        deadline=p["deadline"], domain=p["domain"],
                        holder="sia",
                        links=[p.get("source", "sia/cortex")],
                        proposal_id=p["proposal_id"],
                        before_publish=before_publish))
                else:
                    remaining.append(p)
            return remaining

        try:
            with sialib.corpus_owner(), \
                    sialib.corpus_publication() as before_publish:
                siatakes.locked_proposals(sialib.STATE, _accept)
        except (OSError, TypeError, ValueError) as exc:
            print(f"proposal acceptance refused: {exc}")
            return 2
        if not committed:
            print("no pending proposals")
            return 0
        for meta in committed:
            print(f"committed {meta['id']} (conf "
                  f"{meta['confidence']:.2f}, due {meta['deadline']}): "
                  f"{meta['claim'][:80]}")
        return 0
    claim, conf, by, domain = [], 0.7, None, "general"
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            # POSIX end-of-options. The guard below cannot tell a typo'd
            # flag from a real claim that opens with a minus sign, so it
            # refuses both — which left an honest take like
            # "-1 regressions will land by March" permanently
            # unregisterable. "--" is the caller saying "the rest is text".
            # Only the first one terminates; any later "--" is claim text.
            claim.extend(argv[i + 1:])
            break
        if a == "--confidence" and i + 1 < len(argv):
            conf = argv[i + 1]; i += 2
        elif a == "--by" and i + 1 < len(argv):
            by = argv[i + 1]; i += 2
        elif a == "--domain" and i + 1 < len(argv):
            domain = argv[i + 1].lower(); i += 2
        elif a.startswith("-"):
            # An option-shaped token is never claim text. Before this guard,
            # `sia take --help` registered a take whose claim was "--help" —
            # a silently misattributed commitment instead of a usage message.
            print("usage: sia take \"claim\" [--confidence 0.7] "
                  "[--by YYYY-MM-DD] [--domain d]")
            print("       sia take [options] -- <claim beginning with ->")
            print(f"take refused: unrecognized option {a!r}; "
                  "nothing was registered")
            return 2
        else:
            claim.append(a); i += 1
    if not claim:
        print("usage: sia take \"claim\" [--confidence 0.7] "
              "[--by YYYY-MM-DD] [--domain d]")
        print("       sia take [options] -- <claim beginning with ->")
        return 2
    try:
        with sialib.corpus_owner(), \
                sialib.corpus_publication() as before_publish:
            meta = siatakes.create_take(" ".join(claim), confidence=conf,
                                        deadline=by, domain=domain,
                                        holder="user",
                                        before_publish=before_publish)
    except (TypeError, ValueError) as exc:
        print(f"take refused: {exc}")
        return 2
    print(f"take {meta['id']} registered (conf {meta['confidence']:.2f}, "
          f"due {meta['deadline']}, domain {meta['domain']}).\n"
          f"It joins the local corpus on the next pulse; grading happens when due.")
    return 0


def cmd_takes(argv=()):
    import siatakes
    limit = getattr(siatakes, "DEFAULT_HISTORY_PAGE_LIMIT", 64)
    cursor = None
    i = 0
    while i < len(argv):
        if argv[i] == "--limit" and i + 1 < len(argv):
            try:
                limit = int(argv[i + 1])
            except ValueError:
                print("takes refused: --limit must be an integer")
                return 2
            i += 2
        elif argv[i] == "--cursor" and i + 1 < len(argv):
            cursor = argv[i + 1]
            i += 2
        else:
            print("usage: sia takes [--limit N] [--cursor CURSOR]")
            return 2
    try:
        pending = siatakes.read_proposals(sialib.STATE)
    except (OSError, ValueError) as exc:
        print(f"proposal queue refused: {exc}")
        pending = []
    for p in pending:
        print(f"? [{p['proposal_id']}] PROPOSED by "
              f"{sialib.clip(p.get('proposed', 'model'), 40)} "
              f"(conf {p['confidence']:.2f}, due {p['deadline']}, "
              f"{sialib.clip(p['domain'], 30)}): "
              f"{sialib.clip(p['claim'], 90)}")
    if pending:
        print("   commit with: sia take --accept <proposal-id>|all\n")
    try:
        if hasattr(siatakes, "list_takes_page"):
            page = siatakes.list_takes_page(limit=limit, cursor=cursor)
            takes = page["items"]
        else:
            takes = siatakes.load_takes()
            page = {"items": takes, "next_cursor": None,
                    "legacy_debt": False}
    except (OSError, ValueError) as exc:
        print(f"take history refused: {exc}")
        return 2
    if not takes:
        if page["legacy_debt"]:
            print("Take history baseline is still settling; run a pulse and "
                  "retry this page.")
        else:
            print("No predictions yet. Make one: sia take \"...\" "
                  "— or let ponder propose them.")
        return 0
    today = sialib.utcnow().strftime("%Y-%m-%d")
    for t in takes:
        if t.get("status") == "invalid-record":
            print(f"? invalid take record {sialib.clip(t.get('slug', '?'), 80)} — "
                  f"{sialib.clip(t.get('invalid_reason', 'malformed metadata'), 120)}")
            continue
        mark = {"open": "○", "resolved-true": "✓", "resolved-false": "✗",
                "unresolvable": "–"}.get(t.get("status"), "?")
        due = t.get("deadline", "?")
        deadline_blocked = (isinstance(t.get("legacy_v1"), dict)
                            and t["legacy_v1"].get("deadline_state")
                            == "invalid-open-blocked")
        if deadline_blocked:
            original = sialib.inert_summary(
                t["legacy_v1"].get("original_deadline", "invalid"))
            duestr = (f"legacy deadline {original} is not a calendar date "
                      "(grading blocked)")
        else:
            duestr = f"due {due}" + (
                " (DUE)" if t.get("status") == "open" and due <= today
                else "")
        brier = (f" Brier {t['brier']}" if t.get("brier") is not None
                 else "")
        print(f"{mark} {t['id']}  "
              f"[{sialib.clip(t.get('holder','?'), 30)}·"
              f"{sialib.clip(t.get('domain','?'), 30)}] "
              f"conf {t.get('confidence',0):.2f} "
              f"{duestr}{brier}\n    {sialib.inert_summary(t.get('claim',''))}")
    try:
        s = siatakes.summary()
    except TypeError:
        s = siatakes.summary(takes)
    print(f"\n{s['open']} open ({s['due']} due) · {s['resolved']} resolved"
          + (f" · mean Brier {s['brier']}" if s["brier"] is not None else ""))
    if page["next_cursor"] is not None:
        print("next page: sia takes --cursor " + page["next_cursor"])
    if page["legacy_debt"]:
        print("history boundary: legacy baseline is incomplete; counts are "
              "bounded projections of settled rows only")
    return 0


def cmd_grade(tid=None):
    import siatakes
    try:
        with sialib.corpus_owner():
            memo = sialib.load_memo()
            with sialib.corpus_publication(memo) as before_publish:
                _history_recovered, history_errors = \
                    siatakes.recover_natural_history_transactions(
                        before_publish=before_publish)
                _recovered, recovery_errors = \
                    siatakes.recover_grade_transactions(
                        before_publish=before_publish)
            recovery_errors = history_errors + recovery_errors
            if not recovery_errors:
                sialib._settle_pending_publication(
                    memo, "publish recovered manual grades before judging")
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"grade recovery publication pending: {exc}")
        return 2
    if recovery_errors:
        print("grade recovery refused: " + json.dumps(recovery_errors))
        return 2
    try:
        target = siatakes.get_take(tid) if tid else None
    except ValueError:
        target = None
    try:
        if tid and target is None:
            target = next((row for row in siatakes.load_takes()
                           if row.get("id") == tid), None)
        targets = ([target] if target is not None
                   and target.get("status") == "open" else []) \
            if tid else siatakes.due_takes()
    except (OSError, ValueError) as exc:
        print(f"grade target refused: {exc}")
        return 2
    if not targets:
        print("nothing to grade" + (f" (no take {tid})" if tid else
                                    " — no open takes are due"))
        return 0

    def _persist_grade(row, verdict, justification, evidence_snapshots):
        with sialib.corpus_owner():
            memo = sialib.load_memo()
            with sialib.corpus_publication(memo) as before_publish:
                siatakes.commit_grade_transition(
                    row, verdict, justification, evidence_snapshots,
                    before_publish=before_publish)
            sialib._settle_pending_publication(
                memo, "publish manual grade before continuing")

    grade_failed = False
    for t in targets:
        print(f"grading {t['id']} “{sialib.clip(t['claim'], 70)}…” "
              "with the judge…")
        try:
            gt = siatakes.grade_take(t, persist=_persist_grade)
        except (OSError, RuntimeError, ValueError) as exc:
            print(f"  grade not completed or publication pending: {exc}")
            grade_failed = True
            break
        if not gt:
            print("  grading failed (judge unavailable)")
            continue
        mark = {"resolved-true": "TRUE", "resolved-false": "FALSE"}.get(
            gt["status"], "UNRESOLVABLE")
        brier = (f" · Brier {gt['brier']}" if gt["brier"] is not None
                 else "")
        print(f"  → {mark}{brier}")
        sialib.append_thought_inbox({
            "kind": "grade", "origin": "model",
            "text": f"Prediction graded: "
                    f"“{sialib.clip(gt['claim'], 80)}”: {mark}{brier}.",
            "links": [gt["slug"]], "urgent": False})
    if grade_failed:
        return 1
    for line in siatakes.calibration_text():
        print("calibration · " + line)
    return 0


def cmd_calibration(argv=None):
    import siatakes
    argv = list(argv or [])
    cursor = None
    if argv:
        if len(argv) != 2 or argv[0] != "--cursor" \
                or len(argv[1]) > siatakes.MAX_HISTORY_CURSOR_DIGITS \
                or re.fullmatch(r"[0-9]+", argv[1]) is None:
            print("usage: sia calibration [--cursor N]")
            return 2
        cursor = argv[1]
    lines = (siatakes.calibration_text()
             if cursor is None
             else siatakes.calibration_text(domain_cursor=cursor))
    if not lines:
        print("No takes yet — nothing to calibrate against.")
        return 0
    print("Descriptive calibration over the resolved-take population "
          "(sample sizes and domain breakdowns follow):")
    for line in lines:
        print("  " + line)
    return 0


def cmd_note(argv):
    """Agent reciprocity: any session may leave a labeled note for its
    successors. Notes are model-origin memories — recallable, graphed,
    and permanently marked as agent prose, never evidence. The caller only
    spools an immutable request; the brainstem alone materializes queued
    agent notes. Corpus transactions and PGLite operations use separate
    cross-process owner leases."""
    author, text = "agent", []
    i = 0
    while i < len(argv):
        if argv[i] == "--from":
            if i + 1 >= len(argv):
                print("usage: sia note \"what the next session should know\" "
                      "[--from <author>]")
                return 2
            author = argv[i + 1]; i += 2
        else:
            text.append(argv[i]); i += 1
    body = " ".join(text).strip()
    if not body:
        print("usage: sia note \"what the next session should know\" "
              "[--from <author>]")
        return 2
    if len(body) > 2000:
        print("note text must be between 1 and 2000 characters")
        return 2
    if not author.strip() or len(author) > 40:
        print("note author must be between 1 and 40 characters")
        return 2
    import siaqueue
    prior_redactions = sialib.REDACTIONS.get("agent-note", 0)
    safe_author = sialib.clip(sialib.redact(author, "agent-note"), 40)
    safe_body = sialib.redact(body, "agent-note").strip()
    redaction_count = (
        sialib.REDACTIONS.get("agent-note", 0) - prior_redactions)
    if prior_redactions:
        sialib.REDACTIONS["agent-note"] = prior_redactions
    else:
        sialib.REDACTIONS.pop("agent-note", None)
    if not safe_author or not safe_body:
        print("note author and text must remain non-empty after redaction")
        return 2
    try:
        receipt = siaqueue.enqueue_note(
            sialib.STATE, safe_author, safe_body,
            redactions={"agent-note": redaction_count}
            if redaction_count else None)
    except (TypeError, ValueError) as exc:
        print(f"note rejected: {exc}")
        return 2
    except OSError as exc:
        print(f"could not queue note: {exc}")
        return 1
    print(f"note queued · request {receipt['request_id']} · "
          f"{receipt['queued_at']} (the brainstem materializes it on the "
          f"next pulse)")
    return 0


def cmd_continuity(argv):
    """Expose the local-memory capsule boundary without a storage adapter."""
    import siacapsule
    if argv == ["roots", "--json"]:
        print(json.dumps(siacapsule.roots(), ensure_ascii=True,
                         sort_keys=True, separators=(",", ":")))
        return 0
    if argv and argv[0] == "freeze":
        output = None
        if len(argv) == 3 and argv[1] == "--output" \
                and os.path.isabs(argv[2]):
            output = argv[2]
        if output is not None:
            result = siacapsule.freeze(output)
            print(json.dumps(result, ensure_ascii=True, sort_keys=True,
                             separators=(",", ":")))
            return 0
    elif len(argv) == 3 and argv[0] == "export-identity" \
            and argv[1] == "--output" and os.path.isabs(argv[2]):
        result = siacapsule.export_identity_key(argv[2])
        print(json.dumps(result, ensure_ascii=True, sort_keys=True,
                         separators=(",", ":")))
        return 0
    elif len(argv) == 3 and argv[0] == "verify" \
            and argv[2] == "--json" and os.path.isabs(argv[1]):
        result = siacapsule.verify(argv[1])
        print(json.dumps(result, ensure_ascii=True, sort_keys=True,
                         separators=(",", ":")))
        return 0
    print("usage: sia continuity roots --json\n"
          "       sia continuity freeze --output ABSOLUTE_PATH\n"
          "       sia continuity export-identity --output ABSOLUTE_PATH\n"
          "       sia continuity verify ABSOLUTE_CAPSULE --json")
    return 2


def cmd_restore_worker(request_path):
    """Run one apply under the stable supervisor's lifecycle EX."""
    lifecycle_fd = _ACTIVE_RESTORE_LIFECYCLE_FD
    if lifecycle_fd is None:
        print("restore worker refused: exclusive launcher capability missing",
              file=sys.stderr)
        return 1
    import siabackup
    try:
        return siabackup.run_restore_request(
            request_path, lifecycle_fd=lifecycle_fd)
    except (OSError, RuntimeError, TypeError, ValueError) as exc:
        print(f"restore worker refused: {exc}", file=sys.stderr)
        return 1


def cmd_restore_recover(request_id):
    """Recover the durable thaw barrier under lifecycle EX."""
    lifecycle_fd = _ACTIVE_RESTORE_LIFECYCLE_FD
    if lifecycle_fd is None:
        print("restore recovery refused: exclusive launcher capability missing",
              file=sys.stderr)
        return 1
    import siabackup
    try:
        return siabackup.run_restore_recovery(
            request_id, lifecycle_fd=lifecycle_fd)
    except (OSError, RuntimeError, TypeError, ValueError) as exc:
        print(f"restore recovery refused: {exc}", file=sys.stderr)
        return 1


def cmd_agent_propose(raw):
    """Queue one validated model-origin take through the lifecycle CLI."""
    import siatakes
    try:
        value = sialib._strict_json_loads(raw)
    except (UnicodeError, ValueError, RecursionError):
        print("proposal rejected: payload is malformed JSON")
        return 2
    try:
        if not isinstance(value, dict):
            raise ValueError("proposal payload must be an object")
        proposal = siatakes.validate_proposal(value, require_future=True)
        siatakes.locked_proposals(
            sialib.STATE, lambda current: current + [proposal])
    except (TypeError, ValueError) as exc:
        print(f"proposal rejected: {exc}")
        return 2
    print(f"proposed ({proposal['proposal_id']}). The operator commits with: "
          f"sia take --accept {proposal['proposal_id']}  — proposals are "
          "not memories until then.")
    return 0


def cmd_ledger():
    n, h = sialib.ledger_head()
    if isinstance(n, bool) or not isinstance(n, int) or n <= 0 \
            or not isinstance(h, str) \
            or re.fullmatch(r"[0-9a-f]{64}", h) is None:
        print("sia ledger: signed ledger head unavailable")
        return 1
    print(f"sia ledger: seq {n} · head {h[:16]}…")
    try:
        result = sialib._run_bounded_text_process(
            [sys.executable, os.path.join(sialib.BIN, "sia-ledger"),
             "verify", sialib.SHARE, "--quiet"],
            env=None, timeout=60, cwd=None, label="SIA ledger verifier",
            output_limit=sialib.MAX_CONFIG_BYTES)
    except Exception as exc:
        print(f"ledger verification refused: {exc}", file=sys.stderr)
        return 1
    return result.returncode


def cmd_intend(argv):
    """Manage dated commitments that SIA surfaces near their deadlines."""
    import siatakes
    if argv and argv[0] == "--history":
        cursor = argv[2] if len(argv) >= 3 and argv[1] == "--cursor" else None
        if len(argv) not in (1, 3) or len(argv) == 3 and argv[1] != "--cursor":
            print("usage: sia intend --history [--cursor CURSOR]")
            return 2
        page = siatakes.list_intents_page(cursor=cursor)
        for it in page["items"]:
            print(f"  {it['id'][:6]}  [{it['status']}]  "
                  f"{sialib.clip(it['text'], 70)}")
        if page["next_cursor"] is not None:
            print("next page: sia intend --history --cursor "
                  + page["next_cursor"])
        return 0
    if not argv or argv[0] == "--list":
        ints = siatakes.open_intents()
        if not ints:
            print("no open intents.  sia intend \"...\" --by YYYY-MM-DD")
            return 0
        for it in ints:
            d = it["days_left"]
            when = (f"OVERDUE {-d}d" if d < 0 else
                    "due today" if d == 0 else f"due in {d}d")
            print(f"  {it['id'][:6]}  [{when:>11}]  "
                  f"{sialib.clip(it['text'], 70)}")
        return 0
    if argv[0] == "--done":
        if len(argv) < 2:
            print("usage: sia intend --done <id> [note…]")
            return 2
        with sialib.corpus_owner(), \
                sialib.corpus_publication() as before_publish:
            it = siatakes.close_intent(
                argv[1], " ".join(argv[2:]),
                before_publish=before_publish)
        if not it:
            print(f"no unique open intent matches “{argv[1]}” "
                  f"(see sia intend --list)")
            return 1
        print(f"intent {it['id'][:6]} done: {sialib.clip(it['text'], 70)}")
        return 0
    text, by = [], None
    i = 0
    while i < len(argv):
        if argv[i] == "--":
            # Same end-of-options rule as `sia take`: an intent whose text
            # begins with "-" is otherwise unfilable, and here it would be
            # worse than a refusal — this loop treats an unknown option as
            # text, so "sia intend --hepl ..." would silently commit a
            # typo as a dated intent. "--" makes the boundary explicit.
            text.extend(argv[i + 1:])
            break
        if argv[i] == "--by":
            if i + 1 >= len(argv):
                print("usage: sia intend \"what to do\" --by YYYY-MM-DD")
                return 2
            by = argv[i + 1]; i += 2
        elif argv[i].startswith("-"):
            print("refusing option-shaped intent text; use -- before text "
                  "that begins with '-'. nothing was registered")
            return 2
        else:
            text.append(argv[i]); i += 1
    if not text or not by:
        print("usage: sia intend \"what to do\" --by YYYY-MM-DD\n"
              "       sia intend --by YYYY-MM-DD -- <text beginning with ->\n"
              "       sia intend --list | --done <id> [note…]")
        return 2
    try:
        with sialib.corpus_owner(), \
                sialib.corpus_publication() as before_publish:
            it = siatakes.create_intent(
                " ".join(text), by, before_publish=before_publish)
    except ValueError:
        print(f"bad date: {by} (want YYYY-MM-DD)")
        return 2
    print(f"intent {it['id'][:6]} committed — due {it['due']}. SIA "
          f"will surface it as the deadline nears; it joins memory on "
          f"the next pulse.")
    return 0


READINESS_GATED_COMMANDS = frozenset({
    "ask", "query", "recall", "memory", "rehearse", "graph",
    "ponder", "deep", "takes", "grade", "calibration", "bench",
    "judge-audit", "context", "intend",
})


def main(argv):
    dispatch_started = False
    try:
        with sialib._lifecycle_reader():
            dispatch_started = True
            return _main_under_lifecycle(argv)
    except (OSError, RuntimeError, ValueError) as exc:
        if argv[1:] == ["live", "--json"]:
            # The runtime is already selected and imported. Preserve the
            # machine-readable endpoint when its inner lifecycle lease
            # refuses, without admitting source reads or exception prose.
            if not dispatch_started:
                return _print_live_json(_live_refusal_result("lifecycle-unavailable"))
            # Dispatch may already have written bytes. A second JSON object
            # would fabricate a clean terminal envelope after partial output.
            print("SIA live output refused: live-dispatch-failed", file=sys.stderr)
            return 1
        print(f"SIA unavailable: {exc}")
        return 1


def _main_under_lifecycle(argv):
    if len(argv) < 2:
        print(__doc__.strip())
        return 2
    cmd = argv[1]
    command_args = argv[2:]
    recovery_safe_unpin = (cmd == "memory" and len(command_args) == 2
                           and command_args[0] == "--unpin")
    if cmd == "bench" and command_args[:1] == ["cognitive"]:
        # This exact subcommand consumes only an externally pinned private
        # request. The surrounding lifecycle lease remains held; there is no
        # resident corpus/index/model fallback and no general readiness skip.
        return _dispatch(argv, cmd)
    if cmd in READINESS_GATED_COMMANDS and not recovery_safe_unpin:
        # Keep the readiness predicate and every byte returned to the caller
        # in the same corpus generation. Nested corpus owners in ponder/grade
        # are context-local reentrant scopes over this lease.
        with sialib.corpus_owner():
            ready, reason = sialib.memory_readiness()
            if not ready:
                print("SIA memory read refused: " + reason + ". Run or wait "
                      "for a successful `sia pulse` to finish migration and "
                      "sync.")
                return 1
            return _dispatch(argv, cmd)
    return _dispatch(argv, cmd)


def _dispatch(argv, cmd):
    if cmd == "version":
        print(sialib.VERSION)
        return 0
    if cmd == "status":
        return cmd_status()
    if cmd == "live":
        return cmd_live(argv[2:])
    if cmd == "ready":
        return cmd_ready()
    if cmd == "readmit":
        return cmd_readmit(argv[2:])
    if cmd in ("ask", "query") and len(argv) > 2:
        ask_args = argv[2:]
        no_touch = "--no-touch" in ask_args
        ask_args = [a for a in ask_args if a != "--no-touch"]
        return cmd_ask(" ".join(ask_args), touch=not no_touch) \
            if ask_args else 2
    if cmd == "recall" and len(argv) > 2:
        recall_args = argv[2:]
        no_touch = "--no-touch" in recall_args
        recall_args = [a for a in recall_args if a != "--no-touch"]
        return cmd_recall(recall_args[0], touch=not no_touch) \
            if len(recall_args) == 1 else 2
    if cmd == "memory":
        return cmd_memory(argv[2:])
    if cmd == "rehearse":
        return cmd_rehearse(argv[2:])
    if cmd == "think":
        return cmd_think()
    if cmd == "graph":
        return cmd_graph()
    if cmd == "pulse":
        return cmd_pulse()
    if cmd == "repair-cortex-boundary":
        return cmd_repair_cortex_boundary(argv[2:])
    if cmd == "dream":
        return cmd_dream()
    if cmd == "verify":
        return cmd_verify(argv[2:])
    if cmd == "continuity":
        return cmd_continuity(argv[2:])
    if cmd == "backup":
        import siabackup
        return siabackup.cli_backup(argv[2:])
    if cmd == "restore":
        import siabackup
        return siabackup.cli_restore(argv[2:], sys.stdin.buffer)
    if cmd == "_continuity-worker" and len(argv) == 3 \
            and os.path.isabs(argv[2]):
        import siabackup
        return siabackup.run_request(argv[2])
    if cmd == "_continuity-restore-worker" and len(argv) == 3 \
            and os.path.isabs(argv[2]):
        return cmd_restore_worker(argv[2])
    if cmd == "_continuity-restore-recover" and len(argv) == 3 \
            and re.fullmatch(r"[0-9a-f]+", argv[2]) is not None:
        return cmd_restore_recover(argv[2])
    if cmd == "_continuity-restore-complete" and len(argv) == 3 \
            and os.path.isabs(argv[2]):
        import siabackup
        try:
            siabackup.finalize_restore_request(argv[2])
            return 0
        except (OSError, RuntimeError, TypeError, ValueError):
            return 1
    if cmd == "_continuity-restore-restart-failed" and len(argv) == 3 \
            and os.path.isabs(argv[2]):
        import siabackup
        return 0 if siabackup.mark_brainstem_restart_failed(argv[2]) else 1
    if cmd == "_continuity-recovery-restart-failed" and len(argv) == 2:
        import siabackup
        return 0 if siabackup.mark_recovery_restart_failed() else 1
    if cmd == "_continuity-recovery-complete" and len(argv) == 2:
        import siabackup
        return 0 if siabackup.finalize_restore_recovery() else 1
    if cmd == "_continuity-supervisor-reconcile" and len(argv) == 2:
        import siabackup
        try:
            siabackup.reconcile_supervisor_spools()
            return 0
        except (OSError, RuntimeError, TypeError, ValueError):
            return 1
    if cmd == "note":
        return cmd_note(argv[2:])
    if cmd == "agent-propose" and len(argv) == 3:
        return cmd_agent_propose(argv[2])
    if cmd == "ledger":
        return cmd_ledger()
    if cmd == "ponder":
        return cmd_ponder(" ".join(argv[2:]) if len(argv) > 2 else None)
    if cmd == "deep" and len(argv) > 2:
        return cmd_ponder(" ".join(argv[2:]))
    if cmd == "take":
        return cmd_take(argv[2:])
    if cmd == "takes":
        return cmd_takes(argv[2:])
    if cmd == "intend":
        return cmd_intend(argv[2:])
    if cmd == "grade":
        return cmd_grade(argv[2] if len(argv) > 2 else None)
    if cmd == "calibration":
        return cmd_calibration(argv[2:])
    if cmd == "bench":
        import siabench
        return siabench.main(argv[2:])
    if cmd == "judge-audit":
        import siatakes
        print("attacking the judge with 6 engineered evidence states "
              "(configured judge, several minutes)…\n")
        rows, s = siatakes.judge_audit()
        for r in rows:
            mark = "✓" if r["ok"] else "✗"
            print(f"{mark} expected {r['expected']:<12} got "
                  f"{r['verdict']:<13} — {r['note']}")
            print(f"    claim: {r['claim'][:88]}")
            if not r["ok"]:
                print(f"    judge said: {r['justification'][:180]}")
        print(f"\nresolution correctness: {s['resolution_correct']}/"
              f"{s['resolution_total']} · abstention correctness: "
              f"{s['abstention_correct']}/{s['abstention_total']}")
        import datetime as _dt
        out = sialib.os.path.expanduser(
            "~/.local/share/sia/research/judge-audit-"
            + _dt.date.today().isoformat() + ".json")
        sialib.atomic_write(out, json.dumps(
            {"rows": rows, "summary": s}, indent=1))
        print(f"saved → {out}")
        return 0
    if cmd == "context":
        try:
            st = _claim_status_snapshot()
        except ValueError as exc:
            print(f"context refused: {exc}")
            return 1
        if st is None:
            print("context refused: no resident status snapshot")
            return 1
        organs = sorted({s.split("/")[1] for s in st["workspace"]
                         if s.startswith("events/")})[:6] or ["jackal"]
        # context-pack is a corpus-wide gbrain verb (entity cards + threads + facts);
        # it accepts no --source flag at all, so the bare invocation is correct here and is
        # not an instance of the issue-#3 missing-source class. Pinned by the contract lane.
        r = _gbrain_read(["context-pack", "--entities", ",".join(organs),
                          "--budget-tokens", "4000"])
        sys.stdout.write(sialib.strip_controls(r.stdout))
        sys.stderr.write(sialib.strip_controls(r.stderr))
        return r.returncode
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    try:
        with _runtime_generation_lease():
            sys.path.insert(0, _runtime_module_dir())
            import sialib as _sialib
            sialib = _sialib
            sys.exit(main(sys.argv))
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"sia: refused: {exc}", file=sys.stderr)
        sys.exit(1)
