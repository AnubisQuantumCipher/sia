[Unit]
Description=SIA brainstem — the Omarchy Brain's resident daemon
Documentation=https://github.com/AnubisQuantumCipher/sia

[Service]
Type=notify
NotifyAccess=main
# JACKAL status=exact, parsed=2*60, exact=120. Exact rational arithmetic
# outside the Lean certificate chain (NOT formal-bounded).
TimeoutStartSec=120
ExecStart=/usr/bin/python3 %h/.local/share/sia/bin/sia-brainstem
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=idle
Environment=SIA_PULSE_SEC=60

[Install]
WantedBy=default.target
