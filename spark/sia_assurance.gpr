project SIA_Assurance is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("policy_tests.adb", "transaction_tests.adb",
                 "request_wire_tests.adb", "request_admission_tests.adb",
                 "grant_lifetime_tests.adb", "retraction_tests.adb",
                 "consolidation_tests.adb", "continuity_tests.adb",
                 "continuity_transition_tests.adb",
                 "continuity_record_wire_tests.adb",
                 "continuity_observation_wire_tests.adb",
                 "continuity_checkpoint_wire_tests.adb",
                 "continuity_current_wire_tests.adb",
                 "continuity_frame_wire_tests.adb",
                 "continuity_response_wire_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwae", "-gnatVa", "-gnata", "-gnatf",
         "-gnatw.o", "-O2", "-g");
      for Local_Configuration_Pragmas use "restrictions.adc";
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--report=all", "-W=all", "--warnings=error",
         "--checks-as-errors=on", "--proof-warnings=on",
         "--prover=z3,cvc5,altergo", "-j1");
   end Prove;
end SIA_Assurance;
