project Pack_Proposal is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tests");
   for Source_Files use
     ("pack_manifest_tests.adb",
      "pack_plan_wire_test_support.adb",
      "pack_plan_wire_test_support.ads",
      "pack_plan_wire_tests.adb",
      "pack_retirement_test_support.adb",
      "pack_retirement_test_support.ads",
      "pack_retirement_tests.adb",
      "sia_continuity.adb",
      "sia_continuity.ads",
      "sia_continuity_record_wire.adb",
      "sia_continuity_record_wire.ads",
      "sia_pack_manifest_wire.adb",
      "sia_pack_manifest_wire.ads",
      "sia_pack_partition.adb",
      "sia_pack_partition.ads",
      "sia_pack_plan_wire.adb",
      "sia_pack_plan_wire.ads",
      "sia_pack_retirement.adb",
      "sia_pack_retirement.ads",
      "sia_policy.adb",
      "sia_policy.ads",
      "sia_pack_proposal.ads",
      "sia_pack_proposal.adb",
      "pack_proposal_tests.adb");
   for Object_Dir use "pack-proposal-obj";
   for Exec_Dir use "pack-proposal-bin";
   for Main use ("pack_retirement_tests.adb", "pack_manifest_tests.adb",
                 "pack_plan_wire_tests.adb", "pack_proposal_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwae", "-gnatVa", "-gnata", "-gnatf",
         "-gnatw.o", "-O2", "-g");
      for Local_Configuration_Pragmas use "restrictions.adc";
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--report=all", "-W=all", "--warnings=error",
         "--checks-as-errors=on", "--proof-warnings=on",
         "--prover=z3,cvc5,altergo", "-j1");
   end Prove;
end Pack_Proposal;
