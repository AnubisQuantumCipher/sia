project Request_Probe is
   for Languages use ("Ada");
   for Source_Dirs use ("../src", "ada");
   for Object_Dir use "../obj/probe";
   for Exec_Dir use "../bin";
   for Main use ("request_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwae", "-gnatVa", "-gnata", "-gnatf", "-O2", "-g");
      for Local_Configuration_Pragmas use "../restrictions.adc";
   end Compiler;
end Request_Probe;
