project Continuity_Probe is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("../src", "ada", "native");
   for Object_Dir use "../obj/continuity-probe";
   for Exec_Dir use "../bin";
   for Main use ("continuity_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwae", "-gnatVa", "-gnata", "-gnatf",
         "-gnatw.o", "-O2", "-g", "-fstack-usage");
      for Default_Switches ("C") use
        ("-std=c11", "-O2", "-g", "-Wall", "-Wextra", "-Wpedantic",
         "-Werror", "-Wconversion", "-Wshadow", "-Wstrict-prototypes",
         "-Wmissing-prototypes", "-Wformat=2", "-Wundef",
         "-Wcast-align=strict", "-Wwrite-strings", "-Wvla", "-fanalyzer",
         "-fstack-usage");
      for Local_Configuration_Pragmas use "../restrictions.adc";
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,--require-defined=__wrap___gnat_install_handler",
         "-Wl,--require-defined=__wrap_sigaction",
         "-Wl,--require-defined=__wrap_sigaltstack",
         "-Wl,--require-defined=__wrap_sigemptyset",
         "-Wl,--wrap=__gnat_install_handler", "-Wl,--wrap=sigaction",
         "-Wl,--wrap=sigaltstack", "-Wl,--wrap=sigemptyset");
   end Linker;
end Continuity_Probe;
