project Continuity_Probe is
   for Languages use ("Ada");
   for Source_Dirs use ("../src", "ada");
   for Object_Dir use "../obj/continuity-probe";
   for Exec_Dir use "../bin";
   for Main use ("continuity_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwae", "-gnatVa", "-gnata", "-gnatf",
         "-gnatw.o", "-O2", "-g", "-fstack-usage");
      for Local_Configuration_Pragmas use "../restrictions.adc";
   end Compiler;
end Continuity_Probe;
