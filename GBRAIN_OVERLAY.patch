new file mode 100644
index 0000000000000000000000000000000000000000..ad0884f1946029af49fd442a66f6ef802e192539
--- /dev/null
+++ b/src/core/page-projection.ts
@@ -0,0 +1,303 @@
+/**
+ * Trusted-local, read-only page projection verifier.
+ *
+ * This is intentionally separate from the ordinary retrieval path: it uses
+ * one source-scoped SELECT and never calls getPage/getTags, retrieval
+ * bookkeeping, caches, telemetry, or mutation helpers.
+ */
+
+import { MAX_FILE_SIZE } from './import-file.ts';
+import { parseMarkdown } from './markdown.ts';
+import { contentHash } from './utils.ts';
+import { OperationError } from './ops/contract.ts';
+import type { OperationContext } from './ops/contract.ts';
+import { parseSourceIdParam, validatePageSlug } from './ops/context.ts';
+
+/** Matches SIA's admitted maximum closure roster; independent of search caps. */
+export const PAGE_PROJECTION_MAX_TARGETS = 4096;
+
+export interface PageProjectionTarget {
+  slug: string;
+  raw_markdown: string;
+}
+
+export interface PageProjectionRequest {
+  source_id: string;
+  targets: PageProjectionTarget[];
+}
+
+interface ProjectionRow {
+  source_id: string;
+  slug: string;
+  type: string;
+  title: string;
+  compiled_truth: string;
+  timeline: string | null;
+  frontmatter: Record<string, unknown> | string | null;
+  content_hash: string | null;
+  tags: string[] | null;
+}
+
+interface ParsedProjection {
+  parse_error_codes: string[];
+  digest: string | null;
+  frontmatter: Record<string, unknown> | null;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return false;
+  const proto = Object.getPrototypeOf(value);
+  return proto === Object.prototype || proto === null;
+}
+
+function rejectUnknownKeys(
+  value: Record<string, unknown>,
+  allowed: ReadonlySet<string>,
+  label: string,
+): void {
+  const unknown = Object.keys(value).filter(key => !allowed.has(key));
+  if (unknown.length > 0) {
+    throw new OperationError(
+      'invalid_params',
+      `${label} contains unknown field(s): ${unknown.sort().join(', ')}`,
+    );
+  }
+}
+
+/**
+ * JSONB does not preserve object-key order, while the historical contentHash
+ * formula hashes JSON.stringify output. Reorder the DB value against the raw
+ * parsed template recursively so semantically identical frontmatter gets the
+ * same projection digest; added/missing/different values still hash apart.
+ */
+function alignJsonObjectOrder(actual: unknown, template: unknown): unknown {
+  if (Array.isArray(actual) && Array.isArray(template)) {
+    return actual.map((value, index) => alignJsonObjectOrder(value, template[index]));
+  }
+  if (!isRecord(actual) || !isRecord(template)) return actual;
+  const aligned: Record<string, unknown> = Object.create(null);
+  for (const key of Object.keys(template)) {
+    if (Object.prototype.hasOwnProperty.call(actual, key)) {
+      aligned[key] = alignJsonObjectOrder(actual[key], template[key]);
+    }
+  }
+  for (const key of Object.keys(actual).filter(key => !(key in aligned)).sort()) {
+    aligned[key] = actual[key];
+  }
+  return aligned;
+}
+
+function normalizeDbFrontmatter(value: ProjectionRow['frontmatter']): Record<string, unknown> | null {
+  if (isRecord(value)) return value;
+  if (typeof value !== 'string') return value === null ? {} : null;
+  try {
+    const parsed: unknown = JSON.parse(value);
+    return isRecord(parsed) ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+function currentProjectionDigest(
+  row: ProjectionRow,
+  expectedFrontmatter: Record<string, unknown> | null,
+): string | null {
+  const frontmatter = normalizeDbFrontmatter(row.frontmatter);
+  if (frontmatter === null
+      || typeof row.title !== 'string'
+      || typeof row.type !== 'string'
+      || typeof row.compiled_truth !== 'string'
+      || (row.timeline !== null && typeof row.timeline !== 'string')
+      || !Array.isArray(row.tags)
+      || row.tags.some(tag => typeof tag !== 'string')) {
+    return null;
+  }
+  return contentHash({
+    title: row.title,
+    type: row.type,
+    compiled_truth: row.compiled_truth,
+    timeline: row.timeline ?? '',
+    frontmatter: alignJsonObjectOrder(
+      frontmatter,
+      expectedFrontmatter ?? {},
+    ) as Record<string, unknown>,
+    tags: row.tags,
+  });
+}
+
+/**
+ * Validate and copy the closed request shape. This helper is deliberately
+ * engine-free so the CLI can reject an oversized/invalid manifest before it
+ * opens a database connection.
+ */
+export function validatePageProjectionRequest(
+  raw: unknown,
+): PageProjectionRequest {
+  if (!isRecord(raw)) {
+    throw new OperationError('invalid_params', 'get_page_projection parameters must be a JSON object.');
+  }
+  rejectUnknownKeys(raw, new Set(['source_id', 'targets']), 'get_page_projection request');
+
+  const sourceId = parseSourceIdParam(raw.source_id, 'get_page_projection');
+  if (!sourceId) {
+    throw new OperationError('invalid_params', 'get_page_projection requires source_id.');
+  }
+  if (!Array.isArray(raw.targets)
+      || raw.targets.length === 0
+      || raw.targets.length > PAGE_PROJECTION_MAX_TARGETS) {
+    throw new OperationError(
+      'invalid_params',
+      `get_page_projection requires 1-${PAGE_PROJECTION_MAX_TARGETS} targets.`,
+    );
+  }
+
+  const seen = new Set<string>();
+  const targets = raw.targets.map((candidate, index): PageProjectionTarget => {
+    if (!isRecord(candidate)) {
+      throw new OperationError('invalid_params', `get_page_projection target ${index} must be an object.`);
+    }
+    rejectUnknownKeys(candidate, new Set(['slug', 'raw_markdown']), `get_page_projection target ${index}`);
+    const { slug, raw_markdown: markdown } = candidate;
+    if (typeof slug !== 'string') {
+      throw new OperationError('invalid_params', `get_page_projection target ${index} slug must be a string.`);
+    }
+    validatePageSlug(slug);
+    if (seen.has(slug)) {
+      throw new OperationError('invalid_params', `get_page_projection target slug must be unique: ${slug}`);
+    }
+    seen.add(slug);
+    if (typeof markdown !== 'string') {
+      throw new OperationError('invalid_params', `get_page_projection target ${index} raw_markdown must be a string.`);
+    }
+    // JSON permits lone UTF-16 surrogates even though they are not valid
+    // Unicode scalar values. Reject them rather than hash replacement bytes.
+    if (Buffer.from(markdown, 'utf8').toString('utf8') !== markdown) {
+      throw new OperationError('invalid_params', `get_page_projection target ${index} raw_markdown is not valid UTF-8 text.`);
+    }
+    const byteLength = Buffer.byteLength(markdown, 'utf8');
+    if (byteLength > MAX_FILE_SIZE) {
+      throw new OperationError(
+        'invalid_params',
+        `get_page_projection target ${index} raw_markdown is too large (${byteLength} bytes, max ${MAX_FILE_SIZE}).`,
+      );
+    }
+    return { slug, raw_markdown: markdown };
+  });
+  return { source_id: sourceId, targets };
+}
+
+function parseExpectedProjection(target: PageProjectionTarget, current?: ProjectionRow): ParsedProjection {
+  try {
+    const parsed = parseMarkdown(target.raw_markdown, `${target.slug}.md`, {
+      validate: true,
+      expectedSlug: target.slug,
+    });
+    const parseErrorCodes = (parsed.errors ?? []).map(error => error.code);
+    if (parseErrorCodes.length > 0) {
+      return { parse_error_codes: parseErrorCodes, digest: null, frontmatter: null };
+    }
+    // Sync preserves a stored type when existing markdown omits an explicit
+    // `type:`. Mirror that rule so this verifier hashes the same projection.
+    if (parsed.typeExplicit !== true && current) parsed.type = current.type;
+    return {
+      parse_error_codes: [],
+      frontmatter: parsed.frontmatter,
+      digest: contentHash({
+        title: parsed.title,
+        type: parsed.type,
+        compiled_truth: parsed.compiled_truth,
+        timeline: parsed.timeline,
+        frontmatter: parsed.frontmatter,
+        tags: parsed.tags,
+      }),
+    };
+  } catch {
+    // The result roster stays closed even if a future parser begins throwing
+    // for a malformed document instead of returning validation errors.
+    return { parse_error_codes: ['PARSER_EXCEPTION'], digest: null, frontmatter: null };
+  }
+}
+
+export async function handlePageProjection(
+  ctx: OperationContext,
+  raw: Record<string, unknown>,
+): Promise<Record<string, unknown>> {
+  if (ctx.remote !== false) {
+    throw new OperationError(
+      'permission_denied',
+      'get_page_projection is restricted to the trusted local CLI.',
+      'Run it through the dedicated sealed-manifest projection call on the brain host.',
+    );
+  }
+  const request = validatePageProjectionRequest(raw);
+  if (request.source_id !== ctx.sourceId) {
+    throw new OperationError(
+      'permission_denied',
+      `source_id '${request.source_id}' does not match the trusted local call context.`,
+      `Pass --source ${request.source_id} before get_page_projection.`,
+    );
+  }
+
+  // One statement gives every page and its ordered tag projection the same
+  // database snapshot. Soft-deleted rows intentionally look like misses.
+  const rows = await ctx.engine.executeRaw<ProjectionRow>(
+    `SELECT p.source_id, p.slug, p.type, p.title, p.compiled_truth,
+            p.timeline, p.frontmatter, p.content_hash,
+            ARRAY(SELECT t.tag FROM tags t WHERE t.page_id = p.id ORDER BY t.tag) AS tags
+       FROM pages p
+      WHERE p.source_id = $1
+        AND p.slug = ANY($2::text[])
+        AND p.deleted_at IS NULL
+      ORDER BY p.slug`,
+    [request.source_id, request.targets.map(target => target.slug)],
+  );
+  const requestedSlugs = new Set(request.targets.map(target => target.slug));
+  const bySlug = new Map(rows
+    .filter(row => row.source_id === request.source_id && requestedSlugs.has(row.slug))
+    .map(row => [row.slug, row]));
+
+  const targets = request.targets.map(target => {
+    const current = bySlug.get(target.slug);
+    const expected = parseExpectedProjection(target, current);
+    if (!current) {
+      return {
+        slug: target.slug,
+        page_state: 'missing_or_deleted',
+        parse_error_codes: expected.parse_error_codes,
+        expected_projection_sha256: expected.digest,
+        current_projection_sha256: null,
+        current_content_hash: null,
+        current_content_hash_match: false,
+        projection_match: false,
+      };
+    }
+    const currentProjection = currentProjectionDigest(current, expected.frontmatter);
+    const currentContentHash = typeof current.content_hash === 'string'
+      ? current.content_hash
+      : null;
+    const currentContentHashMatch = currentProjection !== null
+      && currentContentHash === currentProjection;
+    return {
+      slug: target.slug,
+      page_state: 'live',
+      parse_error_codes: expected.parse_error_codes,
